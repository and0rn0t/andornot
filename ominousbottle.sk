# [ominousbottle.sk] 불길한 병 스킬(우클릭, 쿨 30초): 7초간 가한 피해의 30% 회복 + 스태미너 초당 20 추가 재생. 끝나면 탈진(스태미너 0)
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수: {-obcd}(쿨타임 종료 시각), {-bottle}(효과 종료 시각, 있고 지금보다 뒤면 효과 중), {-healok}(회복이 전투 중 차단을 통과하는 표시, main.sk 가 읽음),
#   {-skillitems::ominous_bottle}, 상태이상 출처 키 ominousbottle(보스바 이로운 효과 "불길한 병")
# 이펙트: 지속시간 7초 동안 2틱마다 온몸에서 검은색/붉은색(red)/푸른색(blue) dust 가 나온다(크기 0.8, 색마다 24개).
# 스태미너 추가 재생: 기본 재생이 틱당 +1(초당 20)이므로 효과 중엔 틱당 +1 을 더한다(기본 재생과 별개, stcap 영향 없음).
# 회복량: 가한 피해(실제로 깎인 체력)의 30%. 다른 스크립트의 데미지 보정이 끝나도록 1틱 뒤 체력 차이로 계산한다.
# "ominous bottle" 아이템 별칭이 Skript 2.13 별칭 목록에 있는지 jar 에서 확인 못 함(미검증). 컴파일 오류가 나면 이 줄이 원인.

on load:
	set {-skillitems::ominous_bottle} to ominous bottle

on rightclick:
	if skillHand(player, ominous bottle) is false:
		stop
	cancel event
	if {-obcd::%player's uuid%} is set:
		if {-obcd::%player's uuid%} > now:
			stop
	set {-obcd::%player's uuid%} to now + 30 seconds
	set item cooldown of ominous bottle for player to 30 seconds
	set {-bottle::%player's uuid%} to now + 7 seconds
	setStatus(player, "ominousbottle", "불길한 병", 7 seconds, "good")
	play sound "item.bottle.fill" with volume 1 and pitch 0.8 to player
	# 검은색/붉은색/푸른색 이펙트: 7초(2틱 간격 70번) 동안 온몸에서 세 가지 색 dust 가 나온다.
	set {_p} to player
	set {_i} to 0
	while {_i} < 70:
		if {_p} is not online:
			stop
		if {_p} is dead:
			stop
		add 1 to {_i}
		play 24 black dust with size 0.8 with offset of 0.35, 0.7, 0.35 and speed 0 at ({_p}'s location ~ vector(0, 1, 0)) in radius of 100
		play 24 red dust with size 0.8 with offset of 0.35, 0.7, 0.35 and speed 0 at ({_p}'s location ~ vector(0, 1, 0)) in radius of 100
		play 24 blue dust with size 0.8 with offset of 0.35, 0.7, 0.35 and speed 0 at ({_p}'s location ~ vector(0, 1, 0)) in radius of 100
		wait 2 ticks

# 효과 중: 스태미너 틱당 +1 추가. 끝나면 탈진(스태미너 0).
on every 1 ticks:
	loop all players:
		set {_id} to "%loop-player's uuid%"
		if {-bottle::%{_id}%} is set:
			if {-bottle::%{_id}%} > now:
				if {-st::%{_id}%} < 100:
					add 1 to {-st::%{_id}%}
					if {-st::%{_id}%} > 100:
						set {-st::%{_id}%} to 100
					set level progress of loop-player to ({-st::%{_id}%} * 0.01 - 0.001)
			else:
				delete {-bottle::%{_id}%}
				set {-st::%{_id}%} to 0
				set level progress of loop-player to 0
				play sound "entity.player.breath" with volume 1 and pitch 0.8 to loop-player

# 효과 중 가한 피해의 30% 회복
on damage:
	if attacker is a player:
		set {_a} to attacker
		if {-bottle::%{_a}'s uuid%} is set:
			if {-bottle::%{_a}'s uuid%} > now:
				set {_v} to victim
				set {_before} to {_v}'s health
				wait 1 tick
				set {_after} to {_v}'s health
				set {_d} to {_before} - {_after}
				if {_d} > 0:
					set {_heal} to {_d} * 0.3
					set {-healok::%{_a}'s uuid%} to true
					heal {_a} by {_heal} hearts
					delete {-healok::%{_a}'s uuid%}

on death:
	delete {-bottle::%victim's uuid%}

on join:
	delete {-obcd::%player's uuid%}
	delete {-bottle::%player's uuid%}
	delete {-healok::%player's uuid%}
