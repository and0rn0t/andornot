# [killcine.sk] 킬 연출: HP 가 다 닳는 피해를 취소하고 직접 처리한다. 진짜로 죽지 않으므로 바닐라 사망 화면/메시지/아이템 드롭이 없다.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수: {-kc::uuid}(킬 연출 중 표시. 연출이 끝나면 지움, 접속/퇴장 때도 정리)
# 순서(시각은 연출 시작 기준):
#   0틱   치명타 피해 취소 -> 킬 처리(킬 점수 자리 killScoreHook, 킬로그 killLogShow) -> 죽을 때 지워지던 상태 정리(kcClearState)
#         -> 죽은 자리에 손에 아무것도 안 든 스켈레톤(피격자의 시선과 상관없이 고정 방향, kcPickYaw) 세움 -> 피격자는 관전 모드, 정면 구도(kcCamLoc, 가까이)로 둔 카메라에 시점 고정
#   35틱  스켈레톤 자리에 콰직 소리 + 붉은 파티클, 스켈레톤 제거(엔티티 제거라 사망 메시지 없음). 이때부터 6초 실명 + 타이틀 "리스폰" / 서브타이틀 숫자(5 -> 1)
#         연출 화면으로 전환되는 순간 iron_golem.repair 소리(피격자에게만)
#   135틱 리스폰: 어드벤처 모드로 되돌림, 리스폰 위치로 이동, 체력/스태미너 회복. 실명은 1초 남은 상태라 바닐라가 서서히 풀어 준다(미검증).
# 게임을 끝내는 킬: 모든 참가자가 킬 연출을 관전한 뒤, 마지막 킬을 한 플레이어를 같은 구도로 한 번 클로즈업(그 자리에 세운 더미, 약 3초)하고 나서 종료 연출(gameFinale)로 넘어간다.
# 섬멸전 라운드를 끝내는 킬: 모든 참가자가 이 연출을 관전 -> 콰직 뒤 승리 팀 살아 있는 사람 자리에 세운 더미(gfDummyAt) 중 한 명을 같은 구도로 클로즈업 + 타이틀 "라운드 승리"/팀 이름 -> 원래 자리로 복귀, 다음 라운드(gRoundNext).
#   섬멸전에서 죽은 사람에게는 "리스폰" 카운트다운 타이틀/실명을 보여 주지 않는다.
# 이동 막기: 관전 상태에서는 카메라 엔티티에 붙어 있어서 못 움직인다. 시점 해제(Shift)나 다른 대상 관전을 하면 매 틱 다시 붙인다.
# 시간/거리는 아래 kc 함수의 값 하나씩만 바꾸면 된다. 연출을 끄려면 kcEnabled() 가 false 를 돌려주게 하면 바닐라 사망으로 돌아간다.
# 이 파일은 게임 진행 틀(킬 점수, 라운드, 로비)이 아직 없어서 리스폰 위치는 월드 스폰(kcRespawnLoc)이고, 킬 점수는 killScoreHook(빈 함수)에 연결 자리만 있다.
# 유지보수: 새 스킬이 죽을 때 정리할 상태(on death)를 만들면 kcClearState 에도 같은 정리를 추가해야 한다(연출은 진짜 사망 이벤트를 내지 않는다).
# 미검증 문법: on damage with priority highest, 스켈레톤 소환/장비 비우기(skript-reflect + Bukkit API), setSpectatorTarget, getFinalDamage 비교.
#   연출 대상은 피격자와 똑같이 생긴 마네킹이었다가, 죽었는지 구분이 안 돼서 손에 아무것도 안 든 스켈레톤으로 바꿨다.

import:
	org.bukkit.entity.EntityType
	net.kyori.adventure.text.serializer.gson.GsonComponentSerializer
	org.bukkit.Bukkit
	org.bukkit.Particle

# 킬 연출 사용 여부
function kcEnabled() :: boolean:
	return true

# 리스폰 위치: 게임 중인 참가자(바운티)는 팀원 근처 무작위 위치(game.sk 의 gTeamSpot, 없으면 초기 위치, 기준 위치도 없으면 월드 스폰). 게임 중이 아니거나 모드가 없거나 참가자가 아니면 로비.
function kcRespawnLoc(v: player) :: location:
	if {-ingame} is true:
		if {-gmode} is set:
			if {-gplist::*} contains {_v}:
				set {_t} to gTeamSpot({_v})
				if {_t} is set:
					set {-gdropflag::%{_v}'s uuid%} to true
					return gDropLoc({_t})
				return {_v}.getWorld().getSpawnLocation()
	# 게임 중이 아닌데 낙하용 겉날개가 남아 있으면 벗기고 로비로 보낸다
	delete {-gdropflag::%{_v}'s uuid%}
	if {-gdropon::%{_v}'s uuid%} is true:
		gDropEnd({_v})
	return gameLobbyLoc()

# 킬 점수를 올리는 자리(게임 진행 틀이 생기면 여기서 팀 점수/KDA 를 올린다). 지금은 아무 일도 안 한다.
function killScoreHook(v: player, a: entity):
	gameOnKill({_v}, {_a})

# 진짜 사망(on death)에서 지워지던 상태를 직접 정리한다. 각 파일의 on death 와 같은 내용(그 파일을 고치면 여기도 고칠 것).
function kcClearState(v: player):
	set {_id} to "%{_v}'s uuid%"
	# anvil.sk
	anvilClear({_v})
	# flintsteel.sk
	delete {-vuln::%{_id}%}
	delete {-noburn::%{_id}%}
	clearStatus({_v}, "flint")
	# totem.sk
	delete {-totemend::%{_id}%}
	delete {-jumplock::%{_id}%::totem}
	clearStatus({_v}, "totem")
	# ominousbottle.sk
	delete {-bottle::%{_id}%}
	delete {-exhaust::%{_id}%}
	clearStatus({_v}, "ominousbottle_exhaust")
	# potions.sk
	delete {-invis::%{_id}%}
	# statustag.sk, healthbar.sk
	stagRemove({_id})
	hpbar_remove({_id})
	# 바닐라 사망이면 사라지는 것들: 남은 상태이상 표시, 기절, 도약 잠금, 전투 중 카운터, 스태미너 회복 차단
	delete {-status::%{_id}%::*}
	delete {-statusname::%{_id}%::*}
	delete {-statusdur::%{_id}%::*}
	delete {-statustype::%{_id}%::*}
	delete {-statuslabel::%{_id}%::*}
	delete {-stunend::%{_id}%}
	delete {-jumplock::%{_id}%::*}
	set {-oc::%{_id}%} to 0
	set {-stcap::%{_id}%} to 0
	# 검 패시브(sword.sk): 쿨타임 초기화(변수 + 아이템 쿨타임 표시)
	delete {-swcd::%{_id}%}
	set item cooldown of netherite sword for {_v} to 0 seconds
	# 활(bow.sk): 당기던 충전 기록 정리(충전 보스바 루프는 기록이 지워지면 스스로 끝난다)
	delete {-bowstart::%{_id}%}
	# 곡괭이 중첩(main.sk), 블레이즈 막대기 사용 횟수(blazerod.sk), 낚싯대에 걸린 상태(fishing.sk)
	delete {-pickstack::%{_id}%}
	delete {-pickexp::%{_id}%}
	delete {-brcount::%{_id}%}
	delete {-brlast::%{_id}%}
	delete {-hooked::%{_id}%}
	# 불붙은 상태, 흡수 체력, 모든 포션 효과(기절/구속의 느림, 네더의 별 버프, 발광 등)
	{_v}.setFireTicks(0)
	{_v}.setAbsorptionAmount(0)
	{_v}.clearActivePotionEffects()

# 카메라 위치(시체/승리자를 바라보는 방향까지 설정). 구도는 정면 하나로 통일했다.
#   base 의 yaw 가 대상이 바라보는 방향이고, 카메라는 그 정면 앞 kcCamDist() 블럭, 높이 kcCamHeight() 에서 대상 중심(base 위 1칸)을 본다.
function kcCamDist() :: number:
	return 1.5

function kcCamHeight() :: number:
	return 1.25

function kcCamLoc(base: location) :: location:
	set {_yaw} to {_base}.getYaw()
	# 앞 방향 (-sin, cos)
	set {_dx} to (0 - sin({_yaw})) * kcCamDist()
	set {_dz} to cos({_yaw}) * kcCamDist()
	set {_cl} to {_base} ~ vector({_dx}, kcCamHeight(), {_dz})
	set {_tg} to {_base} ~ vector(0, 1, 0)
	{_cl}.setDirection(vector from {_cl} to {_tg})
	return {_cl}

# 대상(스켈레톤/승리자 더미)이 서 있을 방향: 피격자의 시선과 상관없이 고정. 0 도(남쪽)부터 90 도씩 돌려 카메라 자리가 막히지 않은 첫 방향을 쓴다(다 막히면 0).
function kcPickYaw(base: location) :: number:
	set {_i} to 0
	while {_i} < 4:
		set {_y} to {_i} * 90
		set {_t} to {_base}.clone()
		{_t}.setYaw({_y})
		{_t}.setPitch(0)
		set {_tc} to kcCamLoc({_t})
		if {_tc}.getBlock().isPassable() is true:
			return {_y}
		add 1 to {_i}
	return 0

# 라운드 종료 연출 마무리(섬멸전): 더미 제거, 모두 원래 자리로 돌려놓고 다음 라운드. 연출 중 위치는 {-kcorig::uuid} 에 저장해 둔다.
function kcRoundEnd():
	gfClearDummies()
	loop {-gplist::*}:
		if loop-value is online:
			set gamemode of loop-value to adventure
			if {-kcorig::%uuid of loop-value%} is set:
				tpSafe(loop-value, {-kcorig::%uuid of loop-value%})
	delete {-kcorig::*}
	gRoundNext()

# 진짜 사망(킬 연출을 못 거친 사망: /kill 등)에서도 cc/버프/상태를 전부 지운다(각 파일의 on death 와 겹쳐도 같은 정리를 반복할 뿐이라 안전).
on death of player:
	kcClearState(victim)

# 치명타 피해를 가로채서 킬 연출을 한다. 다른 스크립트의 피해 보정(main.sk)이 전부 끝난 뒤의 최종 피해로 판단해야 해서 우선순위를 가장 늦게 둔다.
on damage with priority highest:
	if victim is not a player:
		stop
	if kcEnabled() is false:
		stop
	set {_v} to victim
	set {_vid} to "%{_v}'s uuid%"
	# 연출 중이면 어떤 피해도 받지 않는다
	if {-kc::%{_vid}%} is set:
		cancel event
		stop
	if gamemode of {_v} is not survival:
		if gamemode of {_v} is not adventure:
			stop
	set {_ev} to event
	set {_fd} to {_ev}.getFinalDamage()
	set {_hpnow} to {_v}.getHealth()
	set {_abs} to {_v}.getAbsorptionAmount()
	set {_left} to {_hpnow} + {_abs}
	if {_fd} < {_left}:
		stop
	# /kill 같은 명령과 서버가 직접 죽이는 경우(KILL)는 연출 없이 진짜로 죽게 둔다
	set {_c} to {_ev}.getCause().name()
	if {_c} is "KILL":
		stop
	# ---- 여기부터 치명타: 피해를 취소하고 직접 처리 ----
	cancel event
	set {-kc::%{_vid}%} to true
	set {_ae} to {_v}
	if attacker is set:
		set {_ae} to attacker
	set {_dt} to {_ev}.getDamageSource().getDamageType().getKey().getKey()
	# 1) 킬 처리를 먼저: 킬 점수 -> 킬로그 -> 상태 정리
	# 치명타 피해량(남은 체력까지)을 가한 피해로 센 뒤 킬 처리(game.sk)
	gameDamageRecord({_v}, {_ae}, min({_fd}, {_left}))
	killScoreHook({_v}, {_ae})
	killLogShow({_v}, {_ae}, {_c}, {_dt})
	kcClearState({_v})
	# 2) 죽은 자리에 손에 아무것도 안 든 스켈레톤을 세운다(바라보는 방향 그대로). 마네킹은 본체와 똑같이 생겨서 죽었는지 구분이 안 돼서 교체.
	#    AI/소리/충돌/줍기를 끄고 무적(햇빛에 타는 모습은 불 표시를 끄고 매 틱 불을 꺼서 막는다). 스켈레톤은 소환하면 활을 들고 나올 수 있어서 손/방어구를 전부 비운다(미검증).
	set {_loc} to {_v}.getLocation()
	# 피격자의 시선과 상관없이 정해진 방향(kcPickYaw)을 보게 세우고, 카메라는 그 정면에 둔다
	set {_yaw} to kcPickYaw({_loc})
	{_loc}.setYaw({_yaw})
	{_loc}.setPitch(0)
	set {_w} to {_v}.getWorld()
	set {_m} to {_w}.spawnEntity({_loc}, EntityType.SKELETON)
	{_m}.setAI(false)
	{_m}.setInvulnerable(true)
	{_m}.setSilent(true)
	{_m}.setCollidable(false)
	{_m}.setCanPickupItems(false)
	# 무적이어도 스켈레톤은 햇빛에 불이 붙은 모습이 되므로 불 표시를 끄고, 아래 루프에서 매 틱 불도 꺼 준다(미검증: setVisualFire).
	{_m}.setVisualFire(false)
	{_m}.setFireTicks(0)
	{_m}.setRemoveWhenFarAway(false)
	{_m}.setRotation({_loc}.getYaw(), {_loc}.getPitch())
	set {_meq} to {_m}.getEquipment()
	{_meq}.clear()
	# 3) 정면 구도(kcCamLoc)의 카메라 자리
	set {_cl} to kcCamLoc({_loc})
	# 카메라는 글자 없는 텍스트 디스플레이다(보이지 않는 갑옷 거치대는 관전자에게 반투명하게 보여서 교체, 미검증)
	set {_cam} to {_w}.spawnEntity({_cl}, EntityType.TEXT_DISPLAY)
	{_cam}.setGravity(false)
	{_cam}.setInvulnerable(true)
	{_cam}.setSilent(true)
	# 게임을 끝내는 마지막 킬이면(game.sk 의 {-gover}) 모든 참가자가 이 연출을 같이 본다(관전 상태로). 연출이 끝나면 gameFinale()(gameend.sk).
	set {_fin} to false
	if {-gover} is true:
		set {_fin} to true
	# 섬멸전에서 이 킬로 라운드가 끝났으면(승리 팀은 {-groundwin}) 모든 참가자가 이 연출을 같이 본 뒤 승리자 클로즈업을 한다.
	set {_rnd} to false
	if {_fin} is false:
		if {-groundend} is true:
			set {_rnd} to true
	set {_all} to false
	if {_fin} is true:
		set {_all} to true
	if {_rnd} is true:
		set {_all} to true
	# 라운드 승리자 더미: 승리 팀의 살아 있는 사람 자리에 똑같이 생긴 더미를 세워 둔다(본인들은 아래에서 관전으로 옮겨져 연출을 본다)
	delete {_wd::*}
	if {_rnd} is true:
		delete {-kcorig::*}
		set {_wk} to {-groundwin}
		if {_wk} is not "":
			loop {-gplist::*}:
				set {_o} to loop-value
				if {_o} is online:
					if gTeamOf({_o}) is {_wk}:
						if {-gdead::%uuid of {_o}%} is not set:
							set {_wd::%uuid of {_o}%} to gfDummyAt({_o}, {_o}.getLocation(), {_o}.getLocation().getYaw())
	# 게임을 끝내는 킬: 마지막 킬을 한 플레이어(공격자)가 서 있던 자리에 똑같이 생긴 더미를 세워 두고, 킬 연출 뒤 종료 연출 전에 그 더미를 클로즈업한다.
	if {_fin} is true:
		if {_ae} is a player:
			if {_ae} is not {_v}:
				if {-gplist::*} contains {_ae}:
					if {_ae} is online:
						set {_wd::%uuid of {_ae}%} to gfDummyAt({_ae}, {_ae}.getLocation(), {_ae}.getLocation().getYaw())
	# 4) 피격자를 관전 모드로 바꾸고 카메라에 시점을 붙인다
	set {_bl} to {_loc} ~ vector(0, 1, 0)
	set gamemode of {_v} to spectator
	tpSafe({_v}, {_cl})
	wait 1 tick
	{_v}.setSpectatorTarget({_cam})
	play sound "entity.iron_golem.repair" with volume 2 and pitch 1 to {_v}
	if {_all} is true:
		loop {-gplist::*}:
			set {_o} to loop-value
			if {_o} is online:
				if {_o} is not {_v}:
					if {_rnd} is true:
						set {-kcorig::%uuid of {_o}%} to {_o}.getLocation()
					set gamemode of {_o} to spectator
					tpSafe({_o}, {_cl})
	if {_rnd} is true:
		set {-kcorig::%{_vid}%} to {_loc}
	# 5) 35틱 동안 시체를 보여준다(매 틱 시점이 풀렸으면 다시 붙임)
	set {_t} to 0
	while {_t} < 35:
		if {_v} is not online:
			{_m}.remove()
			{_cam}.remove()
			delete {-kc::%{_vid}%}
			if {_fin} is true:
				gameFinale()
			if {_rnd} is true:
				kcRoundEnd()
			stop
		{_m}.setFireTicks(0)
		set {_cur} to {_v}.getSpectatorTarget()
		if {_cur} is not {_cam}:
			{_v}.setSpectatorTarget({_cam})
		if {_all} is true:
			loop {-gplist::*}:
				set {_o} to loop-value
				if {_o} is online:
					set {_cur2} to {_o}.getSpectatorTarget()
					if {_cur2} is not {_cam}:
						{_o}.setSpectatorTarget({_cam})
		add 1 to {_t}
		wait 1 tick
	# 6) 콰직! 소리 + 붉은 조각이 튀는 파티클(레드스톤 블록 조각, reflect 로 직접 호출, 미검증), 스켈레톤 제거
	play sound "entity.player.attack.crit" with volume 2 and pitch 0.6 at {_bl}
	play sound "block.bone_block.break" with volume 2 and pitch 0.5 at {_bl}
	play sound "entity.zombie.break_wooden_door" with volume 1.5 and pitch 0.6 at {_bl}
	{_w}.spawnParticle(Particle.BLOCK, {_bl}, 60, 0.3, 0.5, 0.3, 0.25, Bukkit.createBlockData("minecraft:redstone_block"))
	{_m}.remove()
	# 게임을 끝내는 킬이면 여기서 연출을 마치고 종료 연출로 넘어간다(리스폰 없이 모두 관전 상태 유지)
	if {_fin} is true:
		wait 25 ticks
		# 게임을 끝낸 플레이어 클로즈업(킬 연출과 같은 정면 구도, 약 3초). 공격자가 플레이어가 아니면 건너뛴다.
		set {_cam2} to {_cam}
		if {_ae} is a player:
			if {_wd::%uuid of {_ae}%} is set:
				set {_dm} to {_wd::%uuid of {_ae}%}
				set {_dl} to {_dm}.getLocation()
				set {_dy} to kcPickYaw({_dl})
				{_dl}.setYaw({_dy})
				{_dl}.setPitch(0)
				{_dm}.setRotation({_dy}, 0)
				set {_cl2} to kcCamLoc({_dl})
				set {_cam2} to {_w}.spawnEntity({_cl2}, EntityType.TEXT_DISPLAY)
				{_cam2}.setGravity(false)
				{_cam2}.setInvulnerable(true)
				{_cam2}.setSilent(true)
				loop {-gplist::*}:
					if loop-value is online:
						tpSafe(loop-value, {_cl2})
				wait 1 tick
				loop {-gplist::*}:
					if loop-value is online:
						loop-value.setSpectatorTarget({_cam2})
				{_cam}.remove()
				set {_t} to 0
				while {_t} < 60:
					loop {-gplist::*}:
						set {_o} to loop-value
						if {_o} is online:
							set {_cur3} to {_o}.getSpectatorTarget()
							if {_cur3} is not {_cam2}:
								{_o}.setSpectatorTarget({_cam2})
					add 1 to {_t}
					wait 1 tick
		{_cam2}.remove()
		{_cam}.remove()
		gfClearDummies()
		delete {-kc::%{_vid}%}
		gameFinale()
		stop
	# 섬멸전 라운드 종료: 승리자 더미 클로즈업(킬 연출과 같은 구도) + 타이틀 -> 다음 라운드
	if {_rnd} is true:
		wait 25 ticks
		set {_cu} to ""
		if {_ae} is a player:
			if {_wd::%uuid of {_ae}%} is set:
				set {_cu} to "%uuid of {_ae}%"
		if {_cu} is "":
			loop {_wd::*}:
				if {_cu} is "":
					set {_cu} to loop-index
		set {_cam2} to {_cam}
		if {_cu} is not "":
			set {_dm} to {_wd::%{_cu}%}
			set {_dl} to {_dm}.getLocation()
			set {_dy} to kcPickYaw({_dl})
			{_dl}.setYaw({_dy})
			{_dl}.setPitch(0)
			{_dm}.setRotation({_dy}, 0)
			set {_cl2} to kcCamLoc({_dl})
			set {_cam2} to {_w}.spawnEntity({_cl2}, EntityType.TEXT_DISPLAY)
			{_cam2}.setGravity(false)
			{_cam2}.setInvulnerable(true)
			{_cam2}.setSilent(true)
			loop {-gplist::*}:
				if loop-value is online:
					tpSafe(loop-value, {_cl2})
			wait 1 tick
			loop {-gplist::*}:
				if loop-value is online:
					loop-value.setSpectatorTarget({_cam2})
			{_cam}.remove()
		set {_wl} to ""
		if {_wk} is not "":
			set {_wl} to gTeamLabel({_wk})
		loop {-gplist::*}:
			set {_o} to loop-value
			if {_o} is online:
				if {_wk} is "":
					send title "&7라운드 무승부" with subtitle "" to {_o} for 3 seconds with fadein 5 ticks and fade out 10 ticks
				else:
					send title "&6라운드 승리" with subtitle colored "%{_wl}%" to {_o} for 3 seconds with fadein 5 ticks and fade out 10 ticks
					play sound "entity.player.levelup" with volume 0.8 to {_o}
		set {_t} to 0
		while {_t} < 70:
			loop {-gplist::*}:
				set {_o} to loop-value
				if {_o} is online:
					set {_cur3} to {_o}.getSpectatorTarget()
					if {_cur3} is not {_cam2}:
						{_o}.setSpectatorTarget({_cam2})
			add 1 to {_t}
			wait 1 tick
		{_cam2}.remove()
		{_cam}.remove()
		delete {-kc::%{_vid}%}
		kcRoundEnd()
		stop
	# 7) 리스폰 대기: 6초 실명 + 타이틀 카운트다운(5초). 이 동안도 시점 고정.
	#    섬멸전에서 죽은 사람은 라운드가 끝날 때까지 못 살아나므로 "리스폰" 타이틀/실명은 보여 주지 않는다(시점 고정 시간만 유지).
	set {_kd} to gKeepDead({_v})
	if {_kd} is false:
		apply blindness potion without any particles whilst hiding the potion icon to {_v} for 6 seconds replacing the existing effect
	set {_t} to 0
	while {_t} < 100:
		if {_v} is not online:
			{_cam}.remove()
			delete {-kc::%{_vid}%}
			stop
		set {_cur} to {_v}.getSpectatorTarget()
		if {_cur} is not {_cam}:
			{_v}.setSpectatorTarget({_cam})
		if {_kd} is false:
			if mod({_t}, 20) is 0:
				set {_sec} to 5 - floor({_t} / 20)
				send title "&c리스폰" with subtitle "&f%{_sec}%" to {_v} for 25 ticks with fadein 0 ticks and fade out 0 ticks
		add 1 to {_t}
		wait 1 tick
	# 8) 리스폰: 어드벤처로 되돌리고 리스폰 위치로 이동, 체력/스태미너 회복
	{_cam}.remove()
	# 섬멸전에서 죽은 사람은 라운드가 끝날 때까지 관전 상태로 남는다(부활은 game.sk 의 라운드 시작이 한다)
	if gKeepDead({_v}) is true:
		{_v}.clearTitle()
		delete {-kc::%{_vid}%}
		stop
	set gamemode of {_v} to adventure
	delete {-gdropflag::%{_vid}%}
	tpSafe({_v}, kcRespawnLoc({_v}))
	if {-gdropflag::%{_vid}%} is true:
		delete {-gdropflag::%{_vid}%}
		gDropStart({_v})
	set {_mh} to {_v}'s max health
	set {_v}'s health to {_mh}
	set {-st::%{_vid}%} to 100
	set level progress of {_v} to 0.999
	{_v}.clearTitle()
	delete {-kc::%{_vid}%}

# 연출 도중 나가면 관전 모드로 남지 않게 되돌려 둔다(스켈레톤/카메라는 위 루프가 오프라인을 보고 지운다)
on quit:
	if {-kc::%player's uuid%} is set:
		set gamemode of player to adventure
		tpSafe(player, kcRespawnLoc(player))
		set {_mh} to player's max health
		set player's health to {_mh}
		delete {-kc::%player's uuid%}

on join:
	delete {-kc::%player's uuid%}
