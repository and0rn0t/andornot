# [uuidmask.sk] 다른 플레이어에게 가는 패킷 속 진짜 UUID 를 가짜 UUID 로 바꿔치기해요 (ProtocolLib 필요)
#
# 왜 필요한가
#   마인크래프트는 플레이어 정보(탭 목록)/엔티티 생성/채팅 패킷에 UUID 를 실어 보내요. 일반 화면에는 안 보여도 핵 클라이언트나
#   패킷 로거는 그대로 읽을 수 있고, UUID 만 있으면 Mojang API / NameMC 로 진짜 계정 이름을 찾을 수 있어요.
#   서버 안의 UUID 자체를 바꾸면 1.19+ 채팅 서명 키 검증 때문에 접속이 거부되므로, 서버 안에서는 진짜 UUID 를 그대로 두고
#   "내보내는 패킷"에서만 바꿔요. 본인 클라이언트로 가는 패킷은 건드리지 않아요(본인 화면은 진짜 UUID 가 맞아야 해요).
#
# 하는 일
#   - 가려진 플레이어의 UUID 를 PLAYER_INFO / PLAYER_INFO_REMOVE / SPAWN_ENTITY / CHAT 패킷에서 가짜로 교체
#   - 탭 목록 항목의 채팅 서명 공개키 제거 (진짜 UUID 로 서명된 값이라 지문으로 쓰일 수 있음)
#   - 탭 목록 항목의 스킨 속성: 가짜 신분(nick.sk)이면 접속 때 우리가 넣은 것뿐이라 그대로 두고(그래야 가짜 스킨이 보임), 그 외는 제거(base64 안에 원 계정 UUID/이름이 있음)
#   - 관전 메뉴 텔레포트(SPECTATE) 요청에 담겨 오는 가짜 UUID 를 진짜로 되돌림
#   - 마네킹 같은 엔티티의 프로필은 패킷 메타데이터라 여기서 못 바꿔서 nick.sk 의 nickProfile(p) 를 쓴다(gameend.sk/startcine.sk 에 적용)
# 안 하는 일 (중요)
#   - 서버 콘솔/로그/파일, 서버 소유자는 그대로 진짜 신분을 알아요. 이름/스킨 가명화와 어떤 사람을 가릴지는 nick.sk 가 정해요.
#   - 못 막는 경로(검증 안 함): 펫 주인 UUID(엔티티 메타데이터), 플레이어 머리 아이템의 프로필, op 의 /data 명령
#
# 필요한 것
#   - ProtocolLib: 서버 버전(Paper 1.21.11)을 지원하는 빌드. 5.4.0 정식 jar 는 1.21.8 까지만 알아서 안 맞을 수 있어요.
#     GitHub dmulloy2/ProtocolLib 의 dev-build 에 1.21.9~1.21.11 지원이 들어 있어요. 없으면 이 파일은 로드 오류가 나고 UUID 는 가려지지 않아요.
#
# 쓰는 법 (op)  가림 대상은 nick.sk 가 접속할 때 자동 배정(가짜 신분이면 가짜 UUID 가 생김). 이 파일의 명령:
#   /uuidmask status           ProtocolLib 버전/리스너 상태 확인
#   /uuidmask kill / revive    패킷 수정 임시 정지 / 재개 (오류가 계속 날 때 비상용)
#
# 변수
#   {-umr2f} / {-umf2r}      진짜->가짜 / 가짜->진짜 UUID 표(자바 ConcurrentHashMap, nick.sk 가 채움, 패킷 스레드에서도 읽어요)
#   {-umlistener}            등록한 ProtocolLib 리스너
#   {-umoff}                 true 면 패킷을 건드리지 않음
#
# 미검증(실제 서버에서 확인 필요)
#   - skript-reflect proxy 로 PacketListener 구현, ListeningWhitelist 빌더 호출, PlayerInfoData 9개 인자 생성자
#   - 패킷 스레드(네티)에서 Skript 함수가 도는 것, 번들(bundle) 안의 SPAWN_ENTITY 를 setPacket 으로 바꿔도 되는지
#   - 채팅이 가려진 사람 것은 서명 검증이 안 돼서 상대 화면에 "안전하지 않은 채팅" 표시가 뜰 수 있어요

import:
	org.bukkit.Bukkit
	ch.njol.skript.Skript as SkriptMain
	java.util.ArrayList
	java.util.HashSet
	com.comphenix.protocol.ProtocolLibrary
	com.comphenix.protocol.PacketType$Play$Server as PTServer
	com.comphenix.protocol.PacketType$Play$Client as PTClient
	com.comphenix.protocol.events.PacketListener
	com.comphenix.protocol.events.ListeningWhitelist
	com.comphenix.protocol.events.ListenerPriority
	com.comphenix.protocol.events.ListenerOptions
	com.comphenix.protocol.wrappers.PlayerInfoData
	com.comphenix.protocol.wrappers.WrappedGameProfile

# 스킨 속성을 지울지 (true 권장). false 로 하면 속성을 그대로 복사해요 = 원 계정 UUID/이름이 새요.
function umStripProps(real: object) :: boolean:
	if {nick::map::%{_real}%} is set:
		return false
	return true

# ---------- ProtocolLib 리스너 부품 ----------

function umPlugin() :: object:
	return SkriptMain.getInstance()

function umSendWl() :: object:
	set {_t} to new ArrayList()
	{_t}.add(PTServer.PLAYER_INFO)
	{_t}.add(PTServer.PLAYER_INFO_REMOVE)
	{_t}.add(PTServer.SPAWN_ENTITY)
	{_t}.add(PTServer.CHAT)
	set {_o} to new HashSet()
	{_o}.add(ListenerOptions.SKIP_PLUGIN_VERIFIER)
	set {_b} to ListeningWhitelist.newBuilder()
	{_b}.types({_t})
	{_b}.options({_o})
	{_b}.priority(ListenerPriority.HIGHEST)
	return {_b}.build()

function umRecvWl() :: object:
	set {_t} to new ArrayList()
	{_t}.add(PTClient.SPECTATE)
	set {_o} to new HashSet()
	{_o}.add(ListenerOptions.SKIP_PLUGIN_VERIFIER)
	set {_b} to ListeningWhitelist.newBuilder()
	{_b}.types({_t})
	{_b}.options({_o})
	{_b}.priority(ListenerPriority.HIGHEST)
	return {_b}.build()

# ---------- 패킷 수정 ----------

# 보내는 패킷: 종류를 보고 알맞은 함수로 넘겨요. 패킷은 여러 사람에게 같이 쓰일 수 있어서 항상 복사본(shallowClone)에만 써요.
function umOnSend(e: object):
	if {-umoff} is true:
		stop
	if {_e}.isReadOnly() is true:
		stop
	if {_e}.isPlayerTemporary() is true:
		stop
	set {_v} to {_e}.getPlayer().getUniqueId()
	set {_t} to {_e}.getPacketType()
	if {_t}.equals(PTServer.PLAYER_INFO) is true:
		umInfo({_e}, {_v})
	else if {_t}.equals(PTServer.PLAYER_INFO_REMOVE) is true:
		umRemove({_e}, {_v})
	else:
		umUuid0({_e}, {_v})

# 받는 패킷: 관전 메뉴 텔레포트. 클라이언트가 가짜 UUID 로 보내면 진짜 UUID 로 되돌려요.
function umOnRecv(e: object):
	if {-umoff} is true:
		stop
	set {_pk} to {_e}.getPacket()
	set {_u} to {_pk}.getUUIDs().read(0)
	if {_u} is not set:
		stop
	set {_r} to {-umf2r}.get({_u})
	if {_r} is not set:
		stop
	set {_cl} to {_pk}.shallowClone()
	{_cl}.getUUIDs().write(0, {_r})
	{_e}.setPacket({_cl})

# 탭 목록: 항목마다 진짜 UUID 가 가려질 사람이면 가짜 UUID/가짜 프로필로 바꿔요. (v = 받는 사람, 본인 항목은 그대로)
function umInfo(e: object, v: object):
	set {_pk} to {_e}.getPacket()
	set {_mod} to {_pk}.getPlayerInfoDataLists()
	set {_idx} to 0
	if {_mod}.size() >= 2:
		set {_idx} to 1
	set {_list} to {_mod}.read({_idx})
	if {_list} is not set:
		stop
	set {_n} to {_list}.size()
	set {_out} to new ArrayList()
	set {_hit} to false
	set {_i} to 0
	while {_i} < {_n}:
		set {_d} to {_list}.get({_i})
		set {_u} to {_d}.getProfileId()
		delete {_f}
		if {_u} is set:
			set {_f} to {-umr2f}.get({_u})
		if {_f} is set:
			if {_u}.equals({_v}) is false:
				set {_hit} to true
				set {_nd} to umMakeInfo({_d}, {_f})
				{_out}.add({_nd})
			else:
				{_out}.add({_d})
		else:
			{_out}.add({_d})
		add 1 to {_i}
	if {_hit} is false:
		stop
	set {_cl} to {_pk}.shallowClone()
	{_cl}.getPlayerInfoDataLists().write({_idx}, {_out})
	{_e}.setPacket({_cl})

# 탭 목록 항목 하나를 가짜 UUID 로 새로 만들어요. 채팅 서명 공개키는 null, 스킨 속성은 기본적으로 비워요.
function umMakeInfo(d: object, f: object) :: object:
	set {_op} to {_d}.getProfile()
	set {_nm} to ""
	if {_op} is set:
		set {_x} to {_op}.getName()
		if {_x} is set:
			set {_nm} to {_x}
	set {_np} to new WrappedGameProfile({_f}, {_nm})
	set {_real} to {_d}.getProfileId()
	if umStripProps({_real}) is false:
		if {_op} is set:
			{_np}.getProperties().putAll({_op}.getProperties())
	set {_dn} to {_d}.getDisplayName()
	if {_dn} is set:
		set {_r} to new PlayerInfoData({_f}, {_d}.getLatency(), {_d}.isListed(), {_d}.getGameMode(), {_np}, {_dn}, {_d}.isShowHat(), {_d}.getListOrder(), null)
	else:
		set {_r} to new PlayerInfoData({_f}, {_d}.getLatency(), {_d}.isListed(), {_d}.getGameMode(), {_np}, null, {_d}.isShowHat(), {_d}.getListOrder(), null)
	return {_r}

# 탭 목록에서 빠지는 사람(UUID 목록)
function umRemove(e: object, v: object):
	set {_pk} to {_e}.getPacket()
	set {_list} to {_pk}.getUUIDLists().read(0)
	if {_list} is not set:
		stop
	set {_n} to {_list}.size()
	set {_out} to new ArrayList()
	set {_hit} to false
	set {_i} to 0
	while {_i} < {_n}:
		set {_u} to {_list}.get({_i})
		delete {_f}
		if {_u} is set:
			set {_f} to {-umr2f}.get({_u})
		if {_f} is set:
			if {_u}.equals({_v}) is false:
				set {_hit} to true
				{_out}.add({_f})
			else:
				{_out}.add({_u})
		else:
			{_out}.add({_u})
		add 1 to {_i}
	if {_hit} is false:
		stop
	set {_cl} to {_pk}.shallowClone()
	{_cl}.getUUIDLists().write(0, {_out})
	{_e}.setPacket({_cl})

# 엔티티 생성 / 플레이어 채팅 패킷: UUID 필드가 하나라서 첫 번째 것을 바꿔요.
function umUuid0(e: object, v: object):
	set {_pk} to {_e}.getPacket()
	set {_u} to {_pk}.getUUIDs().read(0)
	if {_u} is not set:
		stop
	set {_f} to {-umr2f}.get({_u})
	if {_f} is not set:
		stop
	if {_u}.equals({_v}) is true:
		stop
	set {_cl} to {_pk}.shallowClone()
	{_cl}.getUUIDs().write(0, {_f})
	{_e}.setPacket({_cl})

# ---------- 시작 / 종료 ----------

on load:
	if Bukkit.getPluginManager().isPluginEnabled("ProtocolLib") is false:
		log "[uuidmask] ProtocolLib 이 켜져 있지 않아서 UUID 가림을 시작하지 못했어요."
		stop
	nickTables()
	if {-umlistener} is set:
		ProtocolLibrary.getProtocolManager().removePacketListener({-umlistener})
	set {_h::onpacketsending} to function reference "umOnSend"
	set {_h::onpacketreceiving} to function reference "umOnRecv"
	set {_h::getsendingwhitelist} to function reference "umSendWl"
	set {_h::getreceivingwhitelist} to function reference "umRecvWl"
	set {_h::getplugin} to function reference "umPlugin"
	set {_l} to a new proxy of PacketListener using {_h::*}
	ProtocolLibrary.getProtocolManager().addPacketListener({_l})
	set {-umlistener} to {_l}

on unload:
	if {-umlistener} is set:
		ProtocolLibrary.getProtocolManager().removePacketListener({-umlistener})
		delete {-umlistener}

# ---------- 명령어 ----------

command /uuidmask [<text>]:
	description: UUID 가림 상태 확인/정지 (ProtocolLib 필요)
	usage: /uuidmask <status|kill|revive>
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	trigger:
		if arg-1 is not set:
			send "&e/uuidmask status | kill | revive"
			stop
		if arg-1 is "status":
			if Bukkit.getPluginManager().isPluginEnabled("ProtocolLib") is false:
				send "&cProtocolLib 이 켜져 있지 않아요."
				stop
			set {_pl} to Bukkit.getPluginManager().getPlugin("ProtocolLib")
			set {_ver} to {_pl}.getDescription().getVersion()
			set {_srv} to Bukkit.getVersion()
			send "&7ProtocolLib: &f%{_ver}%"
			send "&7서버: &f%{_srv}%"
			if {-umlistener} is set:
				send "&7리스너: &a등록됨"
			else:
				send "&7리스너: &c없음"
			if {-umoff} is true:
				send "&7패킷 수정: &c정지됨(/uuidmask revive)"
			else:
				send "&7패킷 수정: &a작동 중"
			if {-umr2f} is set:
				set {_c} to {-umr2f}.size()
				send "&7가려진 접속자 표 크기: &f%{_c}%"
			stop
		if arg-1 is "kill":
			set {-umoff} to true
			send "&c패킷 수정을 멈췄어요. 다시 켜려면 /uuidmask revive"
			stop
		if arg-1 is "revive":
			delete {-umoff}
			send "&a패킷 수정을 다시 켰어요."
			stop
		send "&c알 수 없는 하위 명령이에요. /uuidmask"
