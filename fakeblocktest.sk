# [fakeblocktest.sk] 시험용(op): 가짜 블록 패킷으로 허공 대상에 휠 클릭(블록 집기) 신호가 오는지, 그 신호로 핑이 꽂히는지 확인한다. 확인이 끝나면 이 파일을 지우면 된다(다른 파일이 참조하지 않음).
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 명령(op): /fakeblock on = 시선 앞 15칸에 시험 더미(마네킹)를 띄우고 막히지 않는 방향으로 계속 움직이게 한다. 더미 몸 위치(발/머리 2칸)에 본인에게만 가짜 장벽(barrier) 블록 패킷을 매 2틱 보낸다.
#                /fakeblock off = 끄고 원래 블록으로 되돌린다. /pingtest on 도 같이 켜진다(게임 밖 시험 핑 + 사거리 64).
# 보는 것: 더미를 향해 휠 클릭 -> 채팅에 "[fakeblock] 블록 집기 신호" 가 뜨는지(서버가 신호를 받았나), 그 뒤 핑이 더미에 빨간 핑으로 꽂히는지.
#   서버의 실제 블록은 공기라서, 서버가 공기 위치의 집기를 무시하면 신호 자체가 안 올 수 있다(그게 이 시험의 핵심). 엔티티 집기 신호가 오면 "[fakeblock] 엔티티 집기 신호" 가 뜬다(클라이언트가 블록 대신 더미를 집은 경우).
# 하이브리드(현재): 가짜 barrier 만으로는 신호가 안 와서(서버가 공기 위치 집기를 무시), 같은 자리에 서버 쪽 실제 light 블록(레벨 0, 충돌 없음, 화살 통과)도 둔다. 클라이언트는 barrier 를 보고, 서버는 light 를 본다.
# 변수(RAM): {-fbt::uuid}(시험 더미), {-fbtv::uuid::x|y|z}(이동 방향), {-fbto::uuid::1|2}(블록을 바꾼 자리, 되돌릴 때 씀), {-fbtr::uuid::1|2}(그 자리에 서버 light 를 실제로 놨는지)
# 미검증: 전부(가짜 블록으로 집기 신호가 오는지, barrier 가 십자선에 잡히는지, 서버가 공기 위치 집기를 무시하는지).

import:
	org.bukkit.Bukkit
	org.bukkit.Material
	org.bukkit.entity.EntityType
	io.papermc.paper.event.player.PlayerPickBlockEvent
	io.papermc.paper.event.player.PlayerPickEntityEvent

function fbtSpeed() :: number:
	return 0.3

# 더미 몸(발, 머리)이 들어갈 자리가 비어 있는지
function fbtFree(l: location) :: boolean:
	set {_b1} to {_l}.getBlock()
	set {_a} to {_b1}.isPassable()
	if {_a} is not true:
		return false
	set {_l2} to {_l} ~ vector(0, 1, 0)
	set {_b2} to {_l2}.getBlock()
	set {_c} to {_b2}.isPassable()
	if {_c} is not true:
		return false
	return true

# 가짜로 보냈던 블록을 원래대로 되돌린다
function fbtRestore(p: player):
	set {_id} to "%uuid of {_p}%"
	loop integers from 1 to 2:
		set {_o} to {-fbto::%{_id}%::%loop-value%}
		if {_o} is set:
			set {_ob} to {_o}.getBlock()
			# 서버 쪽에 실제로 둔 light 블록은 공기로 되돌린다
			if {-fbtr::%{_id}%::%loop-value%} is set:
				{_ob}.setType(Material.AIR, false)
			set {_od} to {_ob}.getBlockData()
			{_p}.sendBlockChange({_o}, {_od})
		delete {-fbto::%{_id}%::%loop-value%}
		delete {-fbtr::%{_id}%::%loop-value%}

function fbtStop(p: player):
	set {_id} to "%uuid of {_p}%"
	fbtRestore({_p})
	set {_e} to {-fbt::%{_id}%}
	if {_e} is set:
		{_e}.remove()
	delete {-fbt::%{_id}%}
	delete {-fbtv::%{_id}%::*}
	delete {-wping_qtest::%{_id}%}

function fbtTick(p: player):
	set {_id} to "%uuid of {_p}%"
	set {_e} to {-fbt::%{_id}%}
	if {_e} is not set:
		stop
	set {_ok} to {_e}.isValid()
	if {_ok} is not true:
		fbtStop({_p})
		stop
	set {_cur} to {_e}.getLocation()
	set {_pl} to {_p}.getLocation()
	if world of {_cur} is not world of {_pl}:
		fbtStop({_p})
		stop
	set {_sp} to fbtSpeed()
	set {_vx} to {-fbtv::%{_id}%::x}
	set {_vy} to {-fbtv::%{_id}%::y}
	set {_vz} to {-fbtv::%{_id}%::z}
	set {_d} to distance between {_cur} and {_pl}
	if {_d} > 35:
		# 너무 멀어지면 플레이어 쪽으로 방향을 튼다
		set {_vx} to (x-coordinate of {_pl} - x-coordinate of {_cur}) / {_d} * {_sp}
		set {_vy} to 0
		set {_vz} to (z-coordinate of {_pl} - z-coordinate of {_cur}) / {_d} * {_sp}
	set {_nl} to {_cur} ~ vector({_vx}, {_vy}, {_vz})
	set {_fr} to fbtFree({_nl})
	if {_fr} is not true:
		# 막혔으면 막히지 않는 방향을 무작위로 찾는다(16번 시도, 없으면 제자리)
		set {_found} to false
		set {_try} to 0
		while {_try} < 16:
			if {_found} is not true:
				set {_ang} to random integer between 0 and 359
				set {_cx} to cos({_ang}) * {_sp}
				set {_cz} to sin({_ang}) * {_sp}
				set {_cy} to (random integer between -1 and 1) * 0.1
				set {_cl} to {_cur} ~ vector({_cx}, {_cy}, {_cz})
				set {_fc} to fbtFree({_cl})
				if {_fc} is true:
					set {_found} to true
					set {_vx} to {_cx}
					set {_vy} to {_cy}
					set {_vz} to {_cz}
					set {_nl} to {_cl}
			add 1 to {_try}
		if {_found} is not true:
			set {_nl} to {_cur}
	{_e}.teleport({_nl})
	set {-fbtv::%{_id}%::x} to {_vx}
	set {-fbtv::%{_id}%::y} to {_vy}
	set {-fbtv::%{_id}%::z} to {_vz}
	# 가짜 블록: 더미 몸 자리(발, 머리)에 본인에게만 장벽을 보낸다
	set {_nb} to {_nl}.getBlock()
	set {_f1} to {_nb}.getLocation()
	set {_f2} to {_f1} ~ vector(0, 1, 0)
	fbtRestore({_p})
	# 하이브리드: 서버 쪽에는 충돌 없는 실제 light 블록(레벨 0)을 둔다(공기가 아니어야 서버가 집기 신호를 받아 줌). 블록이 이미 있는 칸은 건너뜀.
	set {_ld} to Bukkit.createBlockData("minecraft:light[level=0]")
	set {_b1} to {_f1}.getBlock()
	set {_t1} to {_b1}.getType()
	set {_n1} to {_t1}.name()
	if {_n1} is "AIR":
		{_b1}.setBlockData({_ld}, false)
		set {-fbtr::%{_id}%::1} to true
	set {_b2} to {_f2}.getBlock()
	set {_t2} to {_b2}.getType()
	set {_n2} to {_t2}.name()
	if {_n2} is "AIR":
		{_b2}.setBlockData({_ld}, false)
		set {-fbtr::%{_id}%::2} to true
	set {_bd} to Bukkit.createBlockData("minecraft:barrier")
	{_p}.sendBlockChange({_f1}, {_bd})
	{_p}.sendBlockChange({_f2}, {_bd})
	set {-fbto::%{_id}%::1} to {_f1}
	set {-fbto::%{_id}%::2} to {_f2}

every 2 ticks:
	loop all players:
		if {-fbt::%uuid of loop-player%} is set:
			fbtTick(loop-player)

command /fakeblock [<text>]:
	permission: op
	trigger:
		set {_id} to "%uuid of player%"
		if arg-1 is "off":
			fbtStop(player)
			send "&a[fakeblock] 껐습니다(가짜 블록을 원래대로 되돌렸어요)." to player
			stop
		if arg-1 is not "on":
			send "&e사용법: /fakeblock on|off" to player
			stop
		if {-fbt::%{_id}%} is set:
			send "&c[fakeblock] 이미 켜져 있습니다." to player
			stop
		set {_el} to eye location of player
		set {_dir} to {_el}.getDirection()
		set {_sl} to {_el}.clone().add({_dir}.clone().multiply(15))
		set {_free} to fbtFree({_sl})
		if {_free} is not true:
			send "&c[fakeblock] 앞 15칸이 막혀 있어요. 탁 트인 곳에서 다시 해 주세요." to player
			stop
		set {_w} to world of player
		set {_e} to {_w}.spawnEntity({_sl}, EntityType.MANNEQUIN)
		{_e}.setGravity(false)
		{_e}.setInvulnerable(true)
		{_e}.setSilent(true)
		{_e}.addScoreboardTag("fbtdummy")
		set {-fbt::%{_id}%} to {_e}
		set {_ang} to random integer between 0 and 359
		set {-fbtv::%{_id}%::x} to cos({_ang}) * fbtSpeed()
		set {-fbtv::%{_id}%::y} to 0
		set {-fbtv::%{_id}%::z} to sin({_ang}) * fbtSpeed()
		set {-wping_qtest::%{_id}%} to true
		send "&a[fakeblock] 켰습니다. 시험 더미가 앞 15칸에서 움직여요. 더미를 보고 휠 클릭해서 채팅 메시지와 핑을 확인하세요. 끄기: /fakeblock off" to player

# 휠 클릭 신호 확인(서버가 받았는지 채팅으로 보여 준다). 핑 처리는 waypoint.sk 가 따로 한다.
on PlayerPickBlockEvent:
	set {_pl} to event.getPlayer()
	if {-fbt::%uuid of {_pl}%} is not set:
		stop
	set {_blk} to event.getBlock()
	set {_t} to {_blk}.getType()
	set {_tn} to {_t}.name()
	set {_bl} to {_blk}.getLocation()
	set {_bx} to round(x-coordinate of {_bl})
	set {_by} to round(y-coordinate of {_bl})
	set {_bz} to round(z-coordinate of {_bl})
	send "&b[fakeblock] 블록 집기 신호 받음: 서버 기준 블록 %{_tn}% (%{_bx}% %{_by}% %{_bz}%)" to {_pl}

on PlayerPickEntityEvent:
	set {_pl} to event.getPlayer()
	if {-fbt::%uuid of {_pl}%} is not set:
		stop
	send "&b[fakeblock] 엔티티 집기 신호 받음(블록 대신 더미를 집었어요)" to {_pl}

on quit:
	fbtStop(player)

# 스크립트를 다시 불러오면 남은 시험 더미를 지운다
on load:
	loop all entities:
		set {_e} to loop-entity
		set {_has} to {_e}.getScoreboardTags().contains("fbtdummy")
		if {_has} is true:
			{_e}.remove()
	# 남은 실제 light 블록(시험 중 재로드로 못 지운 것)을 공기로
	loop {-fbto::*}:
		set {_ob} to loop-value.getBlock()
		set {_ot} to {_ob}.getType()
		set {_on} to {_ot}.name()
		if {_on} is "LIGHT":
			{_ob}.setType(Material.AIR, false)
	delete {-fbt::*}
	delete {-fbtv::*}
	delete {-fbto::*}
	delete {-fbtr::*}
