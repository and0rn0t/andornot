# [waypoint.sk] locate bar 에 서버가 직접 웨이포인트(점)를 보낸다. 추가 기획 3~5단계의 바탕. 서버에서 /wptest 로 동작 확인됨(파란 점이 locate bar 에 뜸).
# 바닐라 플레이어 점은 main.sk locatorHide 로 전원 위치 전송 범위 0 이라 안 보인다. 여기서 보내는 점만 보인다(시청자별로 따로 보낼 수 있음).
# 패킷: ClientboundTrackedWaypointPacket.addWaypointPosition(uuid, icon, Vec3i) / removeWaypoint(uuid). 색은 Icon.color(Optional<Integer> RGB).
# 서버로 보내기: ((CraftPlayer)p).getHandle().connection.send(packet).
import:
	net.minecraft.network.protocol.game.ClientboundTrackedWaypointPacket
	net.minecraft.world.waypoints.Waypoint$Icon as WpIcon
	net.minecraft.core.Vec3i
	java.util.UUID
	java.util.Optional
	java.lang.Math

# 점 하나를 시청자에게 보낸다(처음엔 추가, 이미 있으면 위치 갱신). color 는 0xRRGGBB 를 10진수로(파랑 3447003 등).
function wpSend(v: player, id: text, x: number, y: number, z: number, color: number):
	set {_u} to UUID.fromString({_id})
	set {_ic} to new WpIcon()
	# 숫자 -> int: Skript 숫자에 intValue() 를 부르면 null 이 나와서(Vec3i 가 null 로 만들어지고 패킷 인코딩이 실패해 접속이 끊김) Math.round 와 Math.toIntExact 로 바꾼다.
	set {_ci} to Math.toIntExact(Math.round({_color}))
	set {_xi} to Math.toIntExact(Math.round({_x}))
	set {_yi} to Math.toIntExact(Math.round({_y}))
	set {_zi} to Math.toIntExact(Math.round({_z}))
	# 값이 하나라도 비면 보내지 않는다(잘못된 패킷은 클라이언트 접속을 끊는다).
	if {_ci} is not set:
		stop
	if {_xi} is not set:
		stop
	if {_yi} is not set:
		stop
	if {_zi} is not set:
		stop
	set {_ic}.color to Optional.of({_ci})
	set {_pos} to new Vec3i({_xi}, {_yi}, {_zi})
	if {_pos} is not set:
		stop
	set {_pk} to ClientboundTrackedWaypointPacket.addWaypointPosition({_u}, {_ic}, {_pos})
	{_v}.getHandle().connection.send({_pk})

function wpRemove(v: player, id: text):
	set {_u} to UUID.fromString({_id})
	set {_pk} to ClientboundTrackedWaypointPacket.removeWaypoint({_u})
	{_v}.getHandle().connection.send({_pk})

# 시험: 바라보는 쪽 20칸 앞에 파란 점을 10초 동안 locate bar 에 띄운다.
command /wptest:
	permission: op
	trigger:
		set {_l} to location 20 meters in front of player
		set {_id} to "00000000-0000-4000-8000-000000000001"
		# "x of {_l}" 는 올바른 Skript 문법이 아니라서 값이 비었다(그래서 함수에 null 이 넘어갔다). x-coordinate of 를 쓰고 미리 변수에 담아 넘긴다.
		set {_px} to x-coordinate of {_l}
		set {_py} to y-coordinate of {_l}
		set {_pz} to z-coordinate of {_l}
		wpSend(player, {_id}, {_px}, {_py}, {_pz}, 3447003)
		send "&a[wptest] 파란 점을 보냈습니다. 10초 뒤 지웁니다." to player
		wait 10 seconds
		wpRemove(player, {_id})

# ===== 팀원(초록) / 크라운(주황) 상시 표시 =====
# 게임 중 살아 있는 참가자에게만 보인다. 같은 팀 동료(본인 제외)는 초록 점, 크라운 소지자는(본인이 아니면) 주황 점(크라운 소지자는 팀과 상관없이 모두에게 주황으로 보이고 초록 점은 대신 빠진다).
# 점 id: 동료 = 그 사람의 uuid, 크라운 = 고정 uuid. {-wpset::보는사람uuid::id} = 마지막으로 보낸 좌표 문자열(바뀔 때만 다시 보낸다).
# 적은 표시하지 않는다(전원 위치 전송 범위 0 이라 바닐라 점도 없음). 색: 초록 0x55FF55, 주황 0xFF8C1A.
function wpActive(p: player) :: boolean:
	if {_p} is not online:
		return false
	set {_i} to "%uuid of {_p}%"
	if {-gplist::*} does not contain {_p}:
		return false
	if {-gwatch::%{_i}%} is set:
		return false
	if {-gdead::%{_i}%} is set:
		return false
	return true

function wpTeamSync():
	# 3초(12번)에 한 번은 좌표가 같아도 다시 보낸다: 월드를 옮기거나 리스폰하면 클라이언트가 점을 잃을 수 있어서
	add 1 to {-wpcnt}
	set {_force} to false
	if {-wpcnt} >= 12:
		set {-wpcnt} to 0
		set {_force} to true
	loop all players:
		set {_v} to loop-player
		set {_vid} to "%uuid of {_v}%"
		delete {_want::*}
		if {-ingame} is true:
			if wpActive({_v}) is true:
				loop {-gplist::*}:
					set {_t} to loop-value-2
					set {_tid} to "%uuid of {_t}%"
					if {_tid} is not {_vid}:
						if isAlly({_vid}, {_tid}) is true:
							if wpActive({_t}) is true:
								set {_want::%{_tid}%} to "%round(x-coordinate of {_t})%,%round(y-coordinate of {_t})%,%round(z-coordinate of {_t})%,5635925"
				set {_h} to gCrownHolder()
				if {_h} is set:
					set {_hid} to "%uuid of {_h}%"
					if {_hid} is not {_vid}:
						if wpActive({_h}) is true:
							delete {_want::%{_hid}%}
							set {_want::00000000-0000-4000-8000-0000000000c0} to "%round(x-coordinate of {_h})%,%round(y-coordinate of {_h})%,%round(z-coordinate of {_h})%,16747546"
		# 새로 생기거나 좌표가 바뀐 점만 보낸다
		loop {_want::*}:
			set {_k} to loop-index
			if {_force} is true or {-wpset::%{_vid}%::%{_k}%} is not loop-value-2:
				set {_parts::*} to split loop-value-2 at ","
				wpSend({_v}, {_k}, {_parts::1} parsed as number, {_parts::2} parsed as number, {_parts::3} parsed as number, {_parts::4} parsed as number)
				set {-wpset::%{_vid}%::%{_k}%} to loop-value-2
		# 더 이상 보이면 안 되는 점은 지운다
		loop {-wpset::%{_vid}%::*}:
			set {_k} to loop-index
			if {_want::%{_k}%} is not set:
				wpRemove({_v}, {_k})
				delete {-wpset::%{_vid}%::%{_k}%}

every 5 ticks:
	wpTeamSync()

on quit:
	delete {-wpset::%uuid of player%::*}

on load:
	delete {-wpset::*}
	delete {-wpcnt}
