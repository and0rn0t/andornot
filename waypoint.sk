# [waypoint.sk] locate bar 에 서버가 직접 웨이포인트(점)를 보낸다. 같은 파일에 핑(F키), 시청자별 발광(동료 초록/빨간 핑/크라운 주황)도 있다. 미검증: 가짜 팀 패킷(PlayerTeam/ClientboundSetPlayerTeamPacket 시그니처), hasLineOfSight, PlayerPickBlockEvent/PlayerPickEntityEvent 수신, attackStrengthTicker 리플렉션. 추가 기획 3~5단계의 바탕. 서버에서 /wptest 로 동작 확인됨(파란 점이 locate bar 에 뜸).
# 바닐라 플레이어 점은 main.sk locatorHide 로 전원 위치 전송 범위 0 이라 안 보인다. 여기서 보내는 점만 보인다(시청자별로 따로 보낼 수 있음).
# 패킷: ClientboundTrackedWaypointPacket.addWaypointPosition(uuid, icon, Vec3i) / removeWaypoint(uuid). 색은 Icon.color(Optional<Integer> RGB).
# 서버로 보내기: ((CraftPlayer)p).getHandle().connection.send(packet).
import:
	org.bukkit.Bukkit
	org.bukkit.ChatColor
	net.minecraft.network.protocol.game.ClientboundSetEntityDataPacket
	net.minecraft.network.syncher.SynchedEntityData$DataValue as WpData
	net.minecraft.network.syncher.EntityDataSerializers
	java.util.Collections
	java.lang.Byte
	net.minecraft.network.protocol.game.ClientboundTrackedWaypointPacket
	net.minecraft.world.waypoints.Waypoint$Icon as WpIcon
	net.minecraft.core.Vec3i
	java.util.UUID
	java.util.Optional
	java.lang.Math
	net.kyori.adventure.text.serializer.gson.GsonComponentSerializer
	org.bukkit.attribute.Attribute
	java.lang.reflect.Array as JArray
	net.minecraft.ChatFormatting
	net.minecraft.world.scores.PlayerTeam as WpPT
	net.minecraft.world.scores.Scoreboard as WpSB
	net.minecraft.network.protocol.game.ClientboundSetPlayerTeamPacket as WpTP
	net.minecraft.network.protocol.game.ClientboundSetPlayerTeamPacket$Action as WpTAct

# 점 하나를 시청자에게 보낸다(처음엔 추가, 이미 있으면 위치 갱신). color 는 0xRRGGBB 를 10진수로(파랑 3447003 등).
function wpSend(v: player, id: text, x: number, y: number, z: number, color: number):
	set {_u} to UUID.fromString({_id})
	set {_ic} to new WpIcon()
	# 숫자 -> int: Skript 숫자에 intValue() 를 부르면 null 이 나와서(Vec3i 가 null 로 만들어지고 패킷 인코딩이 실패해 접속이 끊김) Math.round 와 Math.toIntExact 로 바꾼다.
	set {_ci} to Math.toIntExact(Math.round({_color}))
	set {_xi} to Math.toIntExact(Math.round({_x}))
	set {_yi} to Math.toIntExact(Math.round({_y}))
	set {_zi} to Math.toIntExact(Math.round({_z}))
	# 값이 하나라도 비면 보내지 않는다(잘못된 패킷은 클라이언트 접속을 끊는다).
	if {_ci} is not set:
		stop
	if {_xi} is not set:
		stop
	if {_yi} is not set:
		stop
	if {_zi} is not set:
		stop
	set {_ic}.color to Optional.of({_ci})
	set {_pos} to new Vec3i({_xi}, {_yi}, {_zi})
	if {_pos} is not set:
		stop
	set {_pk} to ClientboundTrackedWaypointPacket.addWaypointPosition({_u}, {_ic}, {_pos})
	{_v}.getHandle().connection.send({_pk})

function wpRemove(v: player, id: text):
	set {_u} to UUID.fromString({_id})
	set {_pk} to ClientboundTrackedWaypointPacket.removeWaypoint({_u})
	{_v}.getHandle().connection.send({_pk})

# 시험: 바라보는 쪽 20칸 앞에 파란 점을 10초 동안 locate bar 에 띄운다.
command /wptest:
	permission: op
	trigger:
		set {_l} to location 20 meters in front of player
		set {_id} to "00000000-0000-4000-8000-000000000001"
		# "x of {_l}" 는 올바른 Skript 문법이 아니라서 값이 비었다(그래서 함수에 null 이 넘어갔다). x-coordinate of 를 쓰고 미리 변수에 담아 넘긴다.
		set {_px} to x-coordinate of {_l}
		set {_py} to y-coordinate of {_l}
		set {_pz} to z-coordinate of {_l}
		wpSend(player, {_id}, {_px}, {_py}, {_pz}, 3447003)
		send "&a[wptest] 파란 점을 보냈습니다. 10초 뒤 지웁니다." to player
		wait 10 seconds
		wpRemove(player, {_id})

# ===== 팀원(초록) / 크라운(주황) 상시 표시 =====
# 게임 중 살아 있는 참가자에게만 보인다. 같은 팀 동료(본인 제외)는 초록 점, 크라운 소지자는(본인이 아니면) 주황 점(크라운 소지자는 팀과 상관없이 모두에게 주황으로 보이고 초록 점은 대신 빠진다).
# 점 id: 동료 = 그 사람의 uuid, 크라운 = 고정 uuid. {-wpset::보는사람uuid::id} = 마지막으로 보낸 좌표 문자열(바뀔 때만 다시 보낸다).
# 적은 표시하지 않는다(전원 위치 전송 범위 0 이라 바닐라 점도 없음). 색: 초록 0x55FF55, 주황 0xFF8C1A.
# 보는 사람 v 에게 (tx, ty, tz) 의 점을 어디에 찍어야 하는지 "x,y,z" 문자열로 돌려준다. 좌우 끝 붙이기(시야 밖 점을 바 끝에 붙이는 기능)는 삭제했다: 항상 실제 위치.
function wpEffPos(v: player, tx: number, ty: number, tz: number) :: text:
	return "%round({_tx})%,%round({_ty})%,%round({_tz})%"

function wpActive(p: player) :: boolean:
	if {_p} is not online:
		return false
	set {_i} to "%uuid of {_p}%"
	if {-gplist::*} does not contain {_p}:
		return false
	if {-gwatch::%{_i}%} is set:
		return false
	if {-gdead::%{_i}%} is set:
		return false
	return true

function wpTeamSync():
	add 1 to {-wptick}
	wpPingUpdate()
	add 1 to {-wpcnt}
	add 1 to {-wpgcnt}
	# 3초(30번, 2틱마다 실행)에 한 번은 좌표가 같아도 다시 보낸다: 월드를 옮기거나 리스폰하면 클라이언트가 점을 잃을 수 있어서
	set {_force} to false
	if {-wpcnt} >= 30:
		set {-wpcnt} to 0
		set {_force} to true
	# 발광 플래그는 1.5초(15번)마다 다시 보낸다(바뀔 때는 바로). 같은 값을 자주 다시 보내면 발광이 깜빡여서 팀 항목은 바뀔 때만 보낸다.
	set {_gforce} to false
	if {-wpgcnt} >= 15:
		set {-wpgcnt} to 0
		set {_gforce} to true
	wpSyncViewers({_force}, {_gforce})

# 예전 휠 클릭 핑용으로 늘려 두었던 블록 상호작용 사거리(block_interaction_range)를 기본 4.5칸으로 되돌린다(접속/로드 때 한 번. 속성은 저장되므로 남아 있을 수 있음).
function wpReachReset(v: player):
	set {_at} to {_v}.getAttribute(Attribute.BLOCK_INTERACTION_RANGE)
	if {_at} is not set:
		stop
	set {_cur} to {_at}.getBaseValue()
	if abs({_cur} - 4.5) > 0.01:
		{_at}.setBaseValue(4.5)

# 모든 시청자에게 점(locate bar)과 발광 색을 맞춘다. force = 점을 전부 다시 보냄, gforce = 발광/팀 색을 전부 다시 보냄.
function wpSyncViewers(force: boolean, gforce: boolean):
	loop all players:
		set {_v} to loop-player
		set {_vid} to "%uuid of {_v}%"
		delete {_want::*}
		delete {_dc::*}
		delete {_de::*}
		if {-ingame} is true:
			if wpActive({_v}) is true:
				loop {-gplist::*}:
					set {_t} to loop-value-2
					set {_tid} to "%uuid of {_t}%"
					if {_tid} is not {_vid}:
						if isAlly({_vid}, {_tid}) is true:
							if wpActive({_t}) is true:
								set {_want::%{_tid}%} to "%wpEffPos({_v}, x-coordinate of {_t}, y-coordinate of {_t}, z-coordinate of {_t})%,5635925"
								# 동료는 항상 초록 발광(우선순위 최상). 적에게는 이 패킷을 보내지 않으므로 보이지 않는다.
								set {_dc::%{_tid}%} to "green"
								set {_de::%{_tid}%} to {_t}
				set {_h} to gCrownHolder()
				if {_h} is set:
					set {_hid} to "%uuid of {_h}%"
					if {_hid} is not {_vid}:
						if wpActive({_h}) is true:
							delete {_want::%{_hid}%}
							set {_want::00000000-0000-4000-8000-0000000000c0} to "%wpEffPos({_v}, x-coordinate of {_h}, y-coordinate of {_h}, z-coordinate of {_h})%,16747546"
							if {_dc::%{_hid}%} is not set:
								set {_dc::%{_hid}%} to "orange"
								set {_de::%{_hid}%} to {_h}
		# 핑: 찍은 사람과 같은 팀에게만 보인다. 파랑 0x3498DB, 빨강 0xFF3333
		loop {-wping_c::*}:
			set {_pp} to loop-index
			set {_pt} to loop-value-2
			set {_show} to false
			if wpActive({_v}) is true:
				if {_pp} is {_vid}:
					set {_show} to true
				else if isAlly({_vid}, {_pp}) is true:
					set {_show} to true
			if {_show} is true:
				set {_pcol} to 3447003
				if {_pt} is "red":
					set {_pcol} to 16724787
				set {_wid} to {-wping_id::%{_pp}%}
				set {_gx} to {-wping_x::%{_pp}%}
				set {_gy} to {-wping_y::%{_pp}%}
				set {_gz} to {-wping_z::%{_pp}%}
				set {_ep} to wpEffPos({_v}, {_gx}, {_gy}, {_gz})
				set {_want::%{_wid}%} to "%{_ep}%,%{_pcol}%"
				# 빨간 핑 대상의 붉은 발광: 동료 초록보다 아래, 크라운 주황보다 위. 투명 상태(invisible)인 대상은 발광을 켜지 않는다(풀리면 다시 켜짐).
				if {_pt} is "red":
					set {_pe} to {-wping_ent::%{_pp}%}
					set {_pet} to {-wping_e::%{_pp}%}
					if {_pe} is set:
						if {_pet} is not {_vid}:
							if {_dc::%{_pet}%} is not "green":
								set {_inv} to false
								if {_pe} is a player:
									if {_pe}.isInvisible() is true:
										set {_inv} to true
								if {_inv} is false:
									set {_dc::%{_pet}%} to "red"
									set {_de::%{_pet}%} to {_pe}
		# 새로 생기거나 좌표가 바뀐 점만 보낸다
		loop {_want::*}:
			set {_k} to loop-index
			set {_nv} to loop-value-2
			set {_send} to false
			if {_force} is true:
				set {_send} to true
			else if {-wpset::%{_vid}%::%{_k}%} is not {_nv}:
				set {_send} to true
			if {_send} is true:
				set {_parts::*} to split loop-value-2 at ","
				wpSend({_v}, {_k}, {_parts::1} parsed as number, {_parts::2} parsed as number, {_parts::3} parsed as number, {_parts::4} parsed as number)
				set {-wpset::%{_vid}%::%{_k}%} to loop-value-2
		# 더 이상 보이면 안 되는 점은 지운다
		loop {-wpset::%{_vid}%::*}:
			set {_k} to loop-index
			if {_want::%{_k}%} is not set:
				wpRemove({_v}, {_k})
				delete {-wpset::%{_vid}%::%{_k}%}
		# 발광 색 적용/해제
		loop {_dc::*}:
			set {_k} to loop-index
			set {_ent} to {_de::%{_k}%}
			if {_ent} is set:
				wpColorApply({_v}, {_ent}, {_k}, loop-value-2, {_gforce})
		loop {-wpvm::%{_vid}%::*}:
			set {_k} to loop-index
			if {_dc::%{_k}%} is not set:
				wpColorClear({_v}, {_k})

# ===== 시청자별 발광(패킷) =====
# 발광 켜기 = 시청자에게만 "발광" 플래그를 켠 엔티티 데이터 패킷을 보낸다(다른 사람에겐 안 보냄). 발광 색 = 클라이언트가 아는 팀 색이라,
# 시청자에게만 가짜 팀(wpgrn 초록 / wpred 빨강 / wporg 주황, 서버에는 없음)을 팀 패킷으로 만들고 대상을 그 팀에 넣는다 -> 서버 스코어보드 팀(크라운 gcrown, 낙하 dropc 등)과 상관없이 시청자별로 색이 정해진다.
# 우선순위: 동료 초록 > 빨간 핑 > 크라운 주황(wpSyncViewers 가 대상마다 하나의 색만 정한다). 서버가 팀/데이터를 다시 보내면 덮어써지므로 팀 항목은 바뀔 때만, 발광 플래그는 바뀔 때+1.5초마다 보낸다. 전부 미검증.
# 캐시: {-wpvm::시청자::대상uuid} = 지금 넣은 색, {-wpvme::시청자::대상uuid} = 팀 항목 이름(플레이어 이름/그 외 uuid), {-wpgf::시청자::대상uuid} = 마지막으로 보낸 플래그 값, {-wpvt::시청자} = 가짜 팀을 만들어 보냈는지.
# 플래그: 불 1, 웅크림 2, 달리기 8, 수영 16, 투명 32, 발광 64, 겉날개 128(그 밖의 플래그는 생략).
function wpFlags(t: entity) :: number:
	set {_f} to 0
	if {_t}.getFireTicks() > 0:
		add 1 to {_f}
	if {_t} is a player:
		if {_t}.isSneaking() is true:
			add 2 to {_f}
		if {_t}.isSprinting() is true:
			add 8 to {_f}
		if {_t}.isSwimming() is true:
			add 16 to {_f}
		if {_t}.isInvisible() is true:
			add 32 to {_f}
		if {_t}.isGliding() is true:
			add 128 to {_f}
	return {_f}

function wpGlowSend(v: player, t: entity, on: boolean):
	set {_f} to wpFlags({_t})
	if {_on} is true:
		add 64 to {_f}
	set {_bv} to Byte.parseByte("%{_f}%")
	set {_dv} to new WpData(0, EntityDataSerializers.BYTE, {_bv})
	set {_pk} to new ClientboundSetEntityDataPacket({_t}.getEntityId(), Collections.singletonList({_dv}))
	{_v}.getHandle().connection.send({_pk})

# 가짜 팀 객체(서버 전체에서 하나씩, 멤버는 넣지 않고 항목은 패킷으로만 넣고 뺀다)
function wpVTeam(n: text) :: object:
	if {-wpvto::%{_n}%} is not set:
		set {_tm} to new WpPT(new WpSB(), {_n})
		if {_n} is "wpgrn":
			{_tm}.setColor(ChatFormatting.GREEN)
		else if {_n} is "wpred":
			{_tm}.setColor(ChatFormatting.RED)
		else:
			{_tm}.setColor(ChatFormatting.GOLD)
		set {-wpvto::%{_n}%} to {_tm}
	return {-wpvto::%{_n}%}

function wpColTeam(col: text) :: text:
	if {_col} is "green":
		return "wpgrn"
	if {_col} is "red":
		return "wpred"
	return "wporg"

# 시청자에게 가짜 팀 3개를 만들어 보낸다(한 번만). 이미 있는 팀 이름을 또 만들면 클라이언트가 오류를 내므로 먼저 지우는 패킷을 보낸다(없으면 무시됨).
function wpVTEnsure(v: player):
	set {_vid} to "%uuid of {_v}%"
	if {-wpvt::%{_vid}%} is true:
		stop
	set {-wpvt::%{_vid}%} to true
	loop "wpgrn", "wpred", "wporg":
		set {_tm} to wpVTeam(loop-value)
		set {_p1} to WpTP.createRemovePacket({_tm})
		{_v}.getHandle().connection.send({_p1})
		set {_p2} to WpTP.createAddOrModifyPacket({_tm}, true)
		{_v}.getHandle().connection.send({_p2})

# 가짜 팀에 항목을 넣거나(act "add") 뺀다(act "remove")
function wpTeamPut(v: player, n: text, entry: text, act: text):
	set {_tm} to wpVTeam({_n})
	if {_act} is "add":
		set {_pk} to WpTP.createPlayerPacket({_tm}, {_entry}, WpTAct.ADD)
	else:
		set {_pk} to WpTP.createPlayerPacket({_tm}, {_entry}, WpTAct.REMOVE)
	{_v}.getHandle().connection.send({_pk})

# v 에게 t(대상, 아이디 tid)의 발광 색을 col("green"/"red"/"orange")로 맞춘다. 초록/빨강은 발광 플래그도 보낸다(주황은 크라운의 실제 발광을 그대로 쓰고 색만 바꿈).
function wpColorApply(v: player, t: entity, tid: text, col: text, gforce: boolean):
	set {_vid} to "%uuid of {_v}%"
	wpVTEnsure({_v})
	set {_cur} to {-wpvm::%{_vid}%::%{_tid}%}
	set {_entry} to "%uuid of {_t}%"
	if {_t} is a player:
		set {_entry} to {_t}.getName()
	set {_changed} to false
	if {_cur} is not {_col}:
		set {_changed} to true
	if {_changed} is true:
		wpTeamPut({_v}, wpColTeam({_col}), {_entry}, "add")
		set {-wpvm::%{_vid}%::%{_tid}%} to {_col}
		set {-wpvme::%{_vid}%::%{_tid}%} to {_entry}
	set {_gl} to false
	if {_col} is "green":
		set {_gl} to true
	if {_col} is "red":
		set {_gl} to true
	if {_gl} is true:
		set {_key} to "%wpFlags({_t})%"
		set {_do} to false
		if {_changed} is true:
			set {_do} to true
		else if {_gforce} is true:
			set {_do} to true
		else if {-wpgf::%{_vid}%::%{_tid}%} is not {_key}:
			set {_do} to true
		if {_do} is true:
			wpGlowSend({_v}, {_t}, true)
			set {-wpgf::%{_vid}%::%{_tid}%} to {_key}
	else if {_changed} is true:
		# 초록/빨강에서 주황으로 바뀌면 플래그를 실제 발광 상태로 돌린다
		set {_real} to {_t}.isGlowing()
		wpGlowSend({_v}, {_t}, {_real})
		delete {-wpgf::%{_vid}%::%{_tid}%}

# v 에게 보내 둔 대상 tid 의 발광 색을 걷는다(가짜 팀에서 빼고, 발광 플래그는 실제 상태로 되돌림)
function wpColorClear(v: player, tid: text):
	set {_vid} to "%uuid of {_v}%"
	set {_c} to {-wpvm::%{_vid}%::%{_tid}%}
	set {_entry} to {-wpvme::%{_vid}%::%{_tid}%}
	if {_c} is set:
		wpTeamPut({_v}, wpColTeam({_c}), {_entry}, "remove")
		set {_gl} to false
		if {_c} is "green":
			set {_gl} to true
		if {_c} is "red":
			set {_gl} to true
		if {_gl} is true:
			set {_t} to wpFind({_tid})
			if {_t} is set:
				set {_real} to {_t}.isGlowing()
				wpGlowSend({_v}, {_t}, {_real})
	delete {-wpvm::%{_vid}%::%{_tid}%}
	delete {-wpvme::%{_vid}%::%{_tid}%}
	delete {-wpgf::%{_vid}%::%{_tid}%}

# uuid 문자열로 플레이어 또는 더미(마네킹) 엔티티를 찾는다
function wpFind(id: text) :: entity:
	loop all entities:
		if "%uuid of loop-entity%" is {_id}:
			return loop-entity
	return {_none}

# 핑 하나를 지운다(발광은 다음 동기화(0.1초 안)에서 걷힌다)
function wpPingClear(pid: text):
	delete {-wping_c::%{_pid}%}
	delete {-wping_ent::%{_pid}%}

# ===== 핑 시스템(F 키) =====
# F(손 바꾸기)를 누르면 바라보는 자리에 파란 핑, 그 근처(또는 조준선 위)에 적이 있으면 대신 그 적에게 빨간 핑(적이 움직이면 따라감)이 찍힌다.
# 핑은 찍은 사람과 같은 팀(개인전은 본인)에게만 locate bar 로 보이고 소리(mck:pingblue / mck:pingred)가 난다. 한 사람당 핑은 하나(새로 찍으면 교체).
# 빨간 핑 대상은 "화면에 보이는" 적만: 시야각 안(약 37도) + 눈/몸통에서 시선이 블록에 안 막혀야 하고(벽 뒤 제외), 후보 중 가장 가까운 적 하나만. 시험 핑도 이 검사를 한다(단 /pingtest red 는 강제라 건너뜀).
# 입력: F키(손 바꾸기, on swap hand items). 허공이면 파란 핑은 안 찍힌다. 스팸 방지: 3초 안에 5번 찍으면 5초 동안 제한(액션바 알림).
# 변수 추가: {-wping_ent::pid}(빨간 핑 대상 엔티티), {-wping_hist::pid::*}(최근 핑 시각), {-wping_lock::pid}(제한 끝 틱).
# 변수(RAM, 찍은 사람 uuid 기준): {-wping_c::pid}(blue/red) {-wping_x/y/z::pid} {-wping_e::pid}(빨간 핑 대상 uuid) {-wping_id::pid}(점 id) {-wping_until::pid}(만료 틱) {-wping_cd::pid}(쿨다운)
# 시간 단위 {-wptick} = wpTeamSync 실행 횟수(0.1초). 숫자는 아래 함수에서 바꾼다.
function wpPingSec() :: number:
	return 5

function wpPingCoolSec() :: number:
	return 0.3

# 스팸 방지: 이 시간(초) 안에 wpPingSpamCount() 번 찍으면 wpPingLockSec() 초 동안 못 찍는다
function wpPingSpamSec() :: number:
	return 3

function wpPingSpamCount() :: number:
	return 5

function wpPingLockSec() :: number:
	return 5

# 적 감지: 조준선에서 이 거리(칸) 안에 있는 적, 또는 조준한 자리에서 이 거리(칸) 안에 있는 적
function wpPingRay() :: number:
	return 2

function wpPingNear() :: number:
	return 4.5

# 조준한 자리(블록이 120칸 안에 없으면 허공이라 값 없음)
function wpAimLoc(p: player) :: location:
	set {_b} to {_p}.getTargetBlockExact(120)
	if {_b} is set:
		return {_b}.getLocation().add(0.5, 0.5, 0.5)
	return {_none}

# 핑 하나를 찍는다: 조준/주변에 화면에 보이는 적이 있으면 빨강, 아니면 파랑
function wpPingCreate(p: player):
	set {_pid} to "%uuid of {_p}%"
	set {_hit} to wpAimLoc({_p})
	set {_eye} to eye location of {_p}
	set {_air} to false
	if {_hit} is not set:
		# 허공(블록이 없음): 조준선 위에 적이 있을 때만 빨간 핑이 되고, 아니면 핑을 찍지 않는다(기존 핑은 그대로)
		set {_air} to true
		set {_hit} to {_eye}.clone().add({_eye}.getDirection().clone().multiply(100))
	set {_dir} to {_eye}.getDirection()
	set {_hd} to distance between {_eye} and {_hit}
	set {_best} to -1
	set {_bestd} to 100000
	loop all entities:
		set {_t} to loop-entity
		set {_tk} to "none"
		if {_t} is a player:
			set {_tk} to "player"
		else if {_t}.getType().name() is "MANNEQUIN":
			set {_tk} to "dummy"
		else if {_t}.getType().name() is "BEE":
			set {_tk} to "bee"
		if {_t} is not {_p}:
			set {_tid} to "%uuid of {_t}%"
			set {_ok} to false
			if {_tk} is "player":
				if wpActive({_t}) is true:
					if isAlly({_pid}, {_tid}) is false:
						set {_ok} to true
				# 꿀벌에 탑승 중인(조종 중) 적 몸은 핑 대상이 아니다(대신 적 꿀벌이 대상, 아래)
				if {-beemode::%{_tid}%} is "drive":
					set {_ok} to false
			else if {_tk} is "bee":
				# 적 꿀벌 드론(bee.sk 의 {-bee::주인uuid}): 본인/아군 꿀벌은 제외
				loop {-bee::*}:
					set {_bz} to loop-value-2
					set {_bo2} to loop-index
					if "%uuid of {_bz}%" is {_tid}:
						if {_bo2} is not {_pid}:
							if isAlly({_pid}, {_bo2}) is false:
								set {_ok} to true
			else if {_tk} is "dummy":
				# 더미(마네킹)도 적처럼 핑이 찍힌다. 단 본인/아군의 꿀벌 조종 중 본체 더미는 제외.
				set {_ok} to true
				loop {-beebody::*}:
					set {_bb} to loop-value-2
					set {_bo} to loop-index
					if "%uuid of {_bb}%" is {_tid}:
						if {_bo} is {_pid}:
							set {_ok} to false
						else if isAlly({_pid}, {_bo}) is true:
							set {_ok} to false
			if {_ok} is true:
				if world of {_t} is world of {_p}:
					set {_ec} to ({_t}'s location) ~ vector(0, 1, 0)
					set {_rel} to vector from {_eye} to {_ec}
					set {_tt} to {_dir} dot {_rel}
					set {_pv} to {_rel} - ({_dir} * {_tt})
					set {_perp} to vector length of {_pv}
					set {_cand} to false
					if {_tt} > 0:
						if {_tt} <= {_hd} + 4:
							if {_perp} <= wpPingRay():
								set {_cand} to true
					if distance between {_ec} and {_hit} <= wpPingNear():
						set {_cand} to true
					if {_cand} is true:
						# 화면에 보이는 적만(벽 뒤는 제외): 시야각 안 + 눈/몸통에서 시선이 안 막힘
						set {_vis} to false
						set {_rlen} to vector length of {_rel}
						if {_rlen} > 0.1:
							if {_tt} / {_rlen} >= 0.8:
								if {_p}.hasLineOfSight({_t}) is true:
									set {_vis} to true
								else if {_p}.hasLineOfSight({_ec}) is true:
									set {_vis} to true
						if {_vis} is not true:
							set {_cand} to false
					if {_cand} is true:
						set {_sc} to {_perp} + distance between {_ec} and {_hit} / 10
						set {_sc} to distance between {_eye} and {_ec}
						if {_sc} < {_bestd}:
							set {_bestd} to {_sc}
							set {_best} to {_tid}
							set {_bestp} to {_t}
	if {_air} is true:
		if {_best} is -1:
			stop
	wpPingClear({_pid})
	delete {-wping_e::%{_pid}%}
	set {-wping_c::%{_pid}%} to "blue"
	set {_l} to {_hit}
	if {_best} is not -1:
		set {-wping_c::%{_pid}%} to "red"
		set {-wping_e::%{_pid}%} to {_best}
		set {_l} to {_bestp}'s location
		set {-wping_ent::%{_pid}%} to {_bestp}
	set {-wping_x::%{_pid}%} to x-coordinate of {_l}
	set {-wping_y::%{_pid}%} to y-coordinate of {_l}
	set {-wping_z::%{_pid}%} to z-coordinate of {_l}
	if {-wping_id::%{_pid}%} is not set:
		set {_u} to UUID.randomUUID()
		set {-wping_id::%{_pid}%} to "%{_u}%"
	set {-wping_until::%{_pid}%} to {-wptick} + wpPingSec() * 10
	set {_snd} to "mck:pingblue"
	if {-wping_c::%{_pid}%} is "red":
		set {_snd} to "mck:pingred"
	play sound {_snd} to {_p}
	loop {-gplist::*}:
		if loop-value is not {_p}:
			if isAlly({_pid}, "%uuid of loop-value%") is true:
				if wpActive(loop-value) is true:
					play sound {_snd} to loop-value
					# 빨간 핑: 팀원에게 채팅으로 알린다(머리 얼굴 + 이름). 미검증: 1.21.9+ 플레이어 머리 오브젝트 컴포넌트
					if {-wping_c::%{_pid}%} is "red":
						set {_nm} to {_p}.getName()
						set {_cj} to "{""text"":"""",""extra"":[{""object"":""player"",""player"":{""name"":""%{_nm}%""}},{""text"":"" ""},{""text"":""%{_nm}%"",""color"":""green""},{""text"":""님이 적을 발견했습니다.""}]}"
						loop-value.sendMessage(GsonComponentSerializer.gson().deserialize({_cj}))
	# 본인에게도 같은 메시지를 보낸다
	if {-wping_c::%{_pid}%} is "red":
		set {_nm} to {_p}.getName()
		set {_cj} to "{""text"":"""",""extra"":[{""object"":""player"",""player"":{""name"":""%{_nm}%""}},{""text"":"" ""},{""text"":""%{_nm}%"",""color"":""green""},{""text"":""님이 적을 발견했습니다.""}]}"
		{_p}.sendMessage(GsonComponentSerializer.gson().deserialize({_cj}))
	# 표식(pingmark.sk)과 locate bar 점, 발광을 같은 순간에 맞춘다(다음 2틱 갱신을 기다리지 않고 바로)
	pmSync()
	wpSyncViewers(false, true)

# 입력 하나를 핑으로 처리한다. 처리했으면(이벤트를 취소해야 하면) true.
function wpPingInput(p: player) :: boolean:
	if {-ingame} is not true:
		return false
	if wpActive({_p}) is not true:
		return false
	if {-beemode::%uuid of {_p}%} is "drive":
		return false
	wpPingTry({_p})
	return true

# 쿨다운 + 스팸 방지를 거쳐 핑을 찍는다
function wpPingTry(p: player):
	set {_pid} to "%uuid of {_p}%"
	if {-wping_lock::%{_pid}%} > {-wptick}:
		send action bar colored "&c핑을 너무 자주 사용해 잠시 제한됩니다." to {_p}
		stop
	if {-wping_cd::%{_pid}%} > {-wptick}:
		stop
	set {-wping_cd::%{_pid}%} to {-wptick} + wpPingCoolSec() * 10
	# 최근 핑 시각 기록(오래된 건 지움). 기준 횟수에 닿으면 제한을 건다(이번 핑은 찍힌다).
	set {-wping_hist::%{_pid}%::%{-wptick}%} to {-wptick}
	loop {-wping_hist::%{_pid}%::*}:
		set {_hk} to loop-index
		set {_hv} to loop-value-2
		if {_hv} < {-wptick} - wpPingSpamSec() * 10:
			delete {-wping_hist::%{_pid}%::%{_hk}%}
	if size of {-wping_hist::%{_pid}%::*} >= wpPingSpamCount():
		set {-wping_lock::%{_pid}%} to {-wptick} + wpPingLockSec() * 10
		delete {-wping_hist::%{_pid}%::*}
	wpPingCreate({_p})

# 공격 쿨타임(attackStrengthTicker) 접근: F 로 손 바꾸기를 취소하면 손 아이템이 잠깐 바뀐 걸로 처리되어 공격 쿨타임이 돌 수 있어, 전후로 값을 저장/복원한다(서버 쪽 값, 미검증).
function wpAtkField(h: object) :: object:
	if {-wpatkf} is set:
		return {-wpatkf}
	set {_c} to {_h}.getClass()
	set {_n} to 0
	while {_c} is set:
		# 배열은 반복문에 못 넣으므로(단일 값 취급) java.lang.reflect.Array 로 번호로 꺼낸다
		set {_arr} to {_c}.getDeclaredFields()
		set {_len} to JArray.getLength({_arr})
		set {_i} to 0
		while {_i} < {_len}:
			set {_fd} to JArray.get({_arr}, {_i})
			set {_fn} to {_fd}.getName()
			if {_fn} is "attackStrengthTicker":
				{_fd}.setAccessible(true)
				set {-wpatkf} to {_fd}
				return {_fd}
			add 1 to {_i}
		set {_c} to {_c}.getSuperclass()
		add 1 to {_n}
		if {_n} > 12:
			return {_none}
	return {_none}

function wpAtkGet(p: player) :: number:
	set {_h} to {_p}.getHandle()
	set {_fd} to wpAtkField({_h})
	if {_fd} is not set:
		return -1
	set {_v} to {_fd}.getInt({_h})
	return {_v}

function wpAtkSet(p: player, n: number):
	set {_h} to {_p}.getHandle()
	set {_fd} to wpAtkField({_h})
	if {_fd} is not set:
		stop
	set {_iv} to Math.toIntExact(Math.round({_n}))
	if {_iv} is not set:
		stop
	{_fd}.setInt({_h}, {_iv})

# F키(손 바꾸기)가 핑 키다. 앉은 채로 누르면 진짜 손 바꾸기, 서 있으면 취소하고 핑. Q(버리기)와 휠 클릭은 더 이상 핑이 아니다.
# 공격 쿨타임이 돌지 않게 복원(틱마다 1씩 오르므로 지난 틱 수만큼 더한다).
on swap hand items:
	# 앉기 + F 는 진짜 손 바꾸기(취소 안 함, 핑 안 찍힘)
	if player is sneaking:
		stop
	cancel event
	set {_p} to player
	set {_a} to wpAtkGet({_p})
	if wpPingInput({_p}) is not true:
		stop
	if {_a} >= 0:
		wait 1 tick
		if {_p} is online:
			wpAtkSet({_p}, {_a} + 1)
		wait 1 tick
		if {_p} is online:
			wpAtkSet({_p}, {_a} + 2)

# 게임 중 활성 참가자는 예전처럼 아이템을 못 버린다(Q 가 핑이던 때의 동작 유지)
on drop:
	if {-ingame} is true:
		if wpActive(player) is true:
			cancel event

# 핑 상태 갱신: 만료/무효 핑 삭제, 빨간 핑은 대상 위치를 따라간다
function wpPingUpdate():
	loop {-wping_c::*}:
		set {_pid} to loop-index
		set {_keep} to true
		if {-wping_until::%{_pid}%} < {-wptick}:
			set {_keep} to false
		if {-ingame} is not true:
			set {_keep} to false
		if {_keep} is true:
			if {-wping_c::%{_pid}%} is "red":
				set {_found} to false
				set {_te} to {-wping_ent::%{_pid}%}
				if {_te} is set:
					set {_valid} to {_te}.isValid()
					if {_valid} is true:
						set {_okp} to true
						if {_te} is a player:
							set {_okp} to false
							if wpActive({_te}) is true:
								set {_okp} to true
						if {_okp} is true:
							set {_found} to true
							set {-wping_x::%{_pid}%} to x-coordinate of {_te}
							set {-wping_y::%{_pid}%} to y-coordinate of {_te}
							set {-wping_z::%{_pid}%} to z-coordinate of {_te}
				if {_found} is false:
					set {_keep} to false
		if {_keep} is false:
			wpPingClear({_pid})

# 2틱마다 갱신(바뀐 점만 전송)
every 2 ticks:
	wpTeamSync()

on quit:
	delete {-wpset::%uuid of player%::*}
	delete {-wpvt::%uuid of player%}
	delete {-wpvm::%uuid of player%::*}
	delete {-wpvme::%uuid of player%::*}
	delete {-wpgf::%uuid of player%::*}

on join:
	wpReachReset(player)

on load:
	loop all players:
		wpReachReset(loop-player)
	delete {-wpset::*}
	delete {-wpcnt}
	delete {-wpgcnt}
	delete {-wpvt::*}
	delete {-wpvm::*}
	delete {-wpvme::*}
	delete {-wpgf::*}
	delete {-wpvto::*}
	delete {-wpatkf}
