# [game.sk] 게임 진행: 시작/종료, 팀 배정, 전적(K/D/A/가한 피해), 바운티(별/현상금 스코어), 섬멸전(목숨 1개, 라운드 승점), 승리 판정.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 아직 없는 것: 맵 설정(스폰 위치, 로비 위치). 그 자리는 gameSpawn()(게임/라운드 시작 때 각자 보낼 곳)에 비워 뒀다. 지금은 아무 데도 안 보낸다.
# 이 파일이 쓰는 변수(RAM 전용):
#   {-ingame}          게임 진행 중(true). items.sk 가 읽어서 무기고를 치운다.
#   {-gover}           승패가 난 뒤(종연출 중)면 true. 새 킬/점수를 더 받지 않는다.
#   {-gmode}           이번 게임모드 id(bounty/annihilation, 시작 때 gcMode() 를 복사)
#   {-gtarget}         이번 게임의 목표 스코어(바운티)/목표 승점(섬멸전, 시작 때 복사)
#   {-gteams}          이번 게임의 팀 수(0 = 개인전)
#   {-gplist::*}       이번 게임 참가자(시작 때 접속해 있던 플레이어, 순서 유지)
#   {-gteamlist::*}    팀 키 목록(정렬됨). 팀전은 {-team} 의 팀 이름("1팀"), 개인전은 "p_플레이어uuid"
#   {-gname::팀키}      팀 이름(팀전은 {-team} 의 팀 이름, 개인전은 플레이어 이름). 화면에는 gTeamName() 이 만든 색 약자 3글자(RED, BLU ...)로 표시한다.
#   {-gpteam::uuid} {-gpname::uuid}   시작 때 기록한 참가자의 팀 키/이름(중간에 나가도 결과창에 남기려고)
#   {-gscore::팀키}     팀 스코어(바운티)/승점(섬멸전)
#   {-gk::uuid} {-gd::uuid} {-ga::uuid} {-gdmg::uuid}   킬/데스/어시스트/가한 피해(실 체력, 적에게 준 것만)
#   {-gstar::uuid}     바운티 별 개수(기본 gStarBase())
#   {-gstar_d::uuid}   머리 위 별 표시(텍스트 디스플레이)
#   {-gdead::uuid}     섬멸전에서 이번 라운드에 죽은 플레이어
#   {-groundend}       섬멸전에서 라운드가 끝나는 중(true)
#   {-groundwin}       이번 라운드 승리 팀 키(무승부는 ""). killcine.sk 의 라운드 종료 연출이 읽는다.
#   {-glastdmg::피격자uuid::공격자uuid}   마지막으로 피해를 준 시각(어시스트 판정용)
# 킬 처리 연결: killcine.sk 의 killScoreHook() 가 gameOnKill() 을 부르고, 치명타 피해량은 gameDamageRecord() 로 넘긴다. 치명타가 아닌 피해는 아래 on damage 가 센다.
import:
	net.kyori.adventure.text.serializer.gson.GsonComponentSerializer
	org.bukkit.event.player.PlayerMoveEvent

# 미검증: attacker 가 투사체/커스텀 피해 출처의 주인으로 잡히는지, shuffled/sorted 문법, text display 승차(statustag.sk 와 같은 방식).

# ===== 기본값/조회 =====
function gStarBase() :: number:
	return 2

# 어시스트로 인정하는 시간(이 시간 안에 피해를 줬어야 함)
function gAssistSec() :: number:
	return 10

function gTeamColor(i: number) :: text:
	set {_c::*} to "&c", "&9", "&a", "&e", "&d", "&b", "&6", "&5"
	return {_c::%mod({_i} - 1, 8) + 1%}

# 플레이어의 팀 키. 개인전이면 자기 자신만의 키, 팀전이면 {-team} 값(없으면 "").
function gTeamOf(p: player) :: text:
	if {-gteams} is 0:
		return "p_%uuid of {_p}%"
	set {_t} to {-team::%uuid of {_p}%}
	if {_t} is not set:
		return ""
	return "%{_t}%"

function gTeamIndex(key: text) :: number:
	loop {-gteamlist::*}:
		if loop-value is {_key}:
			return loop-index parsed as number
	return 99

# 팀 색 약자 3글자(gTeamColor 와 같은 순서: 빨강 파랑 초록 노랑 분홍 하늘 주황 보라)
function gTeamAbbr(i: number) :: text:
	set {_a::*} to "RED", "BLU", "GRN", "YEL", "PNK", "CYN", "ORG", "PUR"
	return {_a::%mod({_i} - 1, 8) + 1%}

# 팀 표시 이름(색 코드 없음): 팀전은 색 약자 3글자, 개인전은 플레이어 이름
function gTeamName(key: text) :: text:
	if {-gteams} > 0:
		return gTeamAbbr(gTeamIndex({_key}))
	return "%{-gname::%{_key}%}%"

# 색 코드가 붙은 팀 표시 이름
function gTeamLabel(key: text) :: text:
	return "%gTeamColor(gTeamIndex({_key}))%%gTeamName({_key})%&r"

function gInGame(p: player) :: boolean:
	if {-ingame} is not true:
		return false
	if {-gplist::*} contains {_p}:
		return true
	return false

# 살아 있는 참가자(접속 중이고 섬멸전에서 죽지 않음)
function gAlive(p: player) :: boolean:
	if {_p} is not online:
		return false
	if {-gdead::%uuid of {_p}%} is set:
		return false
	return true

function gTeamCount(name: text) :: number:
	set {_c} to 0
	loop {-gplist::*}:
		if {-team::%uuid of loop-value%} is {_name}:
			add 1 to {_c}
	return {_c}

# 인원이 가장 적은 팀 이름(1팀~n팀 중)
function gPickTeam(n: number) :: text:
	set {_best} to "1팀"
	set {_bc} to gTeamCount("1팀")
	set {_i} to 2
	while {_i} <= {_n}:
		set {_c} to gTeamCount("%{_i}%팀")
		if {_c} < {_bc}:
			set {_bc} to {_c}
			set {_best} to "%{_i}%팀"
		add 1 to {_i}
	return {_best}

# ===== 맵 연결 자리 =====
# 게임/라운드가 시작될 때 플레이어를 보낼 곳. 맵 설정이 생기면 여기서 teleport 한다(지금은 제자리).
function gameSpawn(p: player):
	stop

# ===== 머리 위 별(바운티) =====
function gStarText(n: number) :: text:
	if {_n} <= 5:
		set {_s} to "★" repeated {_n} times
		return "&e%{_s}%"
	return "&e★ x%{_n}%"

function gStarRemove(id: text):
	set {_d} to {-gstar_d::%{_id}%}
	if {_d} is set:
		delete entity within {_d}
	delete {-gstar_d::%{_id}%}

# 별 표시를 맞춘다: 바운티 게임 중이고 살아서 움직이는 플레이어에게만 보인다. 체력바(0.6)/상태 이름(0.9) 위 1.2 높이에 태운다.
function gStarSync(p: player):
	set {_id} to "%uuid of {_p}%"
	set {_show} to true
	if {-ingame} is not true:
		set {_show} to false
	if {-gmode} is not "bounty":
		set {_show} to false
	if {-kc::%{_id}%} is set:
		set {_show} to false
	if {_p} is not online:
		set {_show} to false
	else if gamemode of {_p} is spectator:
		set {_show} to false
	if {-invis::%{_id}%} is set:
		if {-invis::%{_id}%} > now:
			set {_show} to false
	if {_show} is false:
		gStarRemove({_id})
		stop
	set {_n} to {-gstar::%{_id}%}
	if {_n} is not a number:
		set {_n} to gStarBase()
	set {_d} to {-gstar_d::%{_id}%}
	set {_new} to false
	if {_d} is not set:
		set {_new} to true
	else if {_d} is dead:
		set {_new} to true
	else if vehicle of {_d} is not {_p}:
		delete entity within {_d}
		set {_new} to true
	if {_new} is true:
		spawn a text display at location of {_p}:
			set {_d} to event-entity
			add "gstar" to scoreboard tags of event-entity
			set billboard of event-entity to center
			set transformation translation of event-entity to vector(0, 1.2, 0)
			add event-entity to passengers of {_p}
		set {-gstar_d::%{_id}%} to {_d}
	set text of {_d} to gStarText({_n})

every second:
	if {-ingame} is true:
		loop {-gplist::*}:
			gStarSync(loop-value)

# ===== 시작/리스폰/종료 =====
# 한 명을 시작/라운드 시작 상태로 되돌린다: 상태 정리, 체력/스태미너 회복, 아이템 구성 지급, 어드벤처 모드, 스폰 위치로.
function gameRespawn(p: player):
	set {_id} to "%uuid of {_p}%"
	kcClearState({_p})
	set gamemode of {_p} to adventure
	set {_mh} to {_p}'s max health
	set {_p}'s health to {_mh}
	set {-st::%{_id}%} to 100
	set level progress of {_p} to 0.999
	{_p}.clearTitle()
	delete {-gdead::%{_id}%}
	loadoutGive({_p})
	gameSpawn({_p})

function gameStart(by: text):
	if {-ingame} is true:
		stop
	set {-gmode} to gcMode()
	set {-gtarget} to gcTarget({-gmode})
	set {_n} to gcTeams()
	set {-gteams} to {_n}
	delete {-gplist::*}
	loop all players:
		add loop-player to {-gplist::*}
	if size of {-gplist::*} < 1:
		stop
	# 팀 배정: 이미 팀이 있는(/team) 사람은 그대로 두고, 나머지는 섞어서 인원이 가장 적은 팀에 넣는다. 팀 배정은 {-team} 변수.
	if {_n} > 0:
		set {_sh::*} to shuffled {-gplist::*}
		loop {_sh::*}:
			if {-team::%uuid of loop-value%} is not set:
				set {-team::%uuid of loop-value%} to gPickTeam({_n})
	# 팀 키 목록/표시 이름/스코어
	delete {-gteamlist::*}
	delete {-gscore::*}
	delete {-gname::*}
	if {_n} is 0:
		loop {-gplist::*}:
			set {_k} to "p_%uuid of loop-value%"
			add {_k} to {-gteamlist::*}
			set {-gname::%{_k}%} to name of loop-value
	else:
		delete {_tl::*}
		delete {_seen::*}
		loop {-gplist::*}:
			set {_t} to "%{-team::%uuid of loop-value%}%"
			if {_seen::%{_t}%} is not set:
				set {_seen::%{_t}%} to true
				add {_t} to {_tl::*}
		set {-gteamlist::*} to sorted {_tl::*}
		loop {-gteamlist::*}:
			set {-gname::%loop-value%} to loop-value
	loop {-gteamlist::*}:
		set {-gscore::%loop-value%} to 0
	# 참가자의 팀/이름 기록(나간 사람도 결과창에 나오게)
	delete {-gpteam::*}
	delete {-gpname::*}
	loop {-gplist::*}:
		set {-gpteam::%uuid of loop-value%} to gTeamOf(loop-value)
		set {-gpname::%uuid of loop-value%} to name of loop-value
	# 전적 초기화
	delete {-gk::*}
	delete {-gd::*}
	delete {-ga::*}
	delete {-gdmg::*}
	delete {-gstar::*}
	delete {-gdead::*}
	delete {-glastdmg::*}
	loop {-gplist::*}:
		set {_id} to "%uuid of loop-value%"
		set {-gk::%{_id}%} to 0
		set {-gd::%{_id}%} to 0
		set {-ga::%{_id}%} to 0
		set {-gdmg::%{_id}%} to 0
		set {-gstar::%{_id}%} to gStarBase()
	delete {-groundend}
	delete {-gover}
	set {-ingame} to true
	loop {-gplist::*}:
		gameRespawn(loop-value)
	loop all players:
		send title "&e게임 시작!" with subtitle "&7%gcModeName({-gmode})% · 목표 %{-gtarget}%" to loop-player for 3 seconds with fadein 5 ticks and fade out 10 ticks
		play sound "entity.ender_dragon.growl" with volume 0.6 and pitch 1.2 to loop-player
		send colored "&e%gcModeName({-gmode})% &7게임을 시작했습니다. (목표 %{-gtarget}%)" to loop-player

# 연출 없이 게임을 정리한다(관리자 강제 종료, 연출이 끝난 뒤 로비로 돌아갈 때).
function gameCleanup():
	set {-ingame} to false
	delete {-gover}
	delete {-groundend}
	delete {-gpteam::*}
	delete {-gpname::*}
	loop {-gplist::*}:
		gStarRemove("%uuid of loop-value%")
		delete {-gdead::%uuid of loop-value%}
		set {_pl} to loop-value
		if {_pl} is online:
			kcClearState({_pl})
			set gamemode of {_pl} to adventure
			{_pl}.clearTitle()
	set {_empty} to GsonComponentSerializer.gson().deserialize("{""text"":""""}")
	loop all players:
		set {_pl2} to loop-player
		{_pl2}.setPlayerListOrder(0)
		tabUpdate({_pl2})
		{_pl2}.sendPlayerListHeaderAndFooter({_empty}, {_empty})

# 관리자 강제 종료(연출/결과 발표 없음). by(실행한 관리자 이름)는 메시지에 쓰지 않는다.
function gameForceStop(by: text):
	if {-ingame} is not true:
		if {-gfinale} is not true:
			stop
	gameCleanup()
	gfAbort()
	loop all players:
		send "&7게임을 강제로 종료했습니다." to loop-player

# ===== 전적 =====
# 피해 기록: 적에게 준 피해(실 체력)를 누적하고 어시스트 판정용 시각을 남긴다. 본인/아군에게 준 피해는 세지 않는다.
function gameDamageRecord(v: player, a: entity, d: number):
	if {-ingame} is not true:
		stop
	if {-gover} is true:
		stop
	if {_a} is not a player:
		stop
	if {_a} is {_v}:
		stop
	if isAlly("%uuid of {_a}%", "%uuid of {_v}%") is true:
		stop
	if {_d} <= 0:
		stop
	add {_d} to {-gdmg::%uuid of {_a}%}
	set {-glastdmg::%uuid of {_v}%::%uuid of {_a}%} to now

# 치명타가 아닌 피해(치명타는 killcine.sk 가 취소하고 gameDamageRecord 를 직접 부른다)
on damage with priority monitor:
	if {-ingame} is not true:
		stop
	if event is cancelled:
		stop
	if victim is not a player:
		stop
	if attacker is not a player:
		stop
	set {_ev} to event
	gameDamageRecord(victim, attacker, {_ev}.getFinalDamage())

# 킬 처리. v 가 죽었고 a 가 공격자(없으면 v 본인)다. killcine.sk 의 killScoreHook 가 부른다.
function gameOnKill(v: player, a: entity):
	if {-ingame} is not true:
		stop
	if {-gover} is true:
		stop
	if gInGame({_v}) is false:
		stop
	set {_vid} to "%uuid of {_v}%"
	add 1 to {-gd::%{_vid}%}
	# 킬 인정: 플레이어가 다른 팀 플레이어를 처치(자살/아군 처치/환경은 킬 없음)
	set {_kill} to false
	if {_a} is a player:
		if {_a} is not {_v}:
			if isAlly("%uuid of {_a}%", {_vid}) is false:
				set {_kill} to true
	set {_aid} to "%uuid of {_a}%"
	if {_kill} is true:
		add 1 to {-gk::%{_aid}%}
		# 어시스트: 최근 gAssistSec() 초 안에 피해를 준 다른 사람
		loop {-glastdmg::%{_vid}%::*}:
			set {_oid} to loop-index
			if {_oid} is not {_aid}:
				set {_t} to {-glastdmg::%{_vid}%::%{_oid}%}
				set {_age} to now - {_t}
				set {_agems} to {_age}.getMilliSeconds()
				if {_agems} <= gAssistSec() * 1000:
					add 1 to {-ga::%{_oid}%}
	delete {-glastdmg::%{_vid}%::*}
	if {-gmode} is "bounty":
		gBountyKill({_v}, {_a}, {_kill})
	else if {-gmode} is "annihilation":
		set {-gdead::%{_vid}%} to true
		gAnnCheck()

# ===== 바운티 =====
# 죽은 사람의 별만큼 킬한 팀 스코어가 오르고, 킬한 사람의 별(현상금)이 1개 늘어난다. 죽은 사람의 별은 기본으로 돌아간다.
function gBountyKill(v: player, a: entity, kill: boolean):
	set {_vid} to "%uuid of {_v}%"
	set {_stars} to {-gstar::%{_vid}%}
	if {_stars} is not a number:
		set {_stars} to gStarBase()
	set {-gstar::%{_vid}%} to gStarBase()
	if {_kill} is false:
		stop
	set {_ap} to {_a}
	set {_aid} to "%uuid of {_a}%"
	set {_tk} to gTeamOf({_ap})
	add {_stars} to {-gscore::%{_tk}%}
	set {_cur} to {-gstar::%{_aid}%}
	if {_cur} is not a number:
		set {_cur} to gStarBase()
	set {-gstar::%{_aid}%} to {_cur} + 1
	gStarSync({_ap})
	loop all players:
		send colored "&6[바운티] &f%name of {_a}% &7님이 &f%name of {_v}% &7님을 처치했습니다! &e+%{_stars}%점 &7(%gTeamLabel({_tk})% &f%{-gscore::%{_tk}%}%&7/%{-gtarget}%)" to loop-player
	if {-gscore::%{_tk}%} >= {-gtarget}:
		gameWin({_tk})

# ===== 섬멸전 =====
# 살아 있는 팀이 1개 이하면 라운드 종료. 마지막 한 팀이 승점 1점, 전원 사망이면 무승부.
function gAnnCheck():
	if {-ingame} is not true:
		stop
	if {-gmode} is not "annihilation":
		stop
	if {-groundend} is true:
		stop
	delete {_alive::*}
	loop {-gplist::*}:
		if gAlive(loop-value) is true:
			set {_alive::%gTeamOf(loop-value)%} to true
	if size of {_alive::*} > 1:
		stop
	set {-groundend} to true
	set {_w} to ""
	loop {_alive::*}:
		set {_w} to loop-index
	gRoundEnd({_w})

function gRoundEnd(w: text):
	if {_w} is "":
		loop all players:
			send "&6[섬멸전] &7전원 사망! 이번 라운드는 무승부입니다." to loop-player
	else:
		add 1 to {-gscore::%{_w}%}
		loop all players:
			send colored "&6[섬멸전] %gTeamLabel({_w})% &7(이)가 라운드에서 승리했습니다! &e승점 %{-gscore::%{_w}%}%&7/%{-gtarget}%" to loop-player
			play sound "entity.player.levelup" with volume 0.7 and pitch 1 to loop-player
		if {-gscore::%{_w}%} >= {-gtarget}:
			gameWin({_w})
			stop
	# 킬 연출 중이면 killcine.sk 가 라운드 종료 연출(전원 관람 -> 승리자 클로즈업 -> 타이틀)을 한 뒤 gRoundNext() 를 부른다.
	set {-groundwin} to {_w}
	if size of {-kc::*} > 0:
		stop
	# 킬 연출이 없는 라운드 종료(접속 종료 등)는 잠깐 뒤에 바로 다음 라운드
	wait 5 seconds
	gRoundNext()

# 다음 라운드 시작: 모두 부활시키고 시작 타이틀. 강제 종료/게임 종료로 상태가 바뀌었으면 아무것도 안 한다.
function gRoundNext():
	if {-ingame} is not true:
		stop
	if {-gover} is true:
		stop
	delete {-groundwin}
	loop {-gplist::*}:
		if loop-value is online:
			gameRespawn(loop-value)
	delete {-groundend}
	loop all players:
		send title "&e라운드 시작!" with subtitle "&7%gcModeName({-gmode})%" to loop-player for 2 seconds with fadein 0 ticks and fade out 10 ticks
		play sound "block.note_block.pling" with volume 0.7 and pitch 1.5 to loop-player

# 연출 중에 부활을 막을지(섬멸전에서 죽은 사람은 라운드가 끝날 때까지 관전). killcine.sk 의 리스폰 단계가 부른다.
function gKeepDead(v: player) :: boolean:
	if {-ingame} is not true:
		return false
	if {-gmode} is not "annihilation":
		return false
	if {-gdead::%uuid of {_v}%} is set:
		return true
	return false

# ===== 승리 =====
# 한 팀이 목표를 채웠다. 종료 연출은 gameend.sk(gameFinale).
function gameWin(key: text):
	if {-gover} is true:
		stop
	set {-gover} to true
	set {-gwinner} to {_key}
	# 킬 연출이 진행 중이면(killcine.sk 가 {-kc} 를 켜 둠) 그 연출을 모두가 본 뒤 killcine.sk 가 gameFinale() 을 부른다.
	# 킬 연출 없이 승리가 정해진 경우(접속 종료로 섬멸전이 끝남 등)는 바로 종료 연출(gameend.sk)을 시작한다.
	if size of {-kc::*} is 0:
		gameFinale()

# 게임 중 관전 상태(죽은 사람, 종료 연출 중)인 참가자는 제자리에서 못 움직이게 한다. 시선 회전은 허용.
# 카메라를 따라가는 관전(setSpectatorTarget)은 건드리지 않는다. 미검증: 관전자의 PlayerMoveEvent 취소가 서버에서 제자리로 되돌리는지.
on PlayerMoveEvent:
	if {-ingame} is not true:
		stop
	set {_p} to event.getPlayer()
	if gamemode of {_p} is not spectator:
		stop
	if {-gplist::*} does not contain {_p}:
		stop
	if {_p}.getSpectatorTarget() is set:
		stop
	set {_f} to event.getFrom()
	set {_t} to event.getTo()
	if distance between {_f} and {_t} > 0.0001:
		event.setCancelled(true)

on quit:
	if {-ingame} is true:
		if {-gplist::*} contains player:
			gStarRemove("%uuid of player%")
			set {-gdead::%uuid of player%} to true
			gAnnCheck()

# 스크립트를 다시 불러오면 진행 중이던 게임은 끝난 것으로 본다(타이머가 사라져서). 남은 별 표시도 지운다.
on load:
	delete {-ingame}
	delete {-gover}
	delete {-groundend}
	loop all text displays:
		set {_e} to loop-entity
		if {_e} has scoreboard tag "gstar":
			delete entity within {_e}
	delete {-gstar_d::*}
