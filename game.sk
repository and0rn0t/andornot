# [game.sk] 게임 진행: 시작/종료, 팀 배정, 전적(K/D/A/가한 피해), 바운티(별/현상금 스코어), 녹아웃(목숨 1개, 라운드 승점), 승리 판정.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 리스폰 위치: 아래 "리스폰 위치" 절 참고(월드별 리스폰 지점 + 바운티는 팀원 근처 50칸).
# 이 파일이 쓰는 변수(RAM 전용):
#   {-ingame}          게임 진행 중(true). items.sk 가 읽어서 무기고를 치운다.
#   {-gover}           승패가 난 뒤(종연출 중)면 true. 새 킬/점수를 더 받지 않는다.
#   {-gmode}           이번 게임모드 id(bounty/annihilation/crown, 시작 때 gcMode() 를 복사. 맵/모드 투표(vote.sk)가 뽑은 {-gvmode} 가 있으면 그걸 쓴다)
#   {-gtarget}         이번 게임의 목표 스코어(바운티)/목표 승점(녹아웃, 시작 때 복사)
#   {-gteams}          이번 게임의 팀 수(0 = 개인전)
#   {-gplist::*}       이번 게임 참가자(시작 때 접속해 있던 플레이어, 순서 유지)
#   {-gteamlist::*}    팀 키 목록(정렬됨). 팀전은 {-team} 의 팀 이름("1팀"), 개인전은 "p_플레이어uuid"
#   {-gname::팀키}      팀 이름(팀전은 {-team} 의 팀 이름, 개인전은 플레이어 이름). 화면에는 gTeamName() 이 만든 색 약자 3글자(RED, BLU ...)로 표시한다.
#   {-gpteam::uuid} {-gpname::uuid}   시작 때 기록한 참가자의 팀 키/이름(중간에 나가도 결과창에 남기려고)
#   {-gscore::팀키}     팀 스코어(바운티)/승점(녹아웃)
#   {-gk::uuid} {-gd::uuid} {-ga::uuid} {-gdmg::uuid}   킬/데스/어시스트/가한 피해(실 체력, 적에게 준 것만)
#   {-gbstart}         바운티 시작 시각(제한시간 gBountyLimit() 기준, gStartFinish 가 켜고 gameCleanup 이 지움)
#   {-gcrown} {-gcwait} {-gcrown_d::uuid} {-gcglow::uuid}   크라운 모드: 소지자 uuid / 첫 지급까지 남은 초 / 머리 위 ♛ 표시 / 발광을 켠 사람(아래 "크라운" 절)
#   {-gstar::uuid}     바운티 별 개수(기본 gStarBase())
#   {-gstar_d::uuid}   머리 위 별 표시(텍스트 디스플레이)
#   {-gdead::uuid}     녹아웃에서 이번 라운드에 죽은 플레이어
#   {-groundend}       녹아웃에서 라운드가 끝나는 중(true)
#   {-grnum}           녹아웃 현재 라운드 번호(게임 시작 때 1, gRoundNext 가 라운드를 시작할 때마다 +1, "n라운드" 타이틀에 씀)
#   {-groundwin}       이번 라운드 승리 팀 키(무승부는 ""). killcine.sk 의 라운드 종료 연출이 읽는다.
#   {-glastdmg::피격자uuid::공격자uuid}   마지막으로 피해를 준 시각(어시스트 판정용)
# 킬 처리 연결: killcine.sk 의 killScoreHook() 가 gameOnKill() 을 부르고, 치명타 피해량은 gameDamageRecord() 로 넘긴다. 치명타가 아닌 피해는 아래 on damage 가 센다.
import:
	java.lang.Math
	org.bukkit.Bukkit
	org.bukkit.ChatColor
	net.kyori.adventure.text.serializer.gson.GsonComponentSerializer
	org.bukkit.event.player.PlayerMoveEvent
	org.bukkit.event.player.PlayerTeleportEvent
	com.destroystokyo.paper.event.player.PlayerStopSpectatingEntityEvent

# 미검증: attacker 가 투사체/커스텀 피해 출처의 주인으로 잡히는지, shuffled/sorted 문법, text display 승차(statustag.sk 와 같은 방식).

# ===== 기본값/조회 =====
function gStarBase() :: number:
	return 2

# 바운티 제한시간(분). 시간이 다 되면 스코어가 가장 높은 팀이 승리(동점이면 팀 킬 합계, 그래도 같으면 무작위)
function gBountyLimit() :: number:
	return 8

# 어시스트로 인정하는 시간(이 시간 안에 피해를 줬어야 함)
function gAssistSec() :: number:
	return 10

# 낙사/허공/용암 등 공격자 없는 죽음에서, 이 시간(초) 안에 피해를 준 적이 있으면 그 사람이 킬을 가져간다.
function gFallCreditSec() :: number:
	return 10

function gTeamColor(i: number) :: text:
	set {_c::*} to "&c", "&9", "&a", "&e", "&d", "&b", "&6", "&5"
	return {_c::%mod({_i} - 1, 8) + 1%}

# 플레이어의 팀 키. 개인전이면 자기 자신만의 키, 팀전이면 {-team} 값(없으면 "").
function gTeamOf(p: player) :: text:
	if {-gteams} is 0:
		return "p_%uuid of {_p}%"
	set {_t} to {-team::%uuid of {_p}%}
	if {_t} is not set:
		return ""
	return "%{_t}%"

function gTeamIndex(key: text) :: number:
	loop {-gteamlist::*}:
		if loop-value is {_key}:
			return loop-index parsed as number
	return 99

# 팀 색 약자 3글자(gTeamColor 와 같은 순서: 빨강 파랑 초록 노랑 분홍 하늘 주황 보라)
function gTeamAbbr(i: number) :: text:
	set {_a::*} to "RED", "BLU", "GRN", "YEL", "PNK", "CYN", "ORG", "PUR"
	return {_a::%mod({_i} - 1, 8) + 1%}

# 팀 표시 이름(색 코드 없음): 팀전은 색 약자 3글자, 개인전은 플레이어 이름
function gTeamName(key: text) :: text:
	if {-gteams} > 0:
		return gTeamAbbr(gTeamIndex({_key}))
	return "%{-gname::%{_key}%}%"

# 색 코드가 붙은 팀 표시 이름
function gTeamLabel(key: text) :: text:
	return "%gTeamColor(gTeamIndex({_key}))%%gTeamName({_key})%&r"

function gInGame(p: player) :: boolean:
	if {-ingame} is not true:
		return false
	if {-gplist::*} contains {_p}:
		return true
	return false

# 살아 있는 참가자(접속 중이고 녹아웃에서 죽지 않음)
function gAlive(p: player) :: boolean:
	if {_p} is not online:
		return false
	if {-gdead::%uuid of {_p}%} is set:
		return false
	return true

function gTeamCount(name: text) :: number:
	set {_c} to 0
	loop {-gplist::*}:
		if {-team::%uuid of loop-value%} is {_name}:
			add 1 to {_c}
	return {_c}

# 인원이 가장 적은 팀 이름(1팀~n팀 중)
function gPickTeam(n: number) :: text:
	set {_best} to "1팀"
	set {_bc} to gTeamCount("1팀")
	set {_i} to 2
	while {_i} <= {_n}:
		set {_c} to gTeamCount("%{_i}%팀")
		if {_c} < {_bc}:
			set {_bc} to {_c}
			set {_best} to "%{_i}%팀"
		add 1 to {_i}
	return {_best}

# ===== 팀 구성 / 내부 승점 =====
# 내부 승점 {rating::uuid}(저장 변수, 기본 100)와 치른 경기 수 {rating::games::uuid}. 일반 플레이어에게는 보여주지 않는다(/rating 명령은 없앴다).
function ratingOf(id: text) :: number:
	if {rating::%{_id}%} is a number:
		return {rating::%{_id}%}
	return 90

# 팀 구성. mode "random": 섞어서 돌아가며 배정. mode "mmr"(매튜 렁): 승점 높은 순(동점은 섞음)으로 보면서,
# 인원 상한(올림(인원/팀수))이 안 찬 팀 중 현재 승점 합이 가장 낮은 팀에 넣는다(미검증 알고리즘: 탐욕법이라 최적은 아닐 수 있음).
# ids = 참가자 uuid 텍스트 목록(플레이어 대신 id 를 받는다).
function gBuildTeams(ids: texts, n: number, mode: text):
	set {_sh::*} to shuffled {_ids::*}
	set {_cnt} to size of {_sh::*}
	if {_mode} is "random":
		set {_i} to 0
		while {_i} < {_cnt}:
			add 1 to {_i}
			set {-team::%{_sh::%{_i}%}%} to "%mod({_i} - 1, {_n}) + 1%팀"
		stop
	set {_cap} to ceil({_cnt} / {_n})
	# 승점 높은 순 정렬(선택 정렬)
	set {_a} to 1
	while {_a} <= {_cnt}:
		set {_best} to {_a}
		set {_b} to {_a} + 1
		while {_b} <= {_cnt}:
			set {_rb} to ratingOf({_sh::%{_b}%})
			set {_rbest} to ratingOf({_sh::%{_best}%})
			if {_rb} > {_rbest}:
				set {_best} to {_b}
			add 1 to {_b}
		set {_tmp} to {_sh::%{_a}%}
		set {_sh::%{_a}%} to {_sh::%{_best}%}
		set {_sh::%{_best}%} to {_tmp}
		add 1 to {_a}
	set {_t} to 1
	while {_t} <= {_n}:
		set {_sum::%{_t}%} to 0
		set {_num::%{_t}%} to 0
		add 1 to {_t}
	set {_a} to 1
	while {_a} <= {_cnt}:
		set {_pid} to {_sh::%{_a}%}
		set {_pick} to 0
		set {_t} to 1
		while {_t} <= {_n}:
			if {_num::%{_t}%} < {_cap}:
				if {_pick} is 0:
					set {_pick} to {_t}
				else if {_sum::%{_t}%} < {_sum::%{_pick}%}:
					set {_pick} to {_t}
			add 1 to {_t}
		set {-team::%{_pid}%} to "%{_pick}%팀"
		add ratingOf({_pid}) to {_sum::%{_pick}%}
		add 1 to {_num::%{_pick}%}
		add 1 to {_a}

# 중간 참가자를 넣을 팀: 인원이 가장 적은 팀(최우선) 중, 넣었을 때 팀 간 승점 합 격차(최대-최소)가 가장 작아지는 팀(차선). 접속 중인 참가자만 센다.
# pid = 들어오는 사람의 uuid 텍스트, ids = 지금 접속 중인 다른 참가자들의 uuid 텍스트(id 를 받는다).
function gJoinTeam(pid: text, ids: texts) :: text:
	set {_t} to 0
	while {_t} < {-gteams}:
		add 1 to {_t}
		set {_num::%{_t}%} to 0
		set {_sum::%{_t}%} to 0
	loop {_ids::*}:
		set {_q} to loop-value
		set {_tk} to "%{-team::%{_q}%}%"
		replace "팀" in {_tk} with ""
		set {_ti} to {_tk} parsed as number
		if {_num::%{_ti}%} is set:
			add 1 to {_num::%{_ti}%}
			set {_rq} to ratingOf({_q})
			add {_rq} to {_sum::%{_ti}%}
	set {_min} to 9999
	set {_t} to 1
	while {_t} <= {-gteams}:
		if {_num::%{_t}%} < {_min}:
			set {_min} to {_num::%{_t}%}
		add 1 to {_t}
	set {_r} to ratingOf({_pid})
	set {_best} to 0
	set {_bs} to 999999
	set {_t} to 1
	while {_t} <= {-gteams}:
		if {_num::%{_t}%} is {_min}:
			set {_mx} to -999999
			set {_mn} to 999999
			set {_u} to 1
			while {_u} <= {-gteams}:
				set {_v} to {_sum::%{_u}%}
				if {_u} is {_t}:
					add {_r} to {_v}
				if {_v} > {_mx}:
					set {_mx} to {_v}
				if {_v} < {_mn}:
					set {_mn} to {_v}
				add 1 to {_u}
			set {_spread} to {_mx} - {_mn}
			if {_spread} < {_bs}:
				set {_bs} to {_spread}
				set {_best} to {_t}
		add 1 to {_t}
	return "%{_best}%팀"

# 중간 참가: 게임 중인 월드에서 관전 중인 사람이 /참가 를 입력하면 팀(팀전)이나 새 개인(개인전)으로 들어간다. 녹아웃은 진행 중인 라운드가 끝날 때까지 관전, 바운티는 바로 투입.
function gJoinMid(p: player):
	set {_id} to "%uuid of {_p}%"
	if {-gteams} > 0:
		delete {_oids::*}
		loop {-gplist::*}:
			set {_q} to loop-value
			if {_q} is online:
				if {_q} is not {_p}:
					add "%uuid of {_q}%" to {_oids::*}
		set {-team::%{_id}%} to gJoinTeam({_id}, {_oids::*})
	set {_k} to gTeamOf({_p})
	set {-gpteam::%{_id}%} to {_k}
	set {-gpname::%{_id}%} to {_p}.getName()
	if {-gscore::%{_k}%} is not set:
		set {-gscore::%{_k}%} to 0
		add {_k} to {-gteamlist::*}
		set {-gname::%{_k}%} to {_p}.getName()
		if {-gteams} > 0:
			set {_sorted::*} to sorted {-gteamlist::*}
			set {-gteamlist::*} to {_sorted::*}
	if {-gplist::*} does not contain {_p}:
		add {_p} to {-gplist::*}
	set {-gk::%{_id}%} to 0
	set {-gd::%{_id}%} to 0
	set {-ga::%{_id}%} to 0
	set {-gdmg::%{_id}%} to 0
	set {-gstar::%{_id}%} to gStarBase()
	delete {-gdead::%{_id}%}
	delete {-glastdmg::%{_id}%::*}
	{_p}.getInventory().clear()
	if {-grandon} is true:
		gRollLoadout({_p})
		loadoutClearAll({_p})
	loop all players:
		send colored "&b[중간 참가] &f%name of {_p}% &7님이 %gTeamLabel({_k})% &7에 참가했습니다." to loop-player
	if {-gmode} is "annihilation":
		if {-groundend} is not true:
			set {-gdead::%{_id}%} to true
			send "&7이번 라운드가 끝나면 전투에 참가합니다." to {_p}
			stop
	gameRespawn({_p})

command /참가:
	description: 진행 중인 게임에 중간 참가해요
	aliases: joingame
	executable by: players
	trigger:
		if {-ingame} is not true:
			send "&c진행 중인 게임이 없습니다."
			stop
		if {-gover} is true:
			send "&c게임이 끝나가는 중이라 참가할 수 없습니다."
			stop
		if {-gfinale} is true:
			send "&c게임이 끝나가는 중이라 참가할 수 없습니다."
			stop
		if {-gplist::*} contains player:
			send "&c이미 참가 중입니다."
			stop
		if {-gwatch::%uuid of player%} is set:
			send "&c이번 게임은 관전으로 정해서 중간 참가할 수 없습니다."
			stop
		gJoinMid(player)

# 접속: 게임이 진행 중이 아니면 로비로, 진행 중이면 게임 월드에서 관전 상태로 보낸다. 이미 참가자였던 사람(재접속)은 바운티면 바로 복귀, 녹아웃이면 다음 라운드까지 관전.
on join:
	wait 1 tick
	if player is not online:
		stop
	set {_playing} to false
	if {-ingame} is true:
		if {-gover} is not true:
			if {-gfinale} is not true:
				set {_playing} to true
	if {_playing} is false:
		set gamemode of player to adventure
		gameLobby(player)
		stop
	set {_gw} to gcWorld("%{-gworld}%")
	if {_gw} is not set:
		stop
	if {-gplist::*} contains player:
		delete {-gdead::%uuid of player%}
		if {-gmode} is "annihilation":
			if {-groundend} is not true:
				set {-gdead::%uuid of player%} to true
				set gamemode of player to spectator
				send "&7이번 라운드가 끝나면 전투에 참가합니다." to player
				stop
		gameRespawn(player)
		stop
	set gamemode of player to spectator
	tpSafe(player, {_gw}.getSpawnLocation())
	if {-gwatch::%uuid of player%} is set:
		send "&7이번 게임은 관전으로 정해서 구경만 할 수 있어요."
		stop
	send "&b게임이 진행 중입니다. &7중간 참가는 &b/참가 &7를 입력하세요. (인원이 적은 팀, 승점 균형 순으로 배치됩니다)" to player

# 게임 시작 때 팀 구성을 모두에게 알린다(내부 승점은 알리지 않는다).
function gAnnounceTeams():
	if {-gteams} < 1:
		stop
	set {_tl::*} to {-gteamlist::*}
	set {_ti} to 0
	while {_ti} < size of {_tl::*}:
		add 1 to {_ti}
		set {_k} to {_tl::%{_ti}%}
		set {_names::*} to ""
		delete {_names::*}
		loop {-gplist::*}:
			set {_pl} to loop-value
			set {_tk} to gTeamOf({_pl})
			if {_tk} is {_k}:
				add name of {_pl} to {_names::*}
		set {_line} to "%{_names::*}%"
		loop all players:
			send colored "%gTeamLabel({_k})% &7: &f%{_line}%" to loop-player

# 게임이 자연스럽게 끝났을 때 내부 승점을 갱신한다. 순위는 팀 점수({-gscore}, 승리 팀이 1위가 되게 소폭 가산).
# 변동 = 5 x (중간순위 - 내 순위) / ((팀수-1)/2). 2팀이면 승 +5/패 -5, 3팀이면 +5/0/-5. 동점은 순위를 평균. 첫 10경기는 2배. POTM 은 얻는 승점 2배.
function ratingApply():
	set {_n} to size of {-gteamlist::*}
	if {_n} < 2:
		stop
	# Player Of The Match(승리 팀 기여도 1위)를 먼저 정해 둔다(gameend.sk gfPotmPick, 알림 없이 승점에만 반영)
	gfPotmPick()
	set {_i} to 0
	while {_i} < {_n}:
		add 1 to {_i}
		set {_k::%{_i}%} to {-gteamlist::%{_i}%}
		set {_s::%{_i}%} to {-gscore::%{_k::%{_i}%}%}
		if {_k::%{_i}%} is {-gwinner}:
			add 0.001 to {_s::%{_i}%}
	set {_mid} to ({_n} + 1) / 2
	set {_i} to 1
	while {_i} <= {_n}:
		set {_gt} to 0
		set {_eq} to 0
		set {_j} to 1
		while {_j} <= {_n}:
			if {_j} is not {_i}:
				if {_s::%{_j}%} > {_s::%{_i}%}:
					add 1 to {_gt}
				else if {_s::%{_j}%} is {_s::%{_i}%}:
					add 1 to {_eq}
			add 1 to {_j}
		set {_rank} to 1 + {_gt} + {_eq} / 2
		set {_d::%{_k::%{_i}%}%} to 5 * ({_mid} - {_rank}) / (({_n} - 1) / 2)
		add 1 to {_i}
	loop {-gpteam::*}:
		set {_id} to loop-index
		set {_tk} to "%loop-value%"
		set {_delta} to {_d::%{_tk}%}
		set {_g} to 0
		if {rating::games::%{_id}%} is a number:
			set {_g} to {rating::games::%{_id}%}
		if {_g} < 10:
			set {_delta} to {_delta} * 2
		# POTM 은 얻는 승점이 2배(잃는 경우는 그대로, 알림 없음)
		if {-gpotmid} is set:
			if {_id} is "%{-gpotmid}%":
				if {_delta} > 0:
					set {_delta} to {_delta} * 2
		set {_old} to ratingOf({_id})
		set {_new} to round(({_old} + {_delta}) * 100) / 100
		# 승점은 0 아래로 내려가지 않는다
		if {_new} < 0:
			set {_new} to 0
		set {rating::%{_id}%} to {_new}
		# 승점이 바뀐 시각(티어 순위 동점 처리용, tier.sk). 안 바뀌었으면 기존 시각 유지, 없으면 지금.
		if {_new} is not {_old}:
			set {ratingsince::%{_id}%} to tierNowMs()
		else if {ratingsince::%{_id}%} is not a number:
			set {ratingsince::%{_id}%} to tierNowMs()
		set {rating::games::%{_id}%} to {_g} + 1

# ===== 리스폰 위치 =====
# 관리자 메뉴 "리스폰 위치 지정"으로 월드마다 리스폰 지점을 저장한다(gcLoadLoc(gcRespawnKey(월드 이름))). 게임을 시작할 때와 녹아웃 라운드 시작 때 모두 그 지점의 X/Z 로 간다(팀 구분 없이 같은 지점 주변 반경 10칸에 한 명씩 무작위로 흩뿌린다).
# 지점이 없는 월드는 예전처럼 동작한다(시작 때 제자리, 리스폰은 월드 스폰).
# 리스폰은 실제로는 그 지점의 Y 높이에서 시작해 겉날개로 활강한다(아래 "상공 낙하" 절). 바운티: 죽은 뒤 리스폰은 살아 있는 같은 월드 팀원 근처 50칸 안의 무작위 위치(팀원이 없으면 리스폰 지점). 게임 중이 아니거나 모드가 없으면 로비로 리스폰한다(kcRespawnLoc).
# 팀원 근처 무작위 위치: 그 자리의 가장 높은 블럭 위, 물/용암이 아닌 곳, 팀원과 높이 차이 12칸 이내. 20번 안에 못 찾으면 팀원 위치를 쓴다.
# 미검증: World#getHighestBlockYAt(x, z), Block#getType().name() 문자열 비교.
function gcRespawnKey(wn: text) :: text:
	return "respawn_%{_wn}%"

# center 기준 반경 r 칸 안의 무작위 안전 위치. ytol 이 0 이상이면 center 높이와 그 이내로 차이 나는 곳만 쓴다(음수면 높이 제한 없음).
function gRandomSpot(center: location, r: number, ytol: number) :: location:
	set {_w} to {_center}.getWorld()
	set {_cy} to {_center}.getY()
	loop 20 times:
		set {_ang} to random number between 0 and 360
		set {_dist} to sqrt(random number between 0 and 1) * {_r}
		set {_x} to floor({_center}.getX() + cos({_ang}) * {_dist})
		set {_z} to floor({_center}.getZ() + sin({_ang}) * {_dist})
		set {_y} to {_w}.getHighestBlockYAt({_x}, {_z})
		set {_blk} to {_w}.getBlockAt({_x}, {_y}, {_z})
		set {_bt} to {_blk}.getType()
		set {_tn} to {_bt}.name()
		set {_bad} to false
		if {_tn}.contains("WATER"):
			set {_bad} to true
		if {_tn}.contains("LAVA"):
			set {_bad} to true
		if {_ytol} >= 0:
			if abs({_y} + 1 - {_cy}) > {_ytol}:
				set {_bad} to true
		if {_bad} is false:
			set {_l} to new Location({_w}, {_x} + 0.5, {_y} + 1, {_z} + 0.5)
			{_l}.setYaw({_center}.getYaw())
			return {_l}
	return {_center}.clone()

# 리스폰 지점(관리자가 저장한 그 위치, 모든 팀 공통). 지점이 없는 월드면 값 없음. tk 는 예전 호출 형태를 맞추려고 받기만 한다.
function gInitSpawn(tk: text) :: location:
	set {_base} to gcLoadLoc(gcRespawnKey("%{-gworld}%"))
	if {_base} is not set:
		return {_none}
	return {_base}

# 바운티 리스폰 위치: 같은 월드의 살아 있는 팀원 근처 50칸 안. 팀원이 없으면 리스폰 지점, 그것도 없으면 값 없음.
function gTeamSpot(v: player) :: location:
	set {_tk} to gTeamOf({_v})
	set {_vw} to {_v}.getWorld()
	set {_vwn} to {_vw}.getName()
	delete {_mates::*}
	if {-gteams} > 0:
		loop {-gplist::*}:
			if loop-value is not {_v}:
				if gAlive(loop-value) is true:
					if gTeamOf(loop-value) is {_tk}:
						set {_mw} to loop-value.getWorld()
						if {_mw}.getName() is {_vwn}:
							add loop-value to {_mates::*}
	if size of {_mates::*} > 0:
		set {_rn} to random integer between 1 and size of {_mates::*}
		set {_m} to {_mates::%{_rn}%}
		set {_ml} to {_m}.getLocation()
		return gRandomSpot({_ml}, 50, 12)
	return gInitSpawn({_tk})

# 게임/라운드가 시작될 때 플레이어를 보낼 곳: 리스폰 지점의 상공(지점이 없으면 제자리). 도착하면 겉날개를 입혀 활강시킨다(gDropStart).
function gameSpawn(p: player):
	if {-ingame} is not true:
		stop
	set {_s} to gInitSpawn(gTeamOf({_p}))
	if {_s} is not set:
		# 리스폰 지점이 없으면 시작 카메라로 가기 전 자리로 되돌린다
		if {-gstartprev::%uuid of {_p}%} is set:
			tpSafe({_p}, {-gstartprev::%uuid of {_p}%})
		stop
	# 지점 주변 반경 10칸에 흩뿌린다(높이는 그대로)
	set {_ang} to random number between 0 and 360
	set {_dist} to sqrt(random number between 0 and 1) * 10
	set {_sc} to {_s}.clone()
	{_sc}.setX({_s}.getX() + cos({_ang}) * {_dist})
	{_sc}.setZ({_s}.getZ() + sin({_ang}) * {_dist})
	tpSafe({_p}, gDropLoc({_sc}))
	gDropStart({_p})

# ===== 상공 낙하(겉날개) =====
# 리스폰/초기 위치는 그 지점의 Y 높이(월드 높이 제한까지, 지점이 없는 월드는 170)에서 시작하고, 겉날개를 입혀 활강시킨다. 땅에 닿으면 겉날개를 벗기고 원래 가슴 방어구를 돌려준다.
# 시작할 때 느린 낙하 1초를 건다(포션 단계는 1이 최소라 세기는 못 낮추고 시간만 줄인다). 낙하 중에는 낙하/벽 충돌 피해만 받지 않는다(착지 때 죽지 않게). 변수(RAM): {-gdropon::uuid}(낙하 중), {-gdropchest::uuid}(원래 가슴 방어구), {-gdropgen::uuid}(낙하 세대, 새 낙하/종료 때 올려서 이전 감시를 끝냄), {-gdropflag::uuid}(kcRespawnLoc 가 상공 위치를 돌려줬다는 표시)
# 미검증: chestplate 설정/삭제, setGliding, isOnGround, 낙하/벽 충돌 피해 원인 이름(FALL, FLY_INTO_WALL, 이벤트의 getCause 로 비교).
function gDropLoc(l: location) :: location:
	set {_w} to {_l}.getWorld()
	set {_top} to {_w}.getMaxHeight() - 2
	# 높이는 관리자가 저장한 리스폰 지점의 Y(없는 월드는 170)
	set {_y} to 170
	set {_wn} to {_w}.getName()
	set {_base} to gcLoadLoc(gcRespawnKey({_wn}))
	if {_base} is set:
		set {_y} to {_base}.getY()
	if {_y} > {_top}:
		set {_y} to {_top}
	set {_r} to {_l}.clone()
	{_r}.setY({_y})
	return {_r}

# 낙하 동안 팀 색 발광: 발광 외곽선 색은 스코어보드 팀 색이라 색별 팀(dropc1~8)에 잠깐 넣는다(토템/불길한 병과 같은 방식). 끝나면 원래 팀으로 되돌린다.
function gDropColorName(i: number) :: text:
	set {_c::*} to "RED", "BLUE", "GREEN", "YELLOW", "LIGHT_PURPLE", "AQUA", "GOLD", "DARK_PURPLE"
	return {_c::%mod({_i} - 1, 8) + 1%}

# 발광 색용 스코어보드 팀에 넣을 항목들(플레이어 이름 하나).
# 팀 추가/제거는 항상 이 목록 전체에 한다.
function scEntries(p: player) :: texts:
	add {_p}.getName() to {_r::*}
	return {_r::*}

function scAdd(team: object, p: player):
	set {_en::*} to scEntries({_p})
	loop {_en::*}:
		{_team}.addEntry(loop-value)

function scRemove(team: object, p: player):
	set {_en::*} to scEntries({_p})
	loop {_en::*}:
		{_team}.removeEntry(loop-value)

function gDropGlowOn(p: player):
	set {_id} to "%uuid of {_p}%"
	if {-gdropteam::%{_id}%} is set:
		stop
	set {_ci} to gTeamIndex(gTeamOf({_p}))
	set {_k} to mod({_ci} - 1, 8) + 1
	set {_tn} to "dropc%{_k}%"
	set {_n} to {_p}.getName()
	set {_sb} to Bukkit.getScoreboardManager().getMainScoreboard()
	set {_team} to {_sb}.getTeam({_tn})
	if {_team} is not set:
		set {_team} to {_sb}.registerNewTeam({_tn})
	set {_cn} to gDropColorName({_ci})
	{_team}.setColor(ChatColor.valueOf({_cn}))
	set {_old} to {_sb}.getEntryTeam({_n})
	if {_old} is set:
		set {-gdropold::%{_id}%} to {_old}.getName()
	scAdd({_team}, {_p})
	set {-gdropteam::%{_id}%} to {_tn}
	apply glowing potion of tier 1 without any particles whilst hiding the potion icon to {_p} for 300 seconds replacing the existing effect

function gDropGlowOff(p: player):
	set {_id} to "%uuid of {_p}%"
	if {-gdropteam::%{_id}%} is not set:
		stop
	set {_n} to {_p}.getName()
	set {_sb} to Bukkit.getScoreboardManager().getMainScoreboard()
	set {_team} to {_sb}.getTeam({-gdropteam::%{_id}%})
	if {_team} is set:
		scRemove({_team}, {_p})
	if {-gdropold::%{_id}%} is set:
		set {_ot} to {_sb}.getTeam({-gdropold::%{_id}%})
		if {_ot} is set:
			{_ot}.addEntry({_n})
	delete {-gdropteam::%{_id}%}
	delete {-gdropold::%{_id}%}
	if {_p} is online:
		remove glowing from {_p}

function gDropEnd(p: player):
	set {_id} to "%uuid of {_p}%"
	add 1 to {-gdropgen::%{_id}%}
	gDropGlowOff({_p})
	if {-gdropon::%{_id}%} is true:
		if {_p} is online:
			if {-gdropchest::%{_id}%} is set:
				set chestplate of {_p} to {-gdropchest::%{_id}%}
			else:
				delete chestplate of {_p}
			{_p}.setGliding(false)
	delete {-gdropon::%{_id}%}
	delete {-gdropchest::%{_id}%}

function gDropStart(p: player):
	set {_id} to "%uuid of {_p}%"
	if {-gdropon::%{_id}%} is true:
		# 이미 낙하 중(원래 방어구는 처음 것을 유지)
		add 1 to {-gdropgen::%{_id}%}
	else:
		delete {-gdropchest::%{_id}%}
		if chestplate of {_p} is set:
			set {-gdropchest::%{_id}%} to chestplate of {_p}
		set {-gdropon::%{_id}%} to true
		add 1 to {-gdropgen::%{_id}%}
	set {_gen} to {-gdropgen::%{_id}%}
	set chestplate of {_p} to elytra named "&f낙하용 겉날개"
	{_p}.setGliding(true)
	gDropGlowOn({_p})
	apply slow falling potion of tier 1 without any particles whilst hiding the potion icon to {_p} for 1 seconds replacing the existing effect
	wait 1 second
	set {_t} to 0
	while {_t} < 400:
		if {-gdropgen::%{_id}%} is not {_gen}:
			stop
		if {_p} is not online:
			stop
		if {_p}.isOnGround() is true:
			exit loop
		wait 5 ticks
		add 1 to {_t}
	if {-gdropgen::%{_id}%} is {_gen}:
		gDropEnd({_p})

on damage of player:
	if {-gdropon::%victim's uuid%} is not true:
		stop
	set {_ev} to event
	set {_cause} to {_ev}.getCause()
	set {_cn} to {_cause}.name()
	if {_cn} is "FALL":
		cancel event
	if {_cn} is "FLY_INTO_WALL":
		cancel event

# ===== 머리 위 별(바운티) =====
function gStarText(n: number) :: text:
	if {_n} <= 5:
		set {_s} to "★" repeated {_n} times
		return "&e%{_s}%"
	return "&e★ x%{_n}%"

function gStarRemove(id: text):
	set {_d} to {-gstar_d::%{_id}%}
	if {_d} is set:
		delete entity within {_d}
	delete {-gstar_d::%{_id}%}

# 별 표시를 맞춘다: 바운티 게임 중이고 살아서 움직이는 플레이어에게만 보인다. 체력바(0.6)/상태 이름(0.9) 위 1.2 높이에 태운다.
function gStarSync(p: player):
	set {_id} to "%uuid of {_p}%"
	set {_show} to true
	if {-ingame} is not true:
		set {_show} to false
	if {-gmode} is not "bounty":
		set {_show} to false
	if {-kc::%{_id}%} is set:
		set {_show} to false
	if {_p} is not online:
		set {_show} to false
	else if gamemode of {_p} is spectator:
		set {_show} to false
	if {-invis::%{_id}%} is set:
		if {-invis::%{_id}%} > now:
			set {_show} to false
	if {_show} is false:
		gStarRemove({_id})
		stop
	set {_n} to {-gstar::%{_id}%}
	if {_n} is not a number:
		set {_n} to gStarBase()
	set {_d} to {-gstar_d::%{_id}%}
	set {_new} to false
	if {_d} is not set:
		set {_new} to true
	else if {_d} is dead:
		set {_new} to true
	else if vehicle of {_d} is not {_p}:
		delete entity within {_d}
		set {_new} to true
	if {_new} is true:
		spawn a text display at location of {_p}:
			set {_d} to event-entity
			add "gstar" to scoreboard tags of event-entity
			set billboard of event-entity to center
			set transformation translation of event-entity to vector(0, 1.2, 0)
			add event-entity to passengers of {_p}
		set {-gstar_d::%{_id}%} to {_d}
	set text of {_d} to gStarText({_n})

every second:
	if {-ingame} is true:
		loop {-gplist::*}:
			gStarSync(loop-value)

# ===== 시작/리스폰/종료 =====
# 로비에서 플레이어가 정리해 둔 구성 아이템의 칸(0~35)을 {-gslot::uuid::아이템id} 에 기억한다. 게임 시작 때 인벤토리를 비우기 전에 부르고, 게임 중 loadoutGive(items.sk)가
# 이 칸을 먼저 쓴다(시작/리스폰 때 아이템 순서가 기본 칸 배치로 초기화되지 않게). gameCleanup 이 지운다. 같은 아이템이 여러 칸이면 앞 칸 하나만 기억한다.
function gSlotRemember(p: player):
	delete {-gslot::%{_p}'s uuid%::*}
	loop integers from 0 to 35:
		set {_id} to itemIdAt({_p}, loop-value)
		if {_id} is not "":
			if {-gslot::%{_p}'s uuid%::%{_id}%} is not set:
				set {-gslot::%{_p}'s uuid%::%{_id}%} to loop-value

# 한 명을 시작/라운드 시작 상태로 되돌린다: 상태 정리, 체력/스태미너 회복, 아이템 구성 지급, 어드벤처 모드, 스폰 위치로.
function gameRespawn(p: player):
	set {_id} to "%uuid of {_p}%"
	kcClearState({_p})
	set gamemode of {_p} to adventure
	set {_mh} to {_p}'s max health
	set {_p}'s health to {_mh}
	set {-st::%{_id}%} to 100
	{_p}.clearTitle()
	delete {-gdead::%{_id}%}
	loadoutGive({_p})
	gameSpawn({_p})

# 랜덤 아이템 모드: 카탈로그에서 서로 다른 아이템 5개를 뽑아 이번 게임 구성({-grand::uuid::1~5})으로 정한다(게임 시작 때 한 번. 리스폰해도 같은 구성).
function gRollLoadout(p: player):
	set {_ids::*} to shuffled itemIds()
	loop integers from 1 to 5:
		set {-grand::%{_p}'s uuid%::%loop-value%} to {_ids::%loop-value%}

function gameStart(by: text):
	if {-ingame} is true:
		stop
	if {-gstarting} is true:
		stop
	# 이전 게임의 결과 무대(승리자 더미, 결과 디스플레이)를 치운다
	gfClearStage()
	set {-gmode} to gcMode()
	# 맵/모드 투표(vote.sk)로 뽑힌 모드가 있으면 그걸 쓴다(한 번 쓰면 지움)
	if {-gvmode} is set:
		set {-gmode} to "%{-gvmode}%"
		delete {-gvmode}
	set {-gtarget} to gcTarget({-gmode})
	set {_n} to gcTeams()
	set {-gteams} to {_n}
	delete {-gplist::*}
	delete {-gwatch::*}
	loop all players:
		# 게임 관전을 고른 사람은 참가하지 않고 {-gwatch} 에 올린다(spectate.sk). 시작되면 관전 상태로 구경하고, 이 게임에는 중간 참가도 못 한다.
		if specOn(loop-player) is true:
			set {-gwatch::%uuid of loop-player%} to true
		else:
			add loop-player to {-gplist::*}
	if size of {-gplist::*} < 1:
		delete {-gwatch::*}
		stop
	# 게임이 진행되는 월드 = 시작한 관리자가 있는 월드(없으면 첫 참가자의 월드). 종료 연출은 이 월드의 결과 무대에서 한다.
	# 관리자 메뉴의 맵 설정({gamecfg::map}, 또는 랜덤 모드)이 있으면 그 월드가 게임 월드이고, 다른 월드에 있는 참가자는 그 월드 스폰으로 보낸다(같은 월드면 그대로).
	# 매 게임 랜덤 모드({gamecfg::maprandom})가 켜져 있으면 게임마다 후보 월드(mapCandidates) 중 하나를 새로 뽑는다(선택해 둔 맵 {gamecfg::map} 은 그대로 둔다).
	set {-gworld} to ""
	set {_target} to ""
	# 맵/모드 투표(vote.sk)로 뽑힌 맵이 있으면 그걸 쓴다(한 번 쓰면 지움)
	if {-gvmap} is set:
		set {_target} to "%{-gvmap}%"
		delete {-gvmap}
	if {_target} is "":
		if {gamecfg::maprandom} is true:
			set {_cand::*} to mapCandidates()
			if size of {_cand::*} > 0:
				set {_rn} to random integer between 1 and size of {_cand::*}
				set {_target} to {_cand::%{_rn}%}
	if {_target} is "":
		if {gamecfg::map} is set:
			set {_target} to "%{gamecfg::map}%"
	# 로비/훈련장 월드로 저장돼 있는 맵 선택은 무시한다(mapExcluded)
	if {_target} is not "":
		if mapExcluded({_target}) is true:
			set {_target} to ""
	if {_target} is not "":
		set {_mw} to gcWorld({_target})
		if {_mw} is set:
			set {-gworld} to {_mw}.getName()
			set {_msp} to {_mw}.getSpawnLocation()
			loop {-gplist::*}:
				if loop-value.getWorld().getName() is not {-gworld}:
					tpSafe(loop-value, {_msp})
		else:
			send "[game] 맵 월드를 불러오지 못해 시작한 사람이 있는 월드로 진행합니다: %{_target}%" to console
	if {-gworld} is "":
		loop {-gplist::*}:
			if loop-value.getName() is {_by}:
				set {-gworld} to loop-value.getWorld().getName()
	if {-gworld} is "":
		set {-gworld} to {-gplist::1}.getWorld().getName()
	# 팀 배정: 게임 설정의 팀 구성 방식(gcTeamMode)에 따라 gBuildTeams 가 {-team} 을 새로 채운다(/team 명령은 없앴다).
	loop {-gplist::*}:
		delete {-team::%uuid of loop-value%}
	if {_n} > 0:
		delete {_bids::*}
		loop {-gplist::*}:
			add "%uuid of loop-value%" to {_bids::*}
		gBuildTeams({_bids::*}, {_n}, gcTeamMode())
	# 팀 키 목록/표시 이름/스코어
	delete {-gteamlist::*}
	delete {-gscore::*}
	delete {-gname::*}
	if {_n} is 0:
		loop {-gplist::*}:
			set {_k} to "p_%uuid of loop-value%"
			add {_k} to {-gteamlist::*}
			set {-gname::%{_k}%} to loop-value.getName()
	else:
		delete {_tl::*}
		delete {_seen::*}
		loop {-gplist::*}:
			set {_t} to "%{-team::%uuid of loop-value%}%"
			if {_seen::%{_t}%} is not set:
				set {_seen::%{_t}%} to true
				add {_t} to {_tl::*}
		set {-gteamlist::*} to sorted {_tl::*}
		loop {-gteamlist::*}:
			set {-gname::%loop-value%} to loop-value
	loop {-gteamlist::*}:
		set {-gscore::%loop-value%} to 0
	# 참가자의 팀/이름 기록(나간 사람도 결과창에 나오게)
	delete {-gpteam::*}
	delete {-gpname::*}
	loop {-gplist::*}:
		set {-gpteam::%uuid of loop-value%} to gTeamOf(loop-value)
		set {-gpname::%uuid of loop-value%} to loop-value.getName()
	# 전적 초기화
	delete {-gk::*}
	delete {-gd::*}
	delete {-ga::*}
	delete {-gdmg::*}
	delete {-gstar::*}
	delete {-gdead::*}
	delete {-glastdmg::*}
	loop {-gplist::*}:
		set {_id} to "%uuid of loop-value%"
		set {-gk::%{_id}%} to 0
		set {-gd::%{_id}%} to 0
		set {-ga::%{_id}%} to 0
		set {-gdmg::%{_id}%} to 0
		set {-gstar::%{_id}%} to gStarBase()
	delete {-groundend}
	delete {-gover}
	# 시작 연출(startcine.sk: 시작 카메라 + 음악 -> 팀 더미 라인업 -> 강하 안내, 19초 -> 게임 시작). 끝나는 자리는 gStartFinish.
	set {-gstarting} to true
	add 1 to {-gstartgen}
	gStartIntro({-gstartgen})

# ===== 시작 연출 =====
# 연출 본체는 startcine.sk(gStartIntro)다. 여기에는 시작 카메라 고정 도구(gStartKeep/gStartCamRelease)와 끝맺음(gStartFinish)이 있다.
# (시작 카메라는 관리자 메뉴 "시작 카메라 위치 지정", 없으면 제자리/시점 고정 없음)
# 강제 종료/정리(gameCleanup)가 {-gstartgen} 을 올리면 연출은 다음 틱에 멈춘다. 변수(RAM): {-gstarting}(시작 연출 중), {-gstartgen}(세대), {-gstartprev::uuid}(카메라로 가기 전 위치, 리스폰 위치가 없을 때 되돌려 보낸다).
function gcStartCamKey(wn: text) :: text:
	return "startcam_%{_wn}%"

function gStartAbort(sg: number) :: boolean:
	if {-gstarting} is not true:
		return true
	if {-gstartgen} is not {_sg}:
		return true
	return false

# 시작 카메라 시점 고정: 카메라 엔티티({-gstartcam})를 관전 대상으로 걸어 두면 시점(위치와 방향)을 못 바꾼다. 웅크리기 등으로 풀려도 단계마다 다시 건다.
function gStartKeep():
	if {-gstartcam} is not set:
		stop
	loop {-gplist::*}:
		set {_pl} to loop-value
		if {_pl} is online:
			if gamemode of {_pl} is spectator:
				set {_cur} to {_pl}.getSpectatorTarget()
				if {_cur} is not {-gstartcam}:
					{_pl}.setSpectatorTarget({-gstartcam})

# 관전 대상을 풀었다가 다시 건다. 서버 로드/스크립트 로드 직후 첫 게임에서는 클라이언트가 아직 카메라 엔티티를 몰라서 처음 건 관전 요청이 무시될 수 있는데,
# 서버는 이미 걸려 있다고 알아서 gStartKeep 이 다시 안 건다. 그래서 연출 중 주기적으로 이걸로 강제로 다시 건다.
function gStartKeepForce():
	if {-gstartcam} is not set:
		stop
	loop {-gplist::*}:
		set {_pl} to loop-value
		if {_pl} is online:
			if gamemode of {_pl} is spectator:
				gSpecForce({_pl}, {-gstartcam})

function gStartCamRelease():
	loop {-gplist::*}:
		set {_pl} to loop-value
		if {_pl} is online:
			# 관전 상태가 아닌 사람에게 setSpectatorTarget 을 부르면 "Player must be in spectator mode" 예외가 난다(로딩 중 /gamestop 등)
			if gamemode of {_pl} is spectator:
				{_pl}.setSpectatorTarget(null)
	if {-gstartcam} is set:
		{-gstartcam}.remove()
	delete {-gstartcam}

# gStartIntro(시작 연출 본체)는 startcine.sk 로 옮겼다.

# 시작 연출(19초)이 끝나면 실제 게임 시작: 인벤토리 초기화, 랜덤 아이템, 초기 리스폰 위치(상공 낙하), 시작 타이틀.
function gStartFinish(sg: number):
	delete {-gstarting}
	gStartCamRelease()
	# 보여주기용 더미 치우기(음악은 게임 시작 즈음 알아서 끝난다)
	gsClear()
	# 인벤토리 완전 초기화: 메인 인벤토리, 핫바, 오프핸드, 방어구를 전부 비운다(로비에서 오프핸드 등을 이용해 구성보다 많이 가져온 아이템을 없앤다). 구성 아이템은 아래 gameRespawn -> loadoutGive 가 새로 지급한다.
	# 비우기 전에 구성 아이템 칸을 기억해 둔다(랜덤 아이템 모드는 새로 뽑으므로 기억하지 않음)
	if gcRandom() is not true:
		loop {-gplist::*}:
			gSlotRemember(loop-value)
	loop {-gplist::*}:
		loop-value.getInventory().clear()
	# 게임 설정의 랜덤 아이템 모드(gcRandom): 참가자마다 아이템 5개를 새로 뽑고, 지금 들고 있는 구성 아이템은 치운다(저장된 구성은 그대로, 게임이 끝나면 돌려줌).
	delete {-grand::*}
	set {-grandon} to false
	if gcRandom() is true:
		set {-grandon} to true
		loop {-gplist::*}:
			gRollLoadout(loop-value)
			loadoutClearAll(loop-value)
	set {-ingame} to true
	loop {-gplist::*}:
		gameRespawn(loop-value)
	# 게임 관전자: 관전 모드로 게임 월드 중앙에서 구경한다(spectate.sk)
	set {_wc} to gStormCenter()
	loop all players:
		if {-gwatch::%uuid of loop-player%} is set:
			set gamemode of loop-player to spectator
			tpSafe(loop-player, {_wc})
			send "&7이번 게임은 관전 상태로 구경해요." to loop-player
	# 녹아웃 첫 라운드 시작 시각(5분 뒤 체력 감소, gStormTick)
	set {-grstart} to now
	set {-grnum} to 1
	delete {-gbstart}
	if {-gmode} is "bounty":
		set {-gbstart} to now
	delete {-gcprog}
	# 크라운: 시작 gCrownWaitSec() 초 뒤 첫 소지자(gCrownTick)
	delete {-gcrown}
	delete {-gcwait}
	if {-gmode} is "crown":
		set {-gcwait} to gCrownWaitSec()
	loop {-gplist::*}:
		anvilClear(loop-value)
		skillCdReset(loop-value)
	delete {-gstartprev::*}
	gAnnounceTeams()
	set {_sub} to "목표 %{-gtarget}%"
	if {-gmode} is "annihilation":
		set {_sub} to "%{-gtarget}%선승"
	if {-gmode} is "bounty":
		set {_sub} to "%{-gtarget}%&e★"
	if {-gmode} is "crown":
		set {_sub} to "%{-gtarget}%&6♛"
	loop all players:
		send title "&f%gcModeName({-gmode})%" with subtitle "&7%{_sub}%" to loop-player for 3 seconds with fadein 5 ticks and fade out 10 ticks


# 연출 없이 게임을 정리한다(관리자 강제 종료, 연출이 끝난 뒤 로비로 돌아갈 때).
function gameCleanup():
	set {-ingame} to false
	delete {-gstarting}
	add 1 to {-gstartgen}
	add 1 to {-grgen}
	delete {-grstart}
	delete {-gbstart}
	delete {-gcrown}
	delete {-gcwait}
	gStartCamRelease()
	gsClear()
	bgmStopAll()
	delete {-gstartprev::*}
	delete {-gover}
	delete {-groundend}
	delete {-gpteam::*}
	delete {-gpname::*}
	delete {-gslot::*}
	loop {-gplist::*}:
		gStarRemove("%uuid of loop-value%")
		gCrownRemove(loop-value)
		delete {-gdead::%uuid of loop-value%}
		set {_pl} to loop-value
		if {_pl} is online:
			kcClearState({_pl})
			anvilClear({_pl})
			gDropEnd({_pl})
			set gamemode of {_pl} to adventure
			{_pl}.setInvulnerable(false)
			{_pl}.clearTitle()
			# 랜덤 아이템 모드였으면 뽑았던 구성 아이템을 치우고 저장된 구성을 다시 지급한다({-ingame} 가 false 라 loadoutGet 이 저장된 구성을 읽음)
			if {-grandon} is true:
				loadoutClearAll({_pl})
				loadoutGive({_pl})
	delete {-grand::*}
	delete {-grandon}
	# 게임 관전자는 어드벤처 모드로 돌려 놓는다(로비 이동은 호출한 쪽)
	loop all players:
		if {-gwatch::%uuid of loop-player%} is set:
			if gamemode of loop-player is spectator:
				set gamemode of loop-player to adventure
	delete {-gwatch::*}
	set {_empty} to GsonComponentSerializer.gson().deserialize("{""text"":""""}")
	loop all players:
		set {_pl2} to loop-player
		{_pl2}.setPlayerListOrder(0)
		tabUpdate({_pl2})
		{_pl2}.sendPlayerListHeaderAndFooter({_empty}, {_empty})

# 관리자 강제 종료(연출/결과 발표 없음). by(실행한 관리자 이름)는 메시지에 쓰지 않는다.
function gameForceStop(by: text):
	if {-ingame} is not true:
		if {-gfinale} is not true:
			if {-gstarting} is not true:
				stop
	gameCleanup()
	gfAbort()
	# 모든 플레이어(참가자, 중간 관전자 포함)를 로비로 보낸다. 관전 중이던 사람은 모드를 어드벤처로 되돌린다.
	set {_lobby} to gameLobbyLoc()
	loop all players:
		set {_pl} to loop-player
		if gamemode of {_pl} is spectator:
			set gamemode of {_pl} to adventure
		tpSafe({_pl}, {_lobby})
		send "&7게임을 강제로 종료했습니다." to {_pl}

# ===== 전적 =====
# 피해 기록: 적에게 준 피해(실 체력)를 누적하고 어시스트 판정용 시각을 남긴다. 본인/아군에게 준 피해는 세지 않는다.
function gameDamageRecord(v: player, a: entity, d: number):
	if {-ingame} is not true:
		stop
	if {-gover} is true:
		stop
	if {_a} is not a player:
		stop
	if {_a} is {_v}:
		stop
	if isAlly("%uuid of {_a}%", "%uuid of {_v}%") is true:
		stop
	if {_d} <= 0:
		stop
	add {_d} to {-gdmg::%uuid of {_a}%}
	set {-glastdmg::%uuid of {_v}%::%uuid of {_a}%} to now

# 치명타가 아닌 피해(치명타는 killcine.sk 가 취소하고 gameDamageRecord 를 직접 부른다)
on damage with priority monitor:
	if {-ingame} is not true:
		stop
	if event is cancelled:
		stop
	if victim is not a player:
		stop
	if attacker is not a player:
		stop
	set {_ev} to event
	gameDamageRecord(victim, attacker, {_ev}.getFinalDamage())

# 피해자 vid 에게 최근 gFallCreditSec() 초 안에 피해를 준 사람 중 가장 최근 사람의 uuid 를 {-gcredit} 에 넣는다(없으면 지움).
function gFallCredit(vid: text):
	delete {-gcredit}
	set {_best} to 999999999
	loop {-glastdmg::%{_vid}%::*}:
		set {_oid} to loop-index
		set {_age} to now - loop-value
		set {_ms} to {_age}.getMilliSeconds()
		if {_ms} <= gFallCreditSec() * 1000:
			if {_ms} < {_best}:
				set {_best} to {_ms}
				set {-gcredit} to {_oid}

# 킬 처리. v 가 죽었고 a 가 공격자(없으면 v 본인)다. killcine.sk 의 killScoreHook 가 부른다.
function gameOnKill(v: player, a: entity):
	if {-ingame} is not true:
		stop
	if {-gover} is true:
		stop
	if gInGame({_v}) is false:
		stop
	set {_vid} to "%uuid of {_v}%"
	add 1 to {-gd::%{_vid}%}
	# 킬 인정: 플레이어가 다른 팀 플레이어를 처치(자살/아군 처치/환경은 킬 없음)
	set {_kill} to false
	if {_a} is a player:
		if {_a} is not {_v}:
			if isAlly("%uuid of {_a}%", {_vid}) is false:
				set {_kill} to true
	# 공격자 없는 죽음(낙사, 허공, 용암 등): 최근 gFallCreditSec() 초 안에 피해를 준 적이 있으면 가장 최근에 때린 적이 킬을 가져간다.
	if {_kill} is false:
		if {_a} is not a player:
			gFallCredit({_vid})
			set {_cid} to {-gcredit}
			delete {-gcredit}
			if {_cid} is set:
				loop {-gplist::*}:
					set {_cp} to loop-value
					if "%uuid of {_cp}%" is {_cid}:
						set {_a} to {_cp}
						set {_kill} to true
		else if {_a} is {_v}:
			gFallCredit({_vid})
			set {_cid} to {-gcredit}
			delete {-gcredit}
			if {_cid} is set:
				loop {-gplist::*}:
					set {_cp} to loop-value
					if "%uuid of {_cp}%" is {_cid}:
						set {_a} to {_cp}
						set {_kill} to true
	set {_aid} to "%uuid of {_a}%"
	if {_kill} is true:
		add 1 to {-gk::%{_aid}%}
		# 어시스트: 최근 gAssistSec() 초 안에 피해를 준 다른 사람
		loop {-glastdmg::%{_vid}%::*}:
			set {_oid} to loop-index
			if {_oid} is not {_aid}:
				set {_t} to {-glastdmg::%{_vid}%::%{_oid}%}
				set {_age} to now - {_t}
				set {_agems} to {_age}.getMilliSeconds()
				if {_agems} <= gAssistSec() * 1000:
					add 1 to {-ga::%{_oid}%}
	delete {-glastdmg::%{_vid}%::*}
	if {-gmode} is "bounty":
		gBountyKill({_v}, {_a}, {_kill})
	else if {-gmode} is "annihilation":
		set {-gdead::%{_vid}%} to true
		gAnnCheck()
	else if {-gmode} is "crown":
		gCrownKill({_v}, {_a}, {_kill})

# ===== 바운티 =====
# 죽은 사람의 별만큼 킬한 팀 스코어가 오르고, 킬한 사람의 별(현상금)이 1개 늘어난다. 죽은 사람의 별은 기본으로 돌아간다.
function gBountyKill(v: player, a: entity, kill: boolean):
	set {_vid} to "%uuid of {_v}%"
	set {_stars} to {-gstar::%{_vid}%}
	if {_stars} is not a number:
		set {_stars} to gStarBase()
	set {-gstar::%{_vid}%} to gStarBase()
	if {_kill} is false:
		stop
	set {_ap} to {_a}
	set {_aid} to "%uuid of {_a}%"
	set {_tk} to gTeamOf({_ap})
	add {_stars} to {-gscore::%{_tk}%}
	set {_cur} to {-gstar::%{_aid}%}
	if {_cur} is not a number:
		set {_cur} to gStarBase()
	set {-gstar::%{_aid}%} to {_cur} + 1
	gStarSync({_ap})
	loop all players:
		send action bar colored "&f%name of {_a}% &7님이 &f%name of {_v}% &7님을 처치했습니다! &e+%{_stars}%★ &7(%gTeamLabel({_tk})% &f%{-gscore::%{_tk}%}%&7/%{-gtarget}%)" to loop-player
	if {-gscore::%{_tk}%} >= {-gtarget}:
		gameWin({_tk})

# 팀의 킬 합계(제한시간 동점 처리용)
function gTeamKills(key: text) :: number:
	set {_n} to 0
	loop {-gplist::*}:
		set {_pl} to loop-value
		if gTeamOf({_pl}) is {_key}:
			set {_k} to {-gk::%uuid of {_pl}%}
			if {_k} is a number:
				add {_k} to {_n}
	return {_n}

# 바운티 남은 시간(초). 바운티가 아니거나 시작 전이면 -1
function gBountyLeft() :: number:
	if {-ingame} is not true:
		return -1
	if {-gmode} is not "bounty":
		return -1
	if {-gbstart} is not set:
		return -1
	set {_el} to difference between {-gbstart} and now
	set {_ms} to {_el}.getMilliSeconds()
	set {_left} to gBountyLimit() * 60 - floor({_ms} / 1000)
	if {_left} < 0:
		return 0
	return {_left}

# 제한시간이 지났으면 스코어 1위 팀(동점: 팀 킬 합계, 그래도 같으면 무작위)을 승자로 끝낸다
function gBountyTimeCheck():
	if {-ingame} is not true:
		stop
	if {-gover} is true:
		stop
	if {-gstarting} is true:
		stop
	if gBountyLeft() is not 0:
		stop
	set {_best} to -1
	delete {_tied::*}
	loop {-gteamlist::*}:
		set {_sc} to {-gscore::%loop-value%}
		if {_sc} is not a number:
			set {_sc} to 0
		if {_sc} > {_best}:
			set {_best} to {_sc}
			delete {_tied::*}
			add loop-value to {_tied::*}
		else if {_sc} is {_best}:
			add loop-value to {_tied::*}
	if size of {_tied::*} is 0:
		stop
	if size of {_tied::*} > 1:
		set {_bk} to -1
		delete {_t2::*}
		loop {_tied::*}:
			set {_kk} to gTeamKills(loop-value)
			if {_kk} > {_bk}:
				set {_bk} to {_kk}
				delete {_t2::*}
				add loop-value to {_t2::*}
			else if {_kk} is {_bk}:
				add loop-value to {_t2::*}
		set {_win} to random element of {_t2::*}
	else:
		set {_win} to {_tied::1}
	loop all players:
		send title "&e시간 종료" with subtitle "&7제한시간 %gBountyLimit()%분" to loop-player for 3 seconds with fadein 5 ticks and fade out 10 ticks
	gameWin({_win})

every second:
	gBountyTimeCheck()

# ===== 크라운 =====
# 게임이 시작되고 gCrownWaitSec() 초 뒤 무작위 참가자 1명에게 크라운이 씌워진다({-gcrown} = 소지자 uuid). 소지자는 주황색 발광 효과(벽 너머로도 보임, 스코어보드 팀 gcrown = GOLD)와 머리 위 ♛ 표시로 모두에게 위치가 드러난다.
# 소지자가 살아서 움직이는 동안 1.5초마다 소지자 팀(개인전은 본인)의 스코어가 1점 오르고, 목표 스코어({-gtarget}, 기본 100)를 먼저 채우면 승리한다.
# 소지자를 처치하면(적 킬) 처치한 사람이 크라운을 빼앗는다. 킬로 인정되지 않는 죽음(자살/환경/아군)이면 소지자를 뺀 무작위 참가자에게 간다. 소지자가 나가면 무작위 참가자에게 간다.
# 변수(RAM): {-gcrown}(소지자 uuid), {-gcwait}(첫 지급까지 남은 초), {-gcrown_d::uuid}(머리 위 표시), {-gcglow::uuid}(크라운 때문에 발광을 켠 사람), {-gcteam::uuid}/{-gcoldteam::uuid}(주황 팀에 넣은 표시/원래 팀 이름), {-gcprog}(스코어 진행도 0~2)
function gCrownWaitSec() :: number:
	return 10

# 소지자(없거나 접속 종료면 값 없음)
function gCrownHolder() :: player:
	if {-gcrown} is not set:
		return {_none}
	loop {-gplist::*}:
		if "%uuid of loop-value%" is {-gcrown}:
			if loop-value is online:
				return loop-value
	return {_none}

# ex(uuid) 를 뺀, 접속해 있고 관전 상태가 아닌 참가자 중 무작위 1명(없으면 값 없음)
function gCrownPick(ex: text) :: player:
	delete {_c::*}
	loop {-gplist::*}:
		set {_pl} to loop-value
		if {_pl} is online:
			if "%uuid of {_pl}%" is not {_ex}:
				if gamemode of {_pl} is not spectator:
					add {_pl} to {_c::*}
	if size of {_c::*} is 0:
		return {_none}
	return random element of {_c::*}

function gCrownRemove(p: player):
	set {_id} to "%uuid of {_p}%"
	set {_d} to {-gcrown_d::%{_id}%}
	if {_d} is set:
		delete entity within {_d}
	delete {-gcrown_d::%{_id}%}
	if {-gcteam::%{_id}%} is set:
		set {_sb} to Bukkit.getScoreboardManager().getMainScoreboard()
		set {_ct} to {_sb}.getTeam("gcrown")
		if {_ct} is set:
			scRemove({_ct}, {_p})
		if {-gcoldteam::%{_id}%} is set:
			set {_ot} to {_sb}.getTeam({-gcoldteam::%{_id}%})
			if {_ot} is set:
				scAdd({_ot}, {_p})
		delete {-gcteam::%{_id}%}
		delete {-gcoldteam::%{_id}%}
	if {-gcglow::%{_id}%} is set:
		delete {-gcglow::%{_id}%}
		if {_p} is online:
			{_p}.setGlowing(false)

# 한 명의 크라운 표시를 맞춘다: 소지자면 발광 + 머리 위 ♛(체력바/상태 이름 위 1.2 높이에 태움, 별과 같은 방식), 아니면 치운다.
function gCrownSync(p: player):
	set {_id} to "%uuid of {_p}%"
	set {_show} to false
	if {-ingame} is true:
		if {-gmode} is "crown":
			if {-gover} is not true:
				if {-gcrown} is {_id}:
					if {_p} is online:
						if gamemode of {_p} is not spectator:
							set {_show} to true
	if {_show} is false:
		gCrownRemove({_p})
		stop
	{_p}.setGlowing(true)
	set {-gcglow::%{_id}%} to true
	# 발광 색은 소속 스코어보드 팀 색으로 정해지므로 크라운 소지자를 주황(GOLD) 팀에 넣는다(원래 팀은 {-gcoldteam} 에 기억해 두었다가 돌려준다)
	if {-gcteam::%{_id}%} is not set:
		set {_sb} to Bukkit.getScoreboardManager().getMainScoreboard()
		set {_ct} to {_sb}.getTeam("gcrown")
		if {_ct} is not set:
			set {_ct} to {_sb}.registerNewTeam("gcrown")
		{_ct}.setColor(ChatColor.GOLD)
		set {_old} to {_sb}.getEntryTeam({_p}.getName())
		if {_old} is set:
			set {-gcoldteam::%{_id}%} to {_old}.getName()
		scAdd({_ct}, {_p})
		set {-gcteam::%{_id}%} to true
	set {_d} to {-gcrown_d::%{_id}%}
	set {_new} to false
	if {_d} is not set:
		set {_new} to true
	else if {_d} is dead:
		set {_new} to true
	else if vehicle of {_d} is not {_p}:
		delete entity within {_d}
		set {_new} to true
	if {_new} is true:
		spawn a text display at location of {_p}:
			set {_d} to event-entity
			add "gcrown" to scoreboard tags of event-entity
			set billboard of event-entity to center
			set transformation translation of event-entity to vector(0, 1.2, 0)
			add event-entity to passengers of {_p}
		set {-gcrown_d::%{_id}%} to {_d}
	set text of {_d} to "&6♛ &e크라운"

function gCrownSyncAll():
	loop {-gplist::*}:
		gCrownSync(loop-value)

# 크라운을 p 에게 준다. from 은 빼앗긴 사람 이름(처음 지급/그냥 떨어진 경우는 "").
function gCrownGive(p: player, from: text):
	set {-gcrown} to "%uuid of {_p}%"
	gCrownSyncAll()
	set {_pn} to {_p}.getName()
	loop all players:
		play sound "block.beacon.activate" with volume 0.8 and pitch 1.4 to loop-player
		if {_from} is "":
			send title "&6♛ 크라운" with subtitle "&f%{_pn}% &7님이 크라운을 얻었어요" to loop-player for 3 seconds with fadein 5 ticks and fade out 10 ticks
		else:
			send title "&6♛ 크라운" with subtitle "&f%{_pn}% &7님이 &f%{_from}% &7님의 크라운을 빼앗았어요" to loop-player for 3 seconds with fadein 5 ticks and fade out 10 ticks

# 킬 처리(gameOnKill 에서 부른다): 죽은 사람이 소지자일 때만 크라운이 옮겨간다.
function gCrownKill(v: player, a: entity, kill: boolean):
	set {_vid} to "%uuid of {_v}%"
	if {-gcrown} is not {_vid}:
		stop
	set {_vn} to {_v}.getName()
	if {_kill} is true:
		gCrownGive({_a}, {_vn})
		stop
	set {_np} to gCrownPick({_vid})
	if {_np} is set:
		gCrownGive({_np}, "")
	else:
		gCrownSyncAll()

# 1초마다: 첫 지급 카운트다운, 소지자 확인(나갔으면 새로 뽑기), 스코어 +1, 승리 판정, 표시 갱신
function gCrownTick():
	if {-ingame} is not true:
		stop
	if {-gmode} is not "crown":
		stop
	if {-gover} is true:
		stop
	if {-gstarting} is true:
		stop
	if {-gcwait} is set:
		subtract 1 from {-gcwait}
		if {-gcwait} <= 0:
			set {_np} to gCrownPick("")
			if {_np} is set:
				delete {-gcwait}
				gCrownGive({_np}, "")
			else:
				set {-gcwait} to 1
		else:
			loop {-gplist::*}:
				if loop-value is online:
					send action bar colored "&6♛ 크라운 지급까지 %{-gcwait}%초" to loop-value
		stop
	set {_h} to gCrownHolder()
	if {_h} is not set:
		delete {-gcrown}
		set {_np} to gCrownPick("")
		if {_np} is set:
			gCrownGive({_np}, "")
		stop
	set {_hid} to "%uuid of {_h}%"
	if gamemode of {_h} is not spectator:
		if {-kc::%{_hid}%} is not set:
			# 1.5초당 1점: 1초마다 2/3점씩 모아서(진행도 2씩, 3이 되면 1점) 점수로 바꾼다
			add 2 to {-gcprog}
			if {-gcprog} >= 3:
				subtract 3 from {-gcprog}
				set {_tk} to gTeamOf({_h})
				add 1 to {-gscore::%{_tk}%}
				send action bar colored "&6♛&f%{-gscore::%{_tk}%}%&7/%{-gtarget}%" to {_h}
				if {-gscore::%{_tk}%} >= {-gtarget}:
					gameWin({_tk})
					stop
	gCrownSyncAll()

every second:
	gCrownTick()

# ===== 녹아웃 =====
# 살아 있는 팀이 1개 이하면 라운드 종료. 마지막 한 팀이 승점 1점, 전원 사망이면 무승부.
function gAnnCheck():
	if {-ingame} is not true:
		stop
	if {-gmode} is not "annihilation":
		stop
	if {-groundend} is true:
		stop
	delete {_alive::*}
	loop {-gplist::*}:
		if gAlive(loop-value) is true:
			set {_alive::%gTeamOf(loop-value)%} to true
	if size of {_alive::*} > 1:
		stop
	set {-groundend} to true
	set {_w} to ""
	loop {_alive::*}:
		set {_w} to loop-index
	gRoundEnd({_w})

function gRoundEnd(w: text):
	if {_w} is not "":
		add 1 to {-gscore::%{_w}%}
		loop all players:
			play sound "entity.player.levelup" with volume 0.7 and pitch 1 to loop-player
		if {-gscore::%{_w}%} >= {-gtarget}:
			gameWin({_w})
			stop
	# 킬 연출 중이면 killcine.sk 가 라운드 종료 연출(전원 관람 -> 승리자 클로즈업 -> 타이틀)을 한 뒤 gRoundNext() 를 부른다.
	set {-groundwin} to {_w}
	if size of {-kc::*} > 0:
		stop
	# 킬 연출이 없는 라운드 종료(접속 종료 등)는 잠깐 뒤에 바로 다음 라운드
	wait 5 seconds
	gRoundNext()

# 다음 라운드 시작: "강하를 준비하세요" 타이틀과 5초 카운트다운(소리 없음, 카운트다운은 부제목의 숫자) 뒤 모두 부활시키고 "n라운드" 타이틀(소리 없음). n = {-grnum}(게임 시작 때 1, 라운드가 시작될 때마다 +1).
# 카운트다운 동안 참가자는 관전 상태로 둔다(죽은 사람과 산 사람이 섞여 싸우지 않게, 부활은 gameRespawn 이 어드벤처로 되돌린다).
# 강제 종료/게임 종료로 상태가 바뀌었으면({-grgen} 이 올라감) 아무것도 안 한다. 변수(RAM): {-grgen}(라운드 연출 세대)
function gRoundNext():
	if {-ingame} is not true:
		stop
	if {-gover} is true:
		stop
	delete {-groundwin}
	add 1 to {-grgen}
	set {_rg} to {-grgen}
	loop {-gplist::*}:
		set {_pl} to loop-value
		if {_pl} is online:
			set gamemode of {_pl} to spectator
	# 카운트다운 동안 관전자의 위치/시점을 잠근다(gSpecIntro)
	set {-grcount} to {_rg}
	set {_c} to 5
	while {_c} > 0:
		if {-ingame} is not true:
			stop
		if {-gover} is true:
			stop
		if {-grgen} is not {_rg}:
			stop
		loop {-gplist::*}:
			set {_pl} to loop-value
			if {_pl} is online:
				send title "&f강하를 준비하세요" with subtitle "&f%{_c}%" to {_pl} for 25 ticks with fadein 0 ticks and fade out 0 ticks
		wait 1 second
		remove 1 from {_c}
	if {-ingame} is not true:
		stop
	if {-gover} is true:
		stop
	if {-grgen} is not {_rg}:
		stop
	delete {-grcount}
	loop {-gplist::*}:
		if loop-value is online:
			gameRespawn(loop-value)
	set {-grstart} to now
	add 1 to {-grnum}
	loop {-gplist::*}:
		if loop-value is online:
			skillCdReset(loop-value)
	delete {-groundend}
	loop all players:
		send title "&f%{-grnum}%라운드" with subtitle "&7%gcModeName({-gmode})%" to loop-player for 2 seconds with fadein 0 ticks and fade out 10 ticks

# ===== 녹아웃 체력 감소(자기장 대신) =====
# 라운드가 시작되고({-grstart}) 5분이 지나면(서든 데스) 3초마다 살아 있는 참가자의 체력이 깎인다. 5분이 되는 순간 "서든 데스" 타이틀/채팅 안내(gStormAnnounce), 이후 액션바로 리스폰 지점 방향/거리 안내(gStormCompass). 리스폰 지점(없으면 월드 스폰)에서 가로(x,z)로 먼 사람부터 순서대로 더 깎는다(높이 y 는 안 봄):
#   가까운 순서 r(0 = 제일 가까움)마다 기본 1 + r x 0.5 (실 체력), 최대 gStormMax() 까지. 거리가 같으면 같은 순서.
# 라운드 종료 연출 중({-groundend}), 킬 연출 중({-kc}), 죽은 사람, 관전자는 제외. 피해는 attacker 없는 일반 피해라 치명타면 킬 연출 + 마지막으로 피해를 준 적(10초 안)에게 킬 인정(기존 규칙).
# 미검증: Math.atan2/toDegrees 호출로 화살표 방향이 맞는지(Minecraft yaw 기준: 0 = +z, 시계방향 증가), 액션바가 다른 액션바(킬 알림)와 겹칠 때 깜빡이는지, 연속 피해가 무적 시간에 막히는지, 갑옷/버프로 줄어드는지(실제 피해량 확인 필요).
function gStormDelaySec() :: number:
	return 300

function gStormStep() :: number:
	return 0.5

function gStormMax() :: number:
	return 4

# dists 중 mine 보다 작은 값의 개수(= 나보다 리스폰에 가까운 사람 수)
function gStormCloser(mine: number, dists: numbers) :: number:
	set {_c} to 0
	loop {_dists::*}:
		if loop-value < {_mine}:
			add 1 to {_c}
	return {_c}

# 5분이 지나 체력 감소(서든 데스)가 진행 중인지(라운드 진행 중일 때만)
function gStormOn() :: boolean:
	if {-ingame} is not true:
		return false
	if {-gmode} is not "annihilation":
		return false
	if {-groundend} is true:
		return false
	if {-gover} is true:
		return false
	if {-gstarting} is true:
		return false
	if {-grcount} is set:
		return false
	if {-grstart} is not set:
		return false
	set {_el} to difference between {-grstart} and now
	if {_el} < 5 minutes:
		return false
	return true

# 체력 감소의 기준점(리스폰 지점, 없으면 월드 스폰)
function gStormCenter() :: location:
	set {_c} to gcLoadLoc(gcRespawnKey("%{-gworld}%"))
	if {_c} is not set:
		set {_gw} to gcWorld("%{-gworld}%")
		set {_c} to {_gw}.getSpawnLocation()
	return {_c}

# 체력 감소를 받는 사람인지(살아 있고, 킬 연출 중/관전이 아님)
function gStormTarget(p: player) :: boolean:
	if {_p} is not online:
		return false
	if gAlive({_p}) is not true:
		return false
	if {-kc::%uuid of {_p}%} is set:
		return false
	if gamemode of {_p} is spectator:
		return false
	return true

# 3초마다: 거리 순서대로 체력을 깎는다
function gStormTick():
	if gStormOn() is not true:
		stop
	set {_c} to gStormCenter()
	set {_cx} to {_c}.getX()
	set {_cz} to {_c}.getZ()
	delete {_d::*}
	loop {-gplist::*}:
		set {_p} to loop-value
		if gStormTarget({_p}) is true:
			set {_dx} to {_p}.getLocation().getX() - {_cx}
			set {_dz} to {_p}.getLocation().getZ() - {_cz}
			set {_d::%uuid of {_p}%} to {_dx} * {_dx} + {_dz} * {_dz}
	loop {-gplist::*}:
		set {_p} to loop-value
		set {_id} to "%uuid of {_p}%"
		if {_d::%{_id}%} is set:
			set {_r} to gStormCloser({_d::%{_id}%}, {_d::*})
			set {_dmg} to 1 + {_r} * gStormStep()
			if {_dmg} > gStormMax():
				set {_dmg} to gStormMax()
			# 꿀벌 조종 중(bee.sk)인 플레이어는 무적이라 피해가 안 들어가므로, 이 피해를 주는 동안만 무적을 푼다
			set {_dr} to false
			if {-beemode::%{_id}%} is "drive":
				set {_dr} to true
				{_p}.setInvulnerable(false)
			damage {_p} by hp({_dmg}) hearts
			if {_dr} is true:
				if {_p} is online:
					if {-beemode::%{_id}%} is "drive":
						{_p}.setInvulnerable(true)

# 5분이 되는 순간 한 번(라운드마다): "서든 데스" 타이틀 + 채팅 안내
function gStormAnnounce():
	if gStormOn() is not true:
		stop
	set {_k} to "%{-grstart}%"
	if {-gstormann} is {_k}:
		stop
	set {-gstormann} to {_k}
	loop {-gplist::*}:
		set {_p} to loop-value
		if {_p} is online:
			send title "&c서든 데스" with subtitle "&f체력이 감소합니다" to {_p} for 4 seconds with fadein 10 ticks and fade out 20 ticks
			send "&c중앙에서 멀수록 받는 데미지가 강해집니다." to {_p}
			play sound "entity.wither.spawn" with volume 0.5 and pitch 1 to {_p}

# 중앙(리스폰 지점) 방향 안내(액션바): 5분이 지난 뒤 체력 감소를 받는 사람에게 화살표와 거리를 보여 준다. 화살표는 지금 보는 방향 기준(↑ 앞, → 오른쪽 ...).
function gStormCompass():
	if gStormOn() is not true:
		stop
	set {_c} to gStormCenter()
	set {_cx} to {_c}.getX()
	set {_cz} to {_c}.getZ()
	set {_ar::*} to "↑", "↗", "→", "↘", "↓", "↙", "←", "↖"
	loop {-gplist::*}:
		set {_p} to loop-value
		if gStormTarget({_p}) is true:
			set {_pl} to {_p}.getLocation()
			set {_dx} to {_cx} - {_pl}.getX()
			set {_dz} to {_cz} - {_pl}.getZ()
			set {_dist} to round(sqrt({_dx} * {_dx} + {_dz} * {_dz}))
			set {_ty} to 0 - Math.toDegrees(Math.atan2({_dx}, {_dz}))
			set {_rel} to {_ty} - {_pl}.getYaw() + 720
			set {_rel} to mod({_rel}, 360)
			set {_ix} to floor(({_rel} + 22.5) / 45)
			set {_ix} to mod({_ix}, 8) + 1
			set {_a} to {_ar::%{_ix}%}
			send action bar colored "&c중앙 &f%{_a}% &7%{_dist}%m" to {_p}

every 3 seconds:
	gStormTick()

every second:
	gStormAnnounce()

every 5 ticks:
	gStormCompass()

# 연출 중에 부활을 막을지(녹아웃에서 죽은 사람은 라운드가 끝날 때까지 관전). killcine.sk 의 리스폰 단계가 부른다.
function gKeepDead(v: player) :: boolean:
	if {-ingame} is not true:
		return false
	if {-gmode} is not "annihilation":
		return false
	if {-gdead::%uuid of {_v}%} is set:
		return true
	return false

# ===== 승리 =====
# 한 팀이 목표를 채웠다. 종료 연출은 gameend.sk(gameFinale).
function gameWin(key: text):
	if {-gover} is true:
		stop
	set {-gover} to true
	set {-gwinner} to {_key}
	# 크라운: 승리가 정해지면 소지자 표시(발광, 머리 위 ♛)를 치운다(종료 연출에 안 나오게)
	if {-gmode} is "crown":
		loop {-gplist::*}:
			gCrownRemove(loop-value)
	# 킬 연출이 진행 중이면(killcine.sk 가 {-kc} 를 켜 둠) 그 연출을 모두가 본 뒤 killcine.sk 가 gameFinale() 을 부른다.
	# 킬 연출 없이 승리가 정해진 경우(접속 종료로 녹아웃이 끝남 등)는 바로 종료 연출(gameend.sk)을 시작한다.
	if size of {-kc::*} is 0:
		gameFinale()

# 시작 연출(startcine.sk) 또는 녹아웃 라운드 시작 카운트다운(gRoundNext) 중인지
function gSpecIntro() :: boolean:
	if {-gstarting} is true:
		return true
	if {-grcount} is set:
		if {-grcount} is {-grgen}:
			return true
	return false

# 관전 상태 참가자 p 의 위치/시점을 잠글지(킬 연출/리스폰 대기, 승패 후 마지막 킬 연출, 종료 연출, 시작 연출, 라운드 시작 카운트다운)
function gSpecLocked(p: player) :: boolean:
	if {-kc::%{_p}'s uuid%} is set:
		return true
	if {-gover} is true:
		return true
	if {-gfinale} is true:
		return true
	if gSpecIntro() is true:
		return true
	return false

# 연출을 보거나 리스폰을 기다리는 관전 상태 참가자만 제자리에서 못 움직이게 한다. 시선 회전은 허용.
#   대상: 킬 연출 중/리스폰 대기 중인 사람({-kc} 가 켜진 사람), 승패가 난 뒤 마지막 킬 연출을 보는 사람({-gover}), 종료 연출 중인 사람({-gfinale}).
#   "게임 중"인지는 보지 않는다(종료 연출 중에는 게임이 진행 중이 아니어도 막아야 해서). 녹아웃에서 죽어 라운드를 기다리는 관전자는 자유롭게 움직인다.
# 카메라를 따라가는 관전(setSpectatorTarget)은 건드리지 않는다. 미검증: 관전자의 PlayerMoveEvent 취소가 서버에서 제자리로 되돌리는지.
on PlayerMoveEvent:
	set {_p} to event.getPlayer()
	if gamemode of {_p} is not spectator:
		stop
	if {-gplist::*} does not contain {_p}:
		stop
	set {_lock} to gSpecLocked({_p})
	if {_lock} is false:
		stop
	if {_p}.getSpectatorTarget() is set:
		stop
	set {_f} to event.getFrom()
	set {_t} to event.getTo()
	if distance between {_f} and {_t} > 0.0001:
		event.setCancelled(true)
		stop
	# 시작 연출/라운드 시작 카운트다운 중에는 시선도 못 돌린다(시작 카메라가 없는 월드는 카메라 고정이 없어서 여기서 막는다)
	if gSpecIntro() is true:
		if {_f}.getYaw() is not {_t}.getYaw():
			event.setCancelled(true)
		else if {_f}.getPitch() is not {_t}.getPitch():
			event.setCancelled(true)

# 시작 연출 중 카메라(관전 대상)에서 내려오는 것을 막는다(웅크리기 등). 미검증: PlayerStopSpectatingEntityEvent 가 취소되는지.
on PlayerStopSpectatingEntityEvent:
	if {-gspecforce} is true:
		stop
	set {_sp} to event.getPlayer()
	if {-gstarting} is true:
		if {-gplist::*} contains {_sp}:
			event.setCancelled(true)

# 관전 메뉴(숫자키/가운데 클릭으로 다른 플레이어에게 순간이동)도 잠금 대상이면 막는다. 미검증: 순간이동 원인 이름 SPECTATE.
on PlayerTeleportEvent:
	set {_tp} to event.getPlayer()
	if gamemode of {_tp} is not spectator:
		stop
	if {-gplist::*} does not contain {_tp}:
		stop
	set {_cause} to event.getCause()
	set {_cn} to {_cause}.name()
	if {_cn} is not "SPECTATE":
		stop
	if gSpecLocked({_tp}) is true:
		event.setCancelled(true)

# 혹시 풀려도 매 틱 다시 카메라에 붙인다(웅크리기, 연출 단계 사이 대기 중에도)
every 1 tick:
	if {-gstarting} is true:
		gStartKeep()

on quit:
	if {-ingame} is true:
		if {-gplist::*} contains player:
			gDropEnd(player)
			gStarRemove("%uuid of player%")
			gCrownRemove(player)
			set {-gdead::%uuid of player%} to true
			gAnnCheck()

# 스크립트를 다시 불러오면 진행 중이던 게임은 끝난 것으로 본다(타이머가 사라져서). 남은 별 표시도 지운다.
on load:
	if {-gstartcam} is set:
		{-gstartcam}.remove()
	delete {-gstartcam}
	delete {-gstarting}
	delete {-ingame}
	delete {-gover}
	delete {-groundend}
	loop all text displays:
		set {_e} to loop-entity
		if {_e} has scoreboard tag "gstar":
			delete entity within {_e}
	delete {-gstar_d::*}
	loop all text displays:
		set {_e} to loop-entity
		if {_e} has scoreboard tag "gcrown":
			delete entity within {_e}
	loop all players:
		if {-gcglow::%uuid of loop-player%} is set:
			loop-player.setGlowing(false)
	delete {-gcrown_d::*}
	delete {-gcglow::*}
	delete {-gcprog}
	delete {-gcrown}
	delete {-gcwait}
	# 스크립트를 다시 불러오면 변수({-gcoldteam})가 사라지므로 남은 주황 발광 팀은 통째로 지운다
	set {_ct} to Bukkit.getScoreboardManager().getMainScoreboard().getTeam("gcrown")
	if {_ct} is set:
		{_ct}.unregister()

# 나간 사람의 팀 지정 정리(예전 team.sk 에 있던 것). 결과창은 시작 때 기록한 {-gpteam} 을 쓴다.
on quit:
	delete {-team::%uuid of player%}
