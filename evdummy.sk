# [evdummy.sk] 회피형 연습 더미(op 전용 테스트 도구): 플레이어를 피해 움직이고, 스태미너가 25 이상 찰 때마다 도약하는 마네킹.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 명령(op 전용): /dummy = 내 위치에 더미 생성(내 스킨, 내 최대 체력), /dummy clear = 모든 연습 더미 제거.
# 동작: 매 틱 가장 가까운 플레이어(관전자 제외, 25칸 안)를 찾아 14칸 안이면 반대쪽(+좌우 스트레이프, 30틱마다 방향 무작위)으로 걷고(틱당 0.22칸),
#   스태미너 {-evst} 가 25 이상이면 즉시 도약(도망 방향으로 속도 1.1 + 위로 0.25, 10틱 동안은 걷기 속도를 덮어쓰지 않음)한다. 스태미너 규칙은 플레이어와 같다:
#   도약마다 25 소모, 마지막 도약 59틱 뒤부터 틱당 +1 회복(최대 100), 처음엔 100. 막혀서 0.4칸도 못 움직이면(10틱마다 확인) 방향을 바꾸고 점프한다.
#   생성 위치({-evhome})에서 18칸 넘게 떨어지면 거기로 돌아온다. 죽으면 3초 뒤 같은 자리에 다시 나온다.
# 피해: 일반 플레이어처럼 맞는다(근접/화살/스킬. 화살 보정 arrowAssist 도 같게 적용). 삼지창/꿀벌 자폭/독침도 맞는다(마네킹 제외 조건에서 연습 더미는 뺐음).
# TTK 측정: 처음 피해를 받은 시각부터 죽을 때까지 걸린 초를 주변 40칸 플레이어에게 채팅으로 알린다. 머리 위 이름표에 체력(현재/최대)을 보인다.
# 변수(RAM): {-evd::id}(더미 엔티티), {-evhome::id}, {-evskin::id}, {-evmh::id}(최대 체력), {-evst::id}(스태미너), {-evlock::id}(회복 차단 틱), {-evleap::id}(도약 중 남은 틱),
#   {-evsign::id}(스트레이프 방향 1/-1), {-evtk::id}(틱 카운터), {-evlast::id}(막힘 확인용 이전 위치), {-evt0::id}(첫 피해 시각 ms), {-evdead::id}(죽은 시각, 리스폰 대기)
# 미검증: 전부. 특히 마네킹이 setVelocity 로 중력/마찰을 받으며 움직이는지(안 되면 teleport 방식으로 바꿔야 함), Entity#setRotation, 마네킹 on death 이벤트.

import:
	org.bukkit.entity.EntityType
	org.bukkit.attribute.Attribute
	io.papermc.paper.datacomponent.item.ResolvableProfile
	net.kyori.adventure.text.serializer.gson.GsonComponentSerializer

# 연습 더미인지(스코어보드 태그 evdummy). 다른 파일(trident.sk, bee.sk, projectile.sk)이 "마네킹 제외" 조건에서 예외로 쓴다.
function isEvDummy(e: entity) :: boolean:
	set {_t} to {_e}.getScoreboardTags().contains("evdummy")
	return {_t}

function evdForget(id: text):
	delete {-evd::%{_id}%}
	delete {-evhome::%{_id}%}
	delete {-evskin::%{_id}%}
	delete {-evmh::%{_id}%}
	delete {-evst::%{_id}%}
	delete {-evlock::%{_id}%}
	delete {-evleap::%{_id}%}
	delete {-evsign::%{_id}%}
	delete {-evtk::%{_id}%}
	delete {-evlast::%{_id}%}
	delete {-evt0::%{_id}%}
	delete {-evdead::%{_id}%}

function evdName(m: entity):
	set {_h} to {_m}.getHealth()
	set {_mx} to {_m}.getAttribute(Attribute.MAX_HEALTH).getValue()
	set {_hr} to round({_h} * 10) / 10
	set {_mr} to round({_mx} * 10) / 10
	set {_nj} to "{""text"":""연습 더미 "",""color"":""white"",""extra"":[{""text"":""%{_hr}%/%{_mr}%"",""color"":""red""}]}"
	{_m}.customName(GsonComponentSerializer.gson().deserialize({_nj}))

# loc 에 더미를 만든다. mh = 최대 체력(실 체력). 새 더미의 id 를 돌려준다.
function evdSpawn(loc: location, skin: text, mh: number) :: text:
	set {_m} to {_loc}.getWorld().spawnEntity({_loc}, EntityType.MANNEQUIN)
	{_m}.setProfile(ResolvableProfile.resolvableProfile().name({_skin}).build())
	{_m}.setSilent(true)
	{_m}.addScoreboardTag("evdummy")
	{_m}.setCustomNameVisible(true)
	{_m}.setDescription(GsonComponentSerializer.gson().deserialize("{""text"":""""}"))
	{_m}.getAttribute(Attribute.MAX_HEALTH).setBaseValue({_mh})
	{_m}.setHealth({_mh})
	set {_id} to "%uuid of {_m}%"
	set {-evd::%{_id}%} to {_m}
	set {-evhome::%{_id}%} to {_loc}
	set {-evskin::%{_id}%} to {_skin}
	set {-evmh::%{_id}%} to {_mh}
	set {-evst::%{_id}%} to 100
	set {-evlock::%{_id}%} to 0
	set {-evleap::%{_id}%} to 0
	set {-evsign::%{_id}%} to 1
	set {-evtk::%{_id}%} to 0
	set {-evlast::%{_id}%} to {_loc}
	evdName({_m})
	return {_id}

command /dummy [<text>]:
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	description: 회피형 연습 더미를 만들거나(/dummy) 모두 지웁니다(/dummy clear) (op 전용)
	executable by: players
	trigger:
		if player is not op:
			send "&c권한이 없습니다."
			stop
		if arg-1 is "clear":
			loop {-evd::*}:
				loop-value.remove()
			delete {-evd::*}
			delete {-evhome::*}
			delete {-evskin::*}
			delete {-evmh::*}
			delete {-evst::*}
			delete {-evlock::*}
			delete {-evleap::*}
			delete {-evsign::*}
			delete {-evtk::*}
			delete {-evlast::*}
			delete {-evt0::*}
			delete {-evdead::*}
			send "&7연습 더미를 모두 제거했습니다."
			stop
		set {_mh} to player's max health
		set {_nid} to evdSpawn(player's location, player's name, {_mh})
		send "&a회피형 연습 더미를 만들었습니다. 지우려면 /dummy clear"

# 한 마리 갱신(매 틱). wait 가 없는 함수다.
function evdTick(id: text, m: entity):
	set {_l} to {_m}.getLocation()
	add 1 to {-evtk::%{_id}%}
	set {_tk} to {-evtk::%{_id}%}
	# 스태미너 회복(플레이어와 같은 규칙: 도약 59틱 뒤부터 틱당 +1)
	if {-evlock::%{_id}%} > 0:
		remove 1 from {-evlock::%{_id}%}
	else if {-evst::%{_id}%} < 100:
		add 1 to {-evst::%{_id}%}
	if {-evleap::%{_id}%} > 0:
		remove 1 from {-evleap::%{_id}%}
	if mod({_tk}, 5) is 0:
		evdName({_m})
	# 가장 가까운 플레이어
	set {_best} to 9999
	delete {_np}
	loop all players:
		set {_p} to loop-player
		if {_p}.getWorld() is {_l}.getWorld():
			if gamemode of {_p} is not spectator:
				set {_d} to distance between {_l} and {_p}
				if {_d} < {_best}:
					set {_best} to {_d}
					set {_np} to {_p}
	if {_np} is not set:
		stop
	if {_best} > 25:
		stop
	set {_pl} to {_np}.getLocation()
	set {_dx} to {_pl}.getX() - {_l}.getX()
	set {_dz} to {_pl}.getZ() - {_l}.getZ()
	set {_len} to sqrt({_dx} * {_dx} + {_dz} * {_dz})
	if {_len} < 0.01:
		set {_dx} to 1
		set {_dz} to 0
		set {_len} to 1
	set {_dx} to {_dx} / {_len}
	set {_dz} to {_dz} / {_len}
	# 플레이어를 바라본다(yaw: +z 가 0, +x 가 -90)
	set {_yaw} to atan2(0 - {_dx}, {_dz})
	{_m}.setRotation({_yaw}, 0)
	# 도망 방향 = 플레이어 반대 + 좌우 스트레이프(30틱마다 방향 무작위)
	if mod({_tk}, 30) is 0:
		set {_r} to random integer between 0 and 1
		if {_r} is 0:
			set {-evsign::%{_id}%} to 1
		else:
			set {-evsign::%{_id}%} to -1
	set {_sg} to {-evsign::%{_id}%}
	set {_ax} to 0 - {_dx}
	set {_az} to 0 - {_dz}
	set {_px} to 0 - {_az}
	set {_pz} to {_ax}
	set {_mx} to {_ax} + {_px} * {_sg} * 0.8
	set {_mz} to {_az} + {_pz} * {_sg} * 0.8
	# 생성 위치에서 너무 멀어지면 돌아온다
	set {_h} to {-evhome::%{_id}%}
	set {_hx} to {_h}.getX() - {_l}.getX()
	set {_hz} to {_h}.getZ() - {_l}.getZ()
	set {_hd} to sqrt({_hx} * {_hx} + {_hz} * {_hz})
	if {_hd} > 18:
		set {_mx} to {_hx} / {_hd} + {_px} * {_sg} * 0.4
		set {_mz} to {_hz} / {_hd} + {_pz} * {_sg} * 0.4
	set {_ml} to sqrt({_mx} * {_mx} + {_mz} * {_mz})
	if {_ml} < 0.01:
		set {_mx} to {_ax}
		set {_mz} to {_az}
		set {_ml} to 1
	set {_mx} to {_mx} / {_ml}
	set {_mz} to {_mz} / {_ml}
	# 도약: 스태미너가 25 이상 찰 때마다(도약 중이 아닐 때), 쫓기고 있을 때(20칸 안)
	if {-evleap::%{_id}%} <= 0:
		if {-evst::%{_id}%} >= 25:
			if {_best} <= 20:
				remove 25 from {-evst::%{_id}%}
				set {-evlock::%{_id}%} to 59
				set {-evleap::%{_id}%} to 10
				{_m}.setVelocity(vector({_mx} * 1.1, 0.25, {_mz} * 1.1))
				soundAround("entity.player.attack.sweep", {_l}, 1, 1.2)
				play 15 spit with offset of 0.1, 0.1, 0.1 and speed 0 at {_l} in radius of 100
				stop
	# 도약 중에는 속도를 덮어쓰지 않는다
	if {-evleap::%{_id}%} > 0:
		stop
	if {_best} >= 14:
		stop
	# 막힘 확인(10틱마다): 거의 못 움직였으면 방향을 바꾸고 점프
	set {_cv} to {_m}.getVelocity()
	set {_vy} to {_cv}.getY()
	if mod({_tk}, 10) is 0:
		set {_lst} to {-evlast::%{_id}%}
		if distance between {_lst} and {_l} < 0.4:
			set {-evsign::%{_id}%} to 0 - {_sg}
			set {_og} to {_m}.isOnGround()
			if {_og} is true:
				set {_vy} to 0.42
		set {-evlast::%{_id}%} to {_l}
	{_m}.setVelocity(vector({_mx} * 0.22, {_vy}, {_mz} * 0.22))

every tick:
	loop {-evd::*}:
		set {_id} to loop-index
		set {_m} to loop-value
		set {_v} to {_m}.isValid()
		if {_v} is true:
			evdTick({_id}, {_m})
		else:
			# 죽었다: 3초 뒤 같은 자리에 다시 나온다
			if {-evdead::%{_id}%} is not set:
				set {-evdead::%{_id}%} to now
			else:
				if difference between {-evdead::%{_id}%} and now is greater than 3 seconds:
					add {_id} to {_rs::*}
	loop {_rs::*}:
		set {_old} to loop-value
		set {_hm} to {-evhome::%{_old}%}
		set {_sk} to {-evskin::%{_old}%}
		set {_mh2} to {-evmh::%{_old}%}
		evdForget({_old})
		set {_nid2} to evdSpawn({_hm}, {_sk}, {_mh2})

# 첫 피해를 받은 시각을 기록한다(TTK 측정 시작)
on damage:
	if isEvDummy(victim) is true:
		set {_vid} to "%uuid of victim%"
		if {-evt0::%{_vid}%} is not set:
			set {_nw} to now
			set {-evt0::%{_vid}%} to {_nw}.getTimestamp()

on death:
	set {_e} to victim
	if isEvDummy({_e}) is not true:
		stop
	clear drops
	set {_eid} to "%uuid of {_e}%"
	set {_t0} to {-evt0::%{_eid}%}
	if {_t0} is set:
		set {_nw2} to now
		set {_ms} to {_nw2}.getTimestamp() - {_t0}
		set {_sec} to round({_ms} / 100) / 10
		loop all players in radius 40 around {_e}:
			send "&e연습 더미를 &f%{_sec}%초&e 만에 처치했습니다." to loop-player

on load:
	loop all entities:
		set {_e} to loop-entity
		if isEvDummy({_e}) is true:
			{_e}.remove()

on unload:
	loop {-evd::*}:
		loop-value.remove()
