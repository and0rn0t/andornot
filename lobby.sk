# [lobby.sk] 로비 규칙: 로비 근처 PvP 금지, 훈련장 위치, 훈련장 이동 NPC.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수: {gamecfg::loc::training::world|x|y|z|yaw|pitch}(훈련장 위치, 저장 변수. gameend.sk 의 gcSaveLoc/gcLoadLoc 로 읽고 쓴다)
# 로비 PvP 금지: 로비 위치(관리자 메뉴 "로비 위치 설정")에서 lobbyPvpRadius() 칸 안에 공격자나 피해자가 있으면 플레이어끼리의 피해를 취소한다(같은 월드일 때만).
#   - 진행 중인 게임의 참가자끼리는 막지 않는다(게임 월드가 로비 월드와 같아도 게임이 돌아가게).
#   - 로비 위치가 저장돼 있지 않으면 막지 않는다. 낙사/몹 피해 등 플레이어끼리가 아닌 피해는 막지 않는다.
#   - 피해를 주지 않는 기절/끌어당기기 같은 스킬 효과는 이 규칙으로 못 막는다(필요하면 스킬 쪽에서 따로 막아야 한다).
# 훈련장 NPC 의 스킨은 trainingNpcSkin()(지금 Dream). 이미 설치한 NPC 는 스킨이 안 바뀌니 치우고 다시 설치한다.
# /lobby 명령어도 같은 규칙으로 로비로 이동한다(게임 중인 참가자 제외).
# 로비 NPC: 같은 방식으로 세우고, 누르면 로비(관리자 메뉴 "로비 위치 설정")로 돌아온다(스코어보드 태그 lobbynpc, 스킨은 lobbyNpcSkin(), 지금은 기본 스킨).
# 훈련장 NPC: 관리자 메뉴 "훈련장 NPC 설치"가 서 있는 자리 앞에 마네킹 NPC 를 세운다(스코어보드 태그 trainingnpc). 우클릭/좌클릭하면 저장된 훈련장으로 이동한다.
#   게임 참가자는 게임 중에 못 쓴다. 이동은 다른 월드여도 되게 tpSafe(gameend.sk)를 쓴다.
# 미검증 문법: on damage with priority lowest, 마네킹 NPC(이름/설명/태그), PlayerInteractEntityEvent/PrePlayerAttackEntityEvent 로 NPC 클릭 받기, send action bar.

import:
	org.bukkit.entity.EntityType
	io.papermc.paper.datacomponent.item.ResolvableProfile
	org.bukkit.event.player.PlayerInteractEntityEvent
	io.papermc.paper.event.player.PrePlayerAttackEntityEvent
	net.kyori.adventure.text.serializer.gson.GsonComponentSerializer

# 로비 PvP 금지 반경(칸)
function lobbyPvpRadius() :: number:
	return 50

# 이 위치가 로비 PvP 금지 구역 안인지
function inLobbyZone(l: location, lobby: location) :: boolean:
	set {_w1} to {_l}.getWorld()
	set {_w2} to {_lobby}.getWorld()
	if {_w1} is not {_w2}:
		return false
	set {_d} to distance between {_l} and {_lobby}
	if {_d} <= lobbyPvpRadius():
		return true
	return false

# 플레이어끼리의 피해를 먼저 걸러 낸다(우선순위 가장 낮게: 취소된 이벤트는 다른 스크립트의 피해 보정이 처리하지 않는다).
on damage with priority lowest:
	if victim is not a player:
		stop
	if attacker is not a player:
		stop
	if attacker is victim:
		stop
	set {_a} to attacker
	set {_v} to victim
	# 진행 중인 게임의 참가자끼리는 막지 않는다
	if {-ingame} is true:
		if {-gplist::*} contains {_v}:
			if {-gplist::*} contains {_a}:
				stop
	set {_lobby} to gcLoadLoc("lobby")
	if {_lobby} is not set:
		if {gamecfg::lobby} is set:
			set {_lobby} to {gamecfg::lobby}
		else:
			stop
	set {_vl} to {_v}.getLocation()
	set {_al} to {_a}.getLocation()
	set {_hit} to false
	if inLobbyZone({_vl}, {_lobby}) is true:
		set {_hit} to true
	if inLobbyZone({_al}, {_lobby}) is true:
		set {_hit} to true
	if {_hit} is false:
		stop
	cancel event
	send action bar "&c로비 근처에서는 PvP 를 할 수 없습니다." to {_a}

# ===== 훈련장 =====
# 이 플레이어가 지금 로비/훈련장으로 이동하면 안 되는지. 이동 NPC 와 /lobby 가 이걸로 막는다.
#   - 게임 종료 연출 중(결과 무대, POTM 투표 포함)에는 참가자가 아니어도 모두 막는다.
#   - 그 밖에 진행 중인 게임에서는 참가자만 막는다.
function inGameNow(p: player) :: boolean:
	if {-gfinale} is true:
		return true
	if {-gover} is true:
		return true
	if {-ingame} is not true:
		return false
	if {-gplist::*} contains {_p}:
		return true
	return false

# 훈련장으로 이동(NPC 클릭). 게임 참가자는 게임 중에 못 쓴다.
function trainingGo(p: player):
	if {-kc::%{_p}'s uuid%} is set:
		stop
	if inGameNow({_p}) is true:
		send "&c게임 중에는 훈련장으로 이동할 수 없습니다." to {_p}
		stop
	set {_t} to gcLoadLoc("training")
	if {_t} is not set:
		send "&c훈련장 위치가 설정되지 않았습니다. 관리자에게 문의해 주십시오." to {_p}
		stop
	tpSafe({_p}, {_t})
	play sound "entity.enderman.teleport" with volume 0.7 and pitch 1.2 to {_p}
	send "&a훈련장으로 이동했습니다." to {_p}

# 훈련장 NPC 가 입을 스킨(마인크래프트 계정 이름)
function trainingNpcSkin() :: text:
	return "Dream"

# 로비 NPC 가 입을 스킨(계정 이름). 빈 글자면 기본 스킨.
function lobbyNpcSkin() :: text:
	return "Dream"

# NPC(마네킹)를 loc 에 yaw 방향으로 세운다: 움직이지 않고 무적이며 스코어보드 태그 tag 를 단다. 이름은 이름표(색 color, 굵게), desc 는 이름 아래 설명. skin 이 빈 글자가 아니면 그 계정의 스킨을 입힌다.
function npcSpawn(loc: location, yaw: number, tag: text, name: text, color: text, desc: text, skin: text):
	set {_m} to {_loc}.getWorld().spawnEntity({_loc}, EntityType.MANNEQUIN)
	if {_skin} is not "":
		{_m}.setProfile(ResolvableProfile.resolvableProfile().name({_skin}).build())
	{_m}.setImmovable(true)
	{_m}.setInvulnerable(true)
	{_m}.setSilent(true)
	{_m}.setRotation({_yaw}, 0)
	{_m}.addScoreboardTag({_tag})
	set {_nj} to "{""text"":""%{_name}%"",""color"":""%{_color}%"",""bold"":true}"
	set {_dj} to "{""text"":""%{_desc}%"",""color"":""gray""}"
	{_m}.customName(GsonComponentSerializer.gson().deserialize({_nj}))
	{_m}.setCustomNameVisible(true)
	{_m}.setDescription(GsonComponentSerializer.gson().deserialize({_dj}))

function trainingNpcSpawn(loc: location, yaw: number):
	npcSpawn({_loc}, {_yaw}, "trainingnpc", "훈련장", "green", "클릭해서 이동", trainingNpcSkin())

function lobbyNpcSpawn(loc: location, yaw: number):
	npcSpawn({_loc}, {_yaw}, "lobbynpc", "로비", "aqua", "클릭해서 이동", lobbyNpcSkin())

# 태그가 tag 인 NPC 를 모든 월드에서 지우고 지운 수를 돌려준다
function npcClear(tag: text) :: number:
	set {_n} to 0
	loop all entities:
		set {_e} to loop-entity
		set {_has} to {_e}.getScoreboardTags().contains({_tag})
		if {_has} is true:
			{_e}.remove()
			add 1 to {_n}
	return {_n}

function trainingNpcClear() :: number:
	return npcClear("trainingnpc")

function lobbyNpcClear() :: number:
	return npcClear("lobbynpc")

# 로비로 이동(로비 NPC 클릭). 게임 참가자는 게임 중에 못 쓴다.
function lobbyGo(p: player):
	if {-kc::%{_p}'s uuid%} is set:
		stop
	if inGameNow({_p}) is true:
		send "&c게임 중에는 로비로 이동할 수 없습니다." to {_p}
		stop
	tpSafe({_p}, gameLobbyLoc())
	play sound "entity.enderman.teleport" with volume 0.7 and pitch 1.2 to {_p}
	send "&a로비로 이동했습니다." to {_p}

# NPC 클릭 처리: 훈련장/로비 NPC 이면 해당 이동을 하고 true
function npcClick(p: player, e: entity) :: boolean:
	set {_t} to {_e}.getScoreboardTags().contains("trainingnpc")
	if {_t} is true:
		trainingGo({_p})
		return true
	set {_l} to {_e}.getScoreboardTags().contains("lobbynpc")
	if {_l} is true:
		lobbyGo({_p})
		return true
	return false

# 우클릭
on PlayerInteractEntityEvent:
	if event.getHand().name() is not "HAND":
		stop
	set {_e} to event.getRightClicked()
	if npcClick(event.getPlayer(), {_e}) is true:
		event.setCancelled(true)

# 좌클릭(공격 직전 이벤트)
on PrePlayerAttackEntityEvent:
	set {_e} to event.getAttacked()
	if npcClick(event.getPlayer(), {_e}) is true:
		event.setCancelled(true)

# /lobby: 로비로 돌아온다(게임 중인 참가자는 못 씀. 로비 NPC 와 같은 규칙)
command /lobby:
	description: 로비로 이동
	executable by: players
	trigger:
		lobbyGo(player)
