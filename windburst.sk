# [windburst.sk] 연막탄(돌풍구 아이템) 스킬(우클릭 투척, 쿨 30초): 맞은 자리에 10초간 지속되는 연막(반경 11칸)이 생기고, 지속이 끝나면 2초에 걸쳐 서서히 사라진다.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수: {-wbcd}(쿨타임 종료 시각), {-wbball::눈덩이uuid}(우리가 던진 연막탄 표시), {-skillitems::wind_charge}
# 던지기: 돌풍구 모양 아이템을 단 눈덩이를 던진다(진짜 돌풍구를 쓰면 넉백/폭발이 생겨서 안 씀). 어디든 맞으면(땅/벽/엔티티) 그 자리에 연막을 만든다.
# 연막은 시야를 가리는 파티클 연출뿐이다(실명 효과는 없음, 사용자 요청으로 삭제).
# 파티클: 흰색 구름(CLOUD)을 쓴다. 한 번 호출에 여러 개를 가우시안 분포로 뿌려서(count, offset) 호출 수를 줄이고 반경 전체를 촘촘히 덮는다.
#   중심 + 위/아래/동서남북 5곳에 뿌려서 반경이 고르게 채워진다. 2틱마다 뿌리고, 지속이 끝나면 마지막 2초(20스텝 중 10스텝) 동안 양을 줄여 서서히 사라진다.
#   흰 연기 느낌의 CAMPFIRE_SIGNAL_SMOKE 도 조금 섞어 오래 남는 연기를 만든다. 양은 smokeDensity() 의 숫자로 조절한다.
#   플레이어 눈 주변에는 따로 더 뿌려서 화면이 확실히 가려지게 한다.
# 미검증: 눈덩이 setItem(Material.WIND_CHARGE), "wind charge" 별칭, 파티클 CLOUD/CAMPFIRE_SIGNAL_SMOKE 호출.

import:
	org.bukkit.Particle
	org.bukkit.Material
	org.bukkit.inventory.ItemStack

on load:
	set {-skillitems::wind_charge} to wind charge

function smokeRadius() :: number:
	return 11

# 지속 시간(틱). 10초 = 200틱. 끝난 뒤 smokeFadeTicks 동안 서서히 사라진다.
function smokeTicks() :: number:
	return 200

function smokeFadeTicks() :: number:
	return 40

# 한 번(2틱)에 뿌리는 구름 양의 기준. 느리면 이 숫자를 줄인다.
function smokeDensity() :: number:
	return 220

# 연막 파티클 한 번 뿌리기. f = 0~1 (페이드 아웃 배율)
function smokeStep(center: location, f: number):
	set {_w} to {_center}.getWorld()
	set {_d} to smokeDensity()
	set {_n} to floor({_d} * {_f})
	if {_n} < 1:
		stop
	set {_m} to floor({_n} * 0.6)
	set {_s} to floor({_n} / 8)
	# 중심은 넓게(표준편차 4), 위/아래/동서남북 5곳은 좁게(2.5)
	{_w}.spawnParticle(Particle.CLOUD, {_center}, {_n}, 4, 3.5, 4, 0)
	set {_a} to {_center} ~ vector(5.5, 0, 0)
	{_w}.spawnParticle(Particle.CLOUD, {_a}, {_m}, 2.5, 2.5, 2.5, 0)
	set {_a} to {_center} ~ vector(-5.5, 0, 0)
	{_w}.spawnParticle(Particle.CLOUD, {_a}, {_m}, 2.5, 2.5, 2.5, 0)
	set {_a} to {_center} ~ vector(0, 0, 5.5)
	{_w}.spawnParticle(Particle.CLOUD, {_a}, {_m}, 2.5, 2.5, 2.5, 0)
	set {_a} to {_center} ~ vector(0, 0, -5.5)
	{_w}.spawnParticle(Particle.CLOUD, {_a}, {_m}, 2.5, 2.5, 2.5, 0)
	set {_a} to {_center} ~ vector(0, 5, 0)
	{_w}.spawnParticle(Particle.CLOUD, {_a}, {_m}, 2.5, 2.5, 2.5, 0)
	set {_a} to {_center} ~ vector(0, -3, 0)
	{_w}.spawnParticle(Particle.CLOUD, {_a}, {_m}, 2.5, 2.5, 2.5, 0)
	# 오래 남는 흰 연기를 조금
	{_w}.spawnParticle(Particle.CAMPFIRE_SIGNAL_SMOKE, {_center}, {_s}, 4.5, 3.5, 4.5, 0)

# 연막 안 플레이어 눈 주변(1.5칸)에 구름을 촘촘히 뿌려 화면을 가린다
function smokeAround(p: player, f: number):
	set {_eye} to {_p}.getEyeLocation()
	set {_c} to floor(70 * {_f})
	if {_c} < 1:
		stop
	{_eye}.getWorld().spawnParticle(Particle.CLOUD, {_eye}, {_c}, 1.3, 1.3, 1.3, 0)

function smokeCloud(center: location):
	set {_r} to smokeRadius()
	set {_hold} to smokeTicks() / 2
	set {_fade} to smokeFadeTicks() / 2
	set {_total} to {_hold} + {_fade}
	set {_i} to 0
	while {_i} < {_total}:
		# 유지 구간은 100%, 마지막 fade 구간은 1에서 0 으로 줄어든다
		set {_f} to 1
		if {_i} >= {_hold}:
			set {_f} to ({_total} - {_i}) / {_fade}
		smokeStep({_center}, {_f})
		loop all players in radius {_r} around {_center}:
			smokeAround(loop-player, {_f})
		wait 2 ticks
		add 1 to {_i}

on rightclick:
	if skillHand(player, wind charge) is false:
		stop
	cancel event
	set {_id} to "%player's uuid%"
	if {-wbcd::%{_id}%} is set:
		if {-wbcd::%{_id}%} > now:
			stop
	set {-wbcd::%{_id}%} to now + 30 seconds
	set item cooldown of wind charge for player to 30 seconds
	set {_p} to player
	set {_eye} to {_p}.getEyeLocation()
	set {_dir} to {_eye}.getDirection()
	set {_vel} to {_dir} * 1.4
	spawn a snowball at {_eye}:
		set {_b} to event-entity
		{_b}.setShooter({_p})
		{_b}.setItem(new ItemStack(Material.WIND_CHARGE))
		set velocity of event-entity to {_vel}
		set {-wbball::%uuid of event-entity%} to true
	play sound "entity.wind_charge.throw" with volume 1 and pitch 1 at {_p}

# 우리가 던진 돌풍구가 어딘가에 맞으면 그 자리에 연막을 만든다
on projectile hit:
	if {-wbball::%uuid of projectile%} is set:
		delete {-wbball::%uuid of projectile%}
		set {_l} to location of projectile
		delete projectile
		play sound "entity.generic.explode" with volume 0.6 and pitch 1.6 at {_l}
		smokeCloud({_l})

on join:
	delete {-wbcd::%player's uuid%}
