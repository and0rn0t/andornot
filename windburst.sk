# [windburst.sk] 돌풍구(연막탄) 스킬(우클릭 투척, 쿨 18초): 맞은 자리에 5초간 지속되는 연막(반경 15칸)이 생기고 연막 안의 플레이어는 실명(나오면 풀림). 피아 구분 없음.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수: {-wbcd}(쿨타임 종료 시각), {-wbball::눈덩이uuid}(우리가 던진 돌풍구 표시), {-skillitems::wind_charge}
# 던지기: 돌풍구 모양 아이템을 단 눈덩이를 던진다(진짜 돌풍구를 쓰면 넉백/폭발이 생겨서 안 씀). 어디든 맞으면(땅/벽/엔티티) 그 자리에 연막을 만든다.
# 연막: 2틱마다 반경 안 무작위 위치에 짙은 연기 파티클을 뿌리고, 반경 안의 모든 플레이어에게 실명 8틱을 갱신한다(나가면 최대 몇 틱 안에 풀림 + 즉시 제거).
#   반경은 smokeRadius(), 지속은 smokeTicks() 에서 고친다. 연막 안에서 기절(실명 포함)이 걸려 있으면 나가도 실명은 지우지 않는다.
# 미검증: 눈덩이 setItem(Material.WIND_CHARGE), "wind charge" 별칭, 파티클 LARGE_SMOKE, 반경 안 플레이어 루프.

import:
	org.bukkit.Particle
	org.bukkit.Material
	org.bukkit.inventory.ItemStack

on load:
	set {-skillitems::wind_charge} to wind charge

function smokeRadius() :: number:
	return 15

# 지속 시간(틱). 5초 = 100틱
function smokeTicks() :: number:
	return 100

# 연기 파티클을 반경 안 무작위 위치 n 곳에 뿌린다.
function smokePuff(center: location, n: number):
	set {_r} to smokeRadius()
	set {_w} to {_center}.getWorld()
	loop {_n} times:
		set {_x} to random number between 0 - {_r} and {_r}
		set {_y} to random number between 0 - {_r} and {_r}
		set {_z} to random number between 0 - {_r} and {_r}
		if ({_x} * {_x} + {_y} * {_y} + {_z} * {_z}) <= ({_r} * {_r}):
			set {_l} to {_center} ~ vector({_x}, {_y}, {_z})
			{_w}.spawnParticle(Particle.LARGE_SMOKE, {_l}, 1, 0, 0, 0, 0)

function smokeCloud(center: location):
	set {_r} to smokeRadius()
	set {_steps} to smokeTicks() / 2
	set {_i} to 0
	while {_i} < {_steps}:
		delete {_now::*}
		loop all players in radius {_r} around {_center}:
			set {_u} to "%uuid of loop-player%"
			set {_now::%{_u}%} to loop-player
			apply blindness potion of tier 1 without any particles whilst hiding the potion icon to loop-player for 8 ticks replacing the existing effect
		# 방금까지 안에 있었는데 나간 플레이어는 실명을 바로 푼다
		loop {_prev::*}:
			set {_k} to loop-index
			if {_now::%{_k}%} is not set:
				set {_pp} to {_prev::%{_k}%}
				if isStunned({_pp}) is false:
					remove blindness from {_pp}
		delete {_prev::*}
		set {_prev::*} to {_now::*}
		smokePuff({_center}, 40)
		wait 2 ticks
		add 1 to {_i}
	# 연막이 사라지면 남은 실명을 푼다
	loop {_prev::*}:
		set {_k} to loop-index
		set {_pp} to {_prev::%{_k}%}
		if isStunned({_pp}) is false:
			remove blindness from {_pp}

on rightclick:
	if skillHand(player, wind charge) is false:
		stop
	cancel event
	set {_id} to "%player's uuid%"
	if {-wbcd::%{_id}%} is set:
		if {-wbcd::%{_id}%} > now:
			stop
	set {-wbcd::%{_id}%} to now + 18 seconds
	set item cooldown of wind charge for player to 18 seconds
	set {_p} to player
	set {_eye} to {_p}.getEyeLocation()
	set {_dir} to {_eye}.getDirection()
	set {_vel} to {_dir} * 1.4
	spawn a snowball at {_eye}:
		set {_b} to event-entity
		{_b}.setShooter({_p})
		{_b}.setItem(new ItemStack(Material.WIND_CHARGE))
		set velocity of event-entity to {_vel}
		set {-wbball::%uuid of event-entity%} to true
	play sound "entity.wind_charge.throw" with volume 1 and pitch 1 at {_p}

# 우리가 던진 돌풍구가 어딘가에 맞으면 그 자리에 연막을 만든다
on projectile hit:
	if {-wbball::%uuid of projectile%} is set:
		delete {-wbball::%uuid of projectile%}
		set {_l} to location of projectile
		delete projectile
		play sound "entity.generic.explode" with volume 0.6 and pitch 1.6 at {_l}
		smokeCloud({_l})

on join:
	delete {-wbcd::%player's uuid%}
