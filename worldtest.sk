# [worldtest.sk] 멀티월드 테스트 명령(관리자 전용): 월드 만들기/불러오기, 월드 이동, 월드 목록, 저장된 로비/결과 무대 위치 확인.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수: 없음(저장된 위치 {gamecfg::lobby}, {gamecfg::stage} 는 읽기만 한다). 월드 생성/이동은 Bukkit API 를 skript-reflect 로 직접 부른다.
# 명령: /worldtest list | create <이름> | tp <이름> | info
#   list          불러온 월드 목록
#   create <이름>  그 이름의 월드를 만들거나(없으면 새로 생성), 폴더가 있으면 불러온다. 생성 중 서버가 잠깐 멈출 수 있다.
#   tp <이름>      불러온 월드의 스폰으로 이동
#   info          저장된 로비 위치/결과 무대 위치가 어느 월드의 어느 좌표인지 보여 준다. 재시작 뒤에 값이 비어 있으면 월드가 변수 로딩 시점에 없었다는 뜻.
# 월드 생성은 같은 이름이 이미 불러와져 있으면 그 월드를 돌려준다. 서버를 다시 켜도 월드는 자동으로 올라오지 않을 수 있으니(플러그인 없이 만든 경우) 그때는 create 를 다시 한다.
# 미검증: Bukkit.createWorld(new WorldCreator(이름)) 호출, 변수에서 월드가 없는 위치가 비어 로딩되는지.

import:
	org.bukkit.Bukkit
	org.bukkit.WorldCreator

function wtLocText(l: location) :: text:
	set {_w} to {_l}.getWorld()
	set {_wn} to {_w}.getName()
	set {_x} to round({_l}.getX() * 10) / 10
	set {_y} to round({_l}.getY() * 10) / 10
	set {_z} to round({_l}.getZ() * 10) / 10
	set {_yaw} to round({_l}.getYaw())
	return "&f%{_wn}% &7(%{_x}%, %{_y}%, %{_z}%) 방향 %{_yaw}%"

command /worldtest [<text>] [<text>]:
	description: 멀티월드 테스트 (관리자 전용)
	executable by: players
	trigger:
		if player is not op:
			send "&c관리자만 사용할 수 있습니다."
			stop
		set {_sub} to arg-1
		set {_n} to arg-2
		if {_sub} is not set:
			send "&7사용법: /worldtest list | create <이름> | tp <이름> | info"
			stop
		if {_sub} is "list":
			send "&6[월드 테스트] &7불러온 월드 목록"
			loop all worlds:
				set {_w} to loop-world
				set {_wn} to {_w}.getName()
				send "&7- &f%{_wn}%"
			stop
		if {_sub} is "create":
			if {_n} is not set:
				send "&c월드 이름을 입력해 주십시오. 예: /worldtest create lobby"
				stop
			set {_old} to Bukkit.getWorld({_n})
			if {_old} is set:
				send "&6[월드 테스트] &f%{_n}% &7월드는 이미 불러와져 있습니다."
				stop
			send "&6[월드 테스트] &f%{_n}% &7월드를 만드는 중입니다. 잠시 서버가 멈출 수 있습니다."
			set {_w} to Bukkit.createWorld(new WorldCreator({_n}))
			if {_w} is not set:
				send "&c월드를 만들지 못했습니다. 콘솔 로그를 확인해 주십시오."
				stop
			send "&a월드를 불러왔습니다. /worldtest tp %{_n}% 로 이동할 수 있습니다."
			stop
		if {_sub} is "tp":
			if {_n} is not set:
				send "&c월드 이름을 입력해 주십시오. 예: /worldtest tp lobby"
				stop
			set {_w} to Bukkit.getWorld({_n})
			if {_w} is not set:
				send "&c불러온 월드가 아닙니다. /worldtest list 로 확인해 주십시오."
				stop
			teleport player to {_w}.getSpawnLocation()
			send "&a%{_n}% 월드로 이동했습니다."
			stop
		if {_sub} is "info":
			send "&6[월드 테스트] &7저장된 위치"
			if {gamecfg::lobby} is set:
				set {_t1} to wtLocText({gamecfg::lobby})
				send "&7로비: %{_t1}%"
			else:
				send "&7로비: &c저장 없음(또는 월드를 못 불러와 비어 있음)"
			if {gamecfg::stage} is set:
				set {_t2} to wtLocText({gamecfg::stage})
				send "&7결과 무대: %{_t2}%"
			else:
				send "&7결과 무대: &c저장 없음(또는 월드를 못 불러와 비어 있음)"
			set {_cw} to player's world
			set {_cwn} to {_cw}.getName()
			send "&7지금 있는 월드: &f%{_cwn}%"
			stop
		send "&7사용법: /worldtest list | create <이름> | tp <이름> | info"
