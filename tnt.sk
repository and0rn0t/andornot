# [tnt.sk] TNT 스킬(우클릭 투척, 1초 뒤 폭발, 데미지/블럭 피해 없음, 폭발 범위 안의 모두(던진 사람 포함) 2초 기절). 쿨타임 12초
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수: {-tntcd}, {-tntowner}, {-skillitems::tnt} (기절은 skill_core.sk 의 stun() 함수와 {-stunend} 가 처리)
# 던진 TNT 는 진짜 점화된 TNT 엔티티(퓨즈 1초)라서 폭발의 근원이 TNT 이고, 폭발하면 바닐라가 TNT 를 제거한다.
# 폭발 이벤트(on explosion)를 취소해서 데미지/블럭 피해/넉백을 없애고, 같은 자리에서 소리/파티클과 기절만 직접 처리한다.
# 폭발 범위(반경)는 아래 tntRadius() 의 값 하나만 바꾸면 기절 범위, 폭발 이펙트, 경고 이펙트가 전부 같이 바뀐다. 날아가는 거리는 rightclick 의 speed 값(현재 1.5).
# 경고 이펙트(바닥 원판 + 범위 안 무작위 dust): TNT 가 착지한 뒤부터 폭발할 때까지 4틱마다 표시한다. 공중에서는 안 나온다.
# 폭발 이펙트: 폭발 범위 안쪽을 large explosion 으로 2칸 간격으로 채운다(범위 끝에서 파티클 크기만큼 닿도록 반경-1 까지만 배치).

import:
	org.bukkit.Particle
	org.bukkit.Color
	org.bukkit.Particle$DustOptions as DustOptions

on load:
	set {-skillitems::tnt} to tnt
	# 밝은 빨강 dust 옵션(색 RGB, 크기). skript 의 'red dust' 는 어두운 빨강이라 skript-reflect 로 직접 만든다.
	set {-tntdust} to new DustOptions(Color.fromRGB(255, 30, 30), 1.0)

# 폭발 범위(반경, 칸). 기절/이펙트/경고가 모두 이 값을 쓴다.
function tntRadius() :: number:
	return 4

# 밝은 빨강 dust 한 개를 loc 에 띄운다.
function tntDust(loc: location):
	{_loc}.getWorld().spawnParticle(Particle.DUST, {_loc}, 1, 0, 0, 0, 0, {-tntdust})

# 경고 이펙트: 폭발 범위(구) 안의 무작위 위치에 붉은 dust 를 흩뿌린다.
function tntWarn(loc: location):
	set {_r} to tntRadius()
	loop 25 times:
		set {_d} to random number between 0 and {_r}
		set {_yaw} to random number between 0 and 360
		set {_pitch} to random number between -90 and 90
		set {_p} to {_loc} ~ spherical vector {_d}, {_yaw}, {_pitch}
		tntDust({_p})

# 바닥 표시: TNT 가 착지한 자리의 바닥에, 폭발 범위만큼 밝은 빨강 dust 를 원판(동심원)으로 깐다.
function tntGroundMark(loc: location):
	set {_r} to tntRadius()
	set {_base} to {_loc} ~ vector(0, 0.1, 0)
	set {_ring} to {_r}
	# 바깥 원(= 폭발 범위 경계)부터 0.5칸씩 안쪽으로 빽빽하게 채운다(장판 느낌). 반지름이 클수록 점을 더 찍는다.
	while {_ring} > 0:
		set {_cnt} to floor({_ring} * 14)
		loop {_cnt} times:
			set {_p} to {_base} ~ spherical vector {_ring}, (loop-number * 360 / {_cnt}), 0
			tntDust({_p})
		subtract 0.5 from {_ring}

# owner: 던진 사람 uuid(텍스트). 던진 사람 본인도 범위 안이면 기절한다.
function tntBlast(owner: text, loc: location):
	set {_r} to tntRadius()
	play sound "entity.generic.explode" with volume 1 and pitch 1.2 at {_loc}
	play 1 explosion emitter at {_loc} in radius of 100
	# 폭발 범위 안쪽을 2칸 간격 격자로 large explosion 을 깔아서 이펙트 크기를 범위에 맞춘다.
	set {_n} to ceil({_r} / 2)
	set {_m} to {_n} * 2 + 1
	loop {_m} * {_m} * {_m} times:
		set {_k} to loop-number - 1
		set {_x} to (mod({_k}, {_m}) - {_n}) * 2
		set {_y} to (mod(floor({_k} / {_m}), {_m}) - {_n}) * 2
		set {_z} to (floor({_k} / ({_m} * {_m})) - {_n}) * 2
		if ({_x} * {_x} + {_y} * {_y} + {_z} * {_z}) <= (({_r} - 1) * ({_r} - 1)):
			set {_p} to {_loc} ~ vector({_x}, {_y}, {_z})
			play 1 large explosion at {_p} in radius of 100
	loop all players in radius {_r} around {_loc}:
		stun(loop-player, "tnt_%{_owner}%", 2 seconds)

on rightclick:
	if skillHand(player, tnt) is false:
		stop
	cancel event
	if {-tntcd::%player's uuid%} is set:
		if {-tntcd::%player's uuid%} > now:
			stop
	set {-tntcd::%player's uuid%} to now + 12 seconds
	set item cooldown of tnt for player to 12 seconds
	set {_p} to player
	# shoot 뒤의 last spawned entity 가 TNT 가 아니라 다른 엔티티(텍스트 디스플레이)를 가리켜서 spawn 섹션의 event-entity 로 직접 잡는다.
	set {_eye} to {_p}.getEyeLocation()
	set {_dir} to {_eye}.getDirection()
	set {_vel} to {_dir} * 1.5
	spawn primed tnt at {_eye}:
		set {_t} to event-entity
		set velocity of event-entity to {_vel}
		# 던진 사람을 기록해 두고 on explosion 에서 읽는다. 퓨즈 40틱 = 2초 뒤 바닐라가 직접 폭발시킴.
		set {-tntowner::%uuid of event-entity%} to "%uuid of {_p}%"
		{_t}.setFuseTicks(40)
	play sound "entity.tnt.primed" with volume 1 and pitch 1 at {_p}
	# 경고 이펙트: TNT 가 살아있는 동안 4틱마다 확인해서, 착지한 뒤에만 표시한다(최대 25번 = 100틱 안전장치).
	set {_n} to 0
	while {_t} is alive:
		add 1 to {_n}
		if {_n} > 25:
			stop
		# 모든 경고 이펙트는 TNT 가 착지한 뒤에만 나온다.
		if {_t} is on ground:
			set {_wl} to location of {_t}
			tntGroundMark({_wl})
			tntWarn({_wl})
		wait 4 ticks

# 우리가 던진 TNT 만 처리(다른 TNT 는 건드리지 않음). 이벤트를 취소하면 데미지/블럭 피해/넉백이 없다.
on explosion:
	set {_e} to event-entity
	if {_e} is a primed tnt:
		set {_eid} to uuid of {_e}
		if {-tntowner::%{_eid}%} is set:
			cancel event
			set {_owner} to {-tntowner::%{_eid}%}
			delete {-tntowner::%{_eid}%}
			set {_loc} to location of {_e}
			tntBlast({_owner}, {_loc})
