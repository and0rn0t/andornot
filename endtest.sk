# [endtest.sk] 종료 연출 테스트(관리자 전용): /endtest 로 게임 없이 종료 연출(gameend.sk)을 바로 본다.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 승리 팀 = 실행한 관리자(본인 스킨/이름) + 더미2 + 더미3(가짜 참가자, 스킨/아이템 구성은 실행자 것을 빌림). 점수/티어 기록은 하지 않는다(gameend.sk 가 {-gtest} 일 때 ratingApply/gmRecord 를 건너뜀).
# 이 파일이 쓰는 변수(RAM): {-gtest}(테스트 중), {-gtestids::*}(결과에 보일 참가자 id), {-gtestteam}(실행자의 원래 {-team} 값 백업)
# 끝나면(정상 종료, /gamestop) gtestEnd() 가 임시 상태를 지운다. 게임/종료 연출 중에는 실행되지 않는다.
# 미검증: 임시 상태만으로 gameFinale 이 끝까지 도는지(결과 표 항목, 로비 이동).

function gtestEnd():
	loop {-gtestids::*}:
		delete {-gk::%loop-value%}
		delete {-gd::%loop-value%}
		delete {-ga::%loop-value%}
		delete {-gdmg::%loop-value%}
		delete {-gpteam::%loop-value%}
		delete {-gpname::%loop-value%}
	loop all players:
		if {-gtestteam::%uuid of loop-player%} is set:
			if "%{-gtestteam::%uuid of loop-player%}%" is "none":
				delete {-team::%uuid of loop-player%}
			else:
				set {-team::%uuid of loop-player%} to "%{-gtestteam::%uuid of loop-player%}%"
	delete {-gtestteam::*}
	delete {-gtestids::*}
	delete {-gfwinp::*}
	delete {-gfwinid::*}
	delete {-gteamlist::*}
	delete {-gscore::*}
	delete {-gplist::*}
	delete {-gname::*}
	delete {-gteams}
	delete {-gmode}
	delete {-gtest}

command /endtest:
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	description: 종료 연출 테스트 (관리자 전용)
	trigger:
		if sender is not a player:
			send "플레이어만 사용할 수 있습니다."
			stop
		if player is not op:
			send "&c관리자만 사용할 수 있습니다."
			stop
		if {-ingame} is true:
			send "&c게임 중에는 쓸 수 없어요."
			stop
		if {-gfinale} is true:
			send "&c종료 연출이 이미 진행 중이에요."
			stop
		if {-gstarting} is true:
			send "&c시작 연출 중에는 쓸 수 없어요."
			stop
		set {_id} to "%uuid of player%"
		set {-gtest} to true
		set {-gmode} to "bounty"
		set {-gteams} to 2
		set {-gtarget} to 100
		delete {-gplist::*}
		add player to {-gplist::*}
		set {-gtestteam::%{_id}%} to "none"
		if {-team::%{_id}%} is set:
			set {-gtestteam::%{_id}%} to "%{-team::%{_id}%}%"
		set {-team::%{_id}%} to "1팀"
		delete {-gteamlist::*}
		delete {-gscore::*}
		delete {-gname::*}
		set {-gteamlist::1} to "1팀"
		set {-gteamlist::2} to "2팀"
		set {-gname::1팀} to "1팀"
		set {-gname::2팀} to "2팀"
		set {-gscore::1팀} to 100
		set {-gscore::2팀} to 64
		delete {-gtestids::*}
		add {_id} to {-gtestids::*}
		add "test_2" to {-gtestids::*}
		add "test_3" to {-gtestids::*}
		set {-gpname::%{_id}%} to name of player
		set {-gpname::test_2} to "더미2"
		set {-gpname::test_3} to "더미3"
		set {_i} to 0
		loop {-gtestids::*}:
			add 1 to {_i}
			set {-gpteam::%loop-value%} to "1팀"
			set {-gk::%loop-value%} to 14 - {_i} * 3
			set {-gd::%loop-value%} to {_i}
			set {-ga::%loop-value%} to {_i} + 1
			set {-gdmg::%loop-value%} to 40 - {_i} * 7
		delete {-gfwinp::*}
		delete {-gfwinid::*}
		loop 3 times:
			add player to {-gfwinp::*}
		add {_id} to {-gfwinid::*}
		add "test_2" to {-gfwinid::*}
		add "test_3" to {-gfwinid::*}
		set {-gwinner} to "1팀"
		set {-gover} to true
		send "&7종료 연출 테스트를 시작해요. (/gamestop 으로 중단)"
		gameFinale()

on load:
	delete {-gtest}
