# [hats.sk] 치장 아이템 지급 명령어(op 전용): /치장 [이름|정장|전체]. 치장 = 모자 5종 + 정장 3벌 + 베레 멜빵바지 세트.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 모델은 리소스팩(resourcepack/mck_pack/assets/mck/)의 에셋. 종이에 item_model 과 equippable 을 붙여 만든다(방어력 없음, 스택 1).
#   id                 이름              모델(item_model)              칸      비고
#   laurel             월계관            mck:hat/laurel                머리
#   bounty             바운티 모자       mck:hat/bounty                머리
#   mini_crown         미니 왕관         mck:hat/mini_crown            머리
#   knockout_headgear  녹아웃 헤드기어   mck:hat/knockout_headgear     머리
#   alien_glasses      외계인 선글라스   mck:hat/alien_glasses         머리
#   suit_jacket        남성 정장 상의    mck:suit_male/jacket          가슴    착용 모습 = 장비 에셋 mck:suit_male(assets/mck/equipment/suit_male.json)
#   suit_trousers      남성 정장 하의    mck:suit_male/trousers        다리    〃
#   suit_shoes         남성 정장 구두    mck:suit_male/shoes           발      〃
#   red_beret_overalls 빨간 베레 멜빵바지 mck:outfit/red_beret_overalls 머리  블록벤치(.bbmodel)에서 변환한 모델(요소 34개, 세로 -5~30칸의 전신 인형). 머리에 씌우면 어떻게 보일지 미검증 -> 안 맞으면 모델의 display.head 조정 필요
# 정장 상의는 가슴 칸이라 진짜 겉날개와 같이 못 입는다. 원본 README 의 glider(겉날개 없이 활강)는 넣지 않았다(게임의 낙하용 겉날개 규칙과 겹치지 않게). 필요하면 hatItem 에서 GLIDER 컴포넌트를 추가.
# 게임 시작/중간 참가 때 인벤토리를 비워도 치장은 남는다(hatClear, 판별은 hatIs: item_model 이 mck:hat/, mck:suit_male/, mck:outfit/ 로 시작). 아직 게임 시스템과 연결되지 않았다(치장 해금/상점/선택 UI 는 나중에).
# 새 치장을 추가하면: 리소스팩에 모델 넣기 -> hatIds/hatName/hatModel/hatSlot/hatParse 에 넣기 -> 새 네임스페이스 경로면 hatIs 에도 추가.
# 미검증: Paper 데이터 컴포넌트 ITEM_MODEL/EQUIPPABLE(assetId)/ITEM_NAME/MAX_STACK_SIZE 설정, 장비 에셋 착용 모습, 베레 멜빵바지 모델 표시.

import:
	io.papermc.paper.datacomponent.DataComponentTypes
	io.papermc.paper.datacomponent.item.Equippable
	net.kyori.adventure.key.Key
	net.kyori.adventure.text.serializer.gson.GsonComponentSerializer
	org.bukkit.Material
	org.bukkit.inventory.EquipmentSlot
	org.bukkit.inventory.ItemStack
	java.lang.Math

function hatIds() :: texts:
	return "laurel", "bounty", "mini_crown", "knockout_headgear", "alien_glasses", "suit_jacket", "suit_trousers", "suit_shoes" and "red_beret_overalls"

function hatName(id: text) :: text:
	if {_id} is "laurel":
		return "월계관"
	if {_id} is "bounty":
		return "바운티 모자"
	if {_id} is "mini_crown":
		return "미니 왕관"
	if {_id} is "knockout_headgear":
		return "녹아웃 헤드기어"
	if {_id} is "alien_glasses":
		return "외계인 선글라스"
	if {_id} is "suit_jacket":
		return "남성 정장 상의"
	if {_id} is "suit_trousers":
		return "남성 정장 하의"
	if {_id} is "suit_shoes":
		return "남성 정장 구두"
	if {_id} is "red_beret_overalls":
		return "빨간 베레 멜빵바지"
	return ""

# item_model 의 값(네임스페이스 mck)
function hatModel(id: text) :: text:
	if {_id} is "suit_jacket":
		return "suit_male/jacket"
	if {_id} is "suit_trousers":
		return "suit_male/trousers"
	if {_id} is "suit_shoes":
		return "suit_male/shoes"
	if {_id} is "red_beret_overalls":
		return "outfit/red_beret_overalls"
	return "hat/%{_id}%"

# 착용 칸: head/chest/legs/feet
function hatSlot(id: text) :: text:
	if {_id} is "suit_jacket":
		return "chest"
	if {_id} is "suit_trousers":
		return "legs"
	if {_id} is "suit_shoes":
		return "feet"
	return "head"

# 입력(한글 이름/영어 id/줄임말)을 id 로. 모르면 "".
function hatParse(s: text) :: text:
	loop "월계관", "laurel":
		if {_s} is loop-value:
			return "laurel"
	loop "바운티", "바운티모자", "bounty":
		if {_s} is loop-value:
			return "bounty"
	loop "왕관", "미니왕관", "mini_crown":
		if {_s} is loop-value:
			return "mini_crown"
	loop "헤드기어", "녹아웃", "녹아웃헤드기어", "knockout_headgear":
		if {_s} is loop-value:
			return "knockout_headgear"
	loop "선글라스", "외계인", "외계인선글라스", "alien_glasses":
		if {_s} is loop-value:
			return "alien_glasses"
	loop "상의", "재킷", "정장상의", "suit_jacket":
		if {_s} is loop-value:
			return "suit_jacket"
	loop "하의", "바지", "정장하의", "suit_trousers":
		if {_s} is loop-value:
			return "suit_trousers"
	loop "구두", "정장구두", "suit_shoes":
		if {_s} is loop-value:
			return "suit_shoes"
	loop "베레", "멜빵바지", "베레멜빵바지", "red_beret_overalls":
		if {_s} is loop-value:
			return "red_beret_overalls"
	return ""

function hatItem(id: text) :: itemstack:
	set {_st} to new ItemStack(Material.PAPER)
	{_st}.setData(DataComponentTypes.ITEM_MODEL, Key.key("mck", hatModel({_id})))
	set {_sl} to hatSlot({_id})
	if {_sl} is "chest":
		{_st}.setData(DataComponentTypes.EQUIPPABLE, Equippable.equippable(EquipmentSlot.CHEST).assetId(Key.key("mck", "suit_male")).build())
	else if {_sl} is "legs":
		{_st}.setData(DataComponentTypes.EQUIPPABLE, Equippable.equippable(EquipmentSlot.LEGS).assetId(Key.key("mck", "suit_male")).build())
	else if {_sl} is "feet":
		{_st}.setData(DataComponentTypes.EQUIPPABLE, Equippable.equippable(EquipmentSlot.FEET).assetId(Key.key("mck", "suit_male")).build())
	else:
		{_st}.setData(DataComponentTypes.EQUIPPABLE, Equippable.equippable(EquipmentSlot.HEAD).build())
	{_st}.setData(DataComponentTypes.ITEM_NAME, GsonComponentSerializer.gson().deserialize("{""text"":""%hatName({_id})%""}"))
	{_st}.setData(DataComponentTypes.MAX_STACK_SIZE, Math.toIntExact(Math.round(1)))
	return {_st}

# 치장 아이템인지(item_model 이 mck:hat/, mck:suit_male/, mck:outfit/ 로 시작하는지). 칸이 비었으면 false.
function hatIs(it: itemstack) :: boolean:
	if {_it} is not set:
		return false
	set {_k} to {_it}.getData(DataComponentTypes.ITEM_MODEL)
	if {_k} is not set:
		return false
	set {_ks} to {_k}.asString()
	if {_ks} starts with "mck:hat/":
		return true
	if {_ks} starts with "mck:suit_male/":
		return true
	if {_ks} starts with "mck:outfit/":
		return true
	return false

# 인벤토리를 비우되 치장(메인 인벤토리 0~35, 방어구 36~39, 왼손 40 어디에 있든)은 제자리에 남긴다.
# 게임 시작/중간 참가 때 getInventory().clear() 대신 쓴다(game.sk). 새로 비우는 코드를 만들면 이걸 쓸 것.
function hatClear(p: player):
	set {_inv} to {_p}.getInventory()
	loop integers from 0 to 40:
		set {_it} to {_inv}.getItem(loop-value)
		if {_it} is set:
			if hatIs({_it}) is false:
				{_inv}.setItem(loop-value, null)

command /치장 [<text>]:
	trigger:
		if player is not op:
			send "&c권한이 없습니다."
			stop
		if arg-1 is not set:
			send "&e사용법: /치장 <월계관|바운티|왕관|헤드기어|선글라스|상의|하의|구두|베레|정장|전체>"
			stop
		set {_n} to 0
		set {_all} to false
		if arg-1 is "전체":
			set {_all} to true
		if arg-1 is "all":
			set {_all} to true
		if {_all} is true:
			loop hatIds():
				player.getInventory().addItem(hatItem(loop-value))
				add 1 to {_n}
			send "&a치장 %{_n}%종을 지급했습니다."
			stop
		if arg-1 is "정장":
			loop "suit_jacket", "suit_trousers" and "suit_shoes":
				player.getInventory().addItem(hatItem(loop-value))
			send "&a남성 정장 3벌을 지급했습니다."
			stop
		set {_id} to hatParse(arg-1)
		if {_id} is "":
			send "&c알 수 없는 치장입니다. 월계관, 바운티, 왕관, 헤드기어, 선글라스, 상의, 하의, 구두, 베레, 정장, 전체 중에서 골라 주세요."
			stop
		player.getInventory().addItem(hatItem({_id}))
		send "&a%hatName({_id})%을(를) 지급했습니다."
