# [matchhistory.sk] 지난 매치 기록: 매치가 끝나면 결과(게임 결과창 내용)를 저장하고, 관리자가 등록한 독서대를 우클릭하면 지난 매치 목록 GUI 가 열린다.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수(저장): {matchcount}(지금까지 끝난 매치 수), {matchlog::번호::json}(그 매치의 결과창 내용 JSON, 종료 직후 POTM 까지 포함),
#   {matchlog::번호::mode|winner|map|rand|time|potm}(목록 설명용), {matchlog::번호::rv::uuid}/{matchlog::번호::rvn::uuid}(한 줄 리뷰/작성자 이름, 사람당 1개),
#   {matchshelf::월드_x_y_z}(등록된 독서대 블록, true)
# 이 파일이 쓰는 변수(RAM): {-mhgui::uuid}(GUI 열림), {-mhmap::uuid::칸}(칸 -> 매치 번호), {-mhpage::uuid}(현재 쪽, 0부터)
# 기록 시점: gameFinale 마지막 단계(gmRecord). /finaletest 테스트는 기록하지 않는다. 번호는 1부터, 100 미만은 MATCH 001 처럼 3자리로 표기(matchLabel).
# GUI: 독서대 우클릭 -> 4줄. 1~3줄 27칸 = 매치(최신이 먼저, 작성된 책), 4줄 1/9번 칸 = 이전/다음 쪽 종이(매치 28개 이상일 때만), 4줄 5번 칸 = 나가기(방벽).
# 책을 누르면 vanilla dialog(/dialog show)로 결과창을 띄우고, 한 줄 리뷰(40자)를 남길 수 있다(입력은 채팅: dialog 입력칸은 한글이 안 들어가서). 리뷰는 결과 아래에 표시된다.
# 관리자 메뉴 버튼: 독서대 등록/해제(바라보는 독서대 블록).
# 미검증: dialog JSON 필드(confirmation/plain_message/text 입력/dynamic/run_command), 작성된 책 아이템, targeted block, 독서대 우클릭 이벤트, 결과 JSON 을 dialog 본문에 그대로 넣기.

import:
	java.lang.Character
	org.bukkit.Bukkit
	net.kyori.adventure.text.serializer.gson.GsonComponentSerializer

# MATCH 012 형태 이름(100 미만은 3자리 0 채움)
function matchLabel(n: number) :: text:
	set {_i} to floor({_n})
	if {_i} < 10:
		return "MATCH 00%{_i}%"
	if {_i} < 100:
		return "MATCH 0%{_i}%"
	return "MATCH %{_i}%"

function mhCount() :: number:
	if {matchcount} is a number:
		return {matchcount}
	return 0

# 매치 끝에 결과를 저장한다(테스트는 저장 안 함). 결과창에 POTM 이 반영된 뒤에 부를 것.
function gmRecord():
	if {-gftest} is true:
		stop
	set {-gfinline} to true
	add 1 to {matchcount}
	set {_n} to floor({matchcount})
	set {matchlog::%{_n}%::json} to gfResultJson()
	delete {-gfinline}
	set {matchlog::%{_n}%::mode} to gcModeName({-gmode})
	set {matchlog::%{_n}%::winner} to gTeamLabel({-gwinner})
	set {matchlog::%{_n}%::map} to "%{-gworld}%"
	set {matchlog::%{_n}%::rand} to "%{-grandon}%"
	set {matchlog::%{_n}%::potm} to "%{-gpotmres}%"
	set {matchlog::%{_n}%::time} to now formatted as "yyyy-MM-dd HH:mm"

# 저장된 매치의 결과 + 리뷰(JSON)
function gmResultJson(n: number) :: text:
	set {_nlc} to "{""text"":""\n""}"
	set {_base} to {matchlog::%{_n}%::json}
	set {_ex} to "%{_base}%"
	set {_hd} to gfT("리뷰", "gold", false)
	set {_ex} to "%{_ex}%,%{_nlc}%,%{_nlc}%,%{_hd}%"
	set {_cnt} to 0
	loop {matchlog::%{_n}%::rv::*}:
		set {_nm} to {matchlog::%{_n}%::rvn::%loop-index%}
		set {_a} to gfT("%{_nm}%: ", "gray", false)
		set {_b} to gfT("%loop-value%", "white", false)
		set {_ex} to "%{_ex}%,%{_nlc}%,%{_a}%,%{_b}%"
		add 1 to {_cnt}
		if {_cnt} >= 10:
			stop loop
	if {_cnt} is 0:
		set {_e} to gfT("아직 리뷰가 없습니다", "dark_gray", false)
		set {_ex} to "%{_ex}%,%{_nlc}%,%{_e}%"
	return "{""text"":"""",""extra"":[%{_ex}%]}"

# 리뷰 문장 정리: 따옴표/역슬래시/줄바꿈 제거, 40자 제한
function gmCleanReview(t: text) :: text:
	set {_s} to {_t}
	set {_s} to {_s}.replace("""", "'")
	set {_s} to {_s}.replace("\", "/")
	set {_s} to {_s}.replace("%%", "")
	set {_s} to {_s}.trim()
	if {_s}.length() > 40:
		set {_s} to {_s}.substring(0, 40)
	return {_s}

# 매치 결과 dialog 를 띄운다(리뷰 입력칸 + 등록/닫기)
function gmDialog(p: player, n: number):
	set {_i} to floor({_n})
	if {matchlog::%{_i}%::json} is not set:
		send "&c그 매치 기록이 없습니다." to {_p}
		stop
	set {_uid} to "%{_p}'s uuid%"
	set {_old} to {matchlog::%{_i}%::rv::%{_uid}%}
	if {_old} is not set:
		set {_old} to ""
	set {_body} to gmResultJson({_i})
	set {_lbl} to matchLabel({_i})
	set {_q} to """"
	set {_cmd} to "matchreview %{_i}%"
	set {_d} to "{""type"":""minecraft:confirmation"",""title"":{""text"":""%{_lbl}%""},"
	set {_d} to "%{_d}%""can_close_with_escape"":true,"
	set {_d} to "%{_d}%""body"":[{""type"":""minecraft:plain_message"",""contents"":%{_body}%,""width"":420}],"
	set {_d} to "%{_d}%""yes"":{""label"":{""text"":""리뷰 작성 (채팅으로 입력)"",""color"":""green""},""action"":{""type"":""minecraft:run_command"",""command"":""%{_cmd}%""}},"
	set {_d} to "%{_d}%""no"":{""label"":{""text"":""닫기""}}}"
	set {_pn} to {_p}.getName()
	execute console command "dialog show %{_pn}% %{_d}%"

# 한글을 못 넣는 dialog 입력칸 대신 채팅으로 리뷰를 받는다: 이 명령(글 없이)을 부르면 다음 채팅 한 줄이 리뷰가 된다. 글을 같이 주면 바로 등록.
# 일반 플레이어가 결과 창 버튼으로 실행하므로 권한 제한을 두지 않는다.
command /matchreview <number> [<text>]:
	description: 지난 매치에 한 줄 리뷰를 남겨요 (매치 결과 창의 리뷰 작성 버튼이 쓰는 명령)
	executable by: players
	trigger:
		set {_n} to floor(arg-1)
		if {matchlog::%{_n}%::json} is not set:
			send "&c그 매치 기록이 없습니다."
			stop
		if arg-2 is not set:
			set {-mhawait::%player's uuid%} to {_n}
			send "&e채팅창에 한 줄 리뷰를 입력하십시오. &7(40자까지, 비우려면 &f-&7, 취소는 &f취소&7)"
			stop
		set {_t} to gmCleanReview(arg-2)
		set {_uid} to "%player's uuid%"
		if {_t} is "":
			delete {matchlog::%{_n}%::rv::%{_uid}%}
			delete {matchlog::%{_n}%::rvn::%{_uid}%}
			send "&7리뷰를 지웠습니다."
		else:
			set {matchlog::%{_n}%::rv::%{_uid}%} to {_t}
			set {matchlog::%{_n}%::rvn::%{_uid}%} to player's name
			send "&a리뷰를 남겼습니다."
		gmDialog(player, {_n})

# ===== 독서대 등록 =====
function mhShelfKey(b: block) :: text:
	set {_w} to {_b}.getWorld().getName()
	set {_x} to floor(x-coordinate of {_b})
	set {_y} to floor(y-coordinate of {_b})
	set {_z} to floor(z-coordinate of {_b})
	return "%{_w}%_%{_x}%_%{_y}%_%{_z}%"

# 독서대 위 안내 디스플레이("매치 기록 열람", 태그 mhlabel). 등록하면 띄우고 해제하면 치운다. 미검증: 위치(독서대 위 1.5칸), TextDisplay#text.
function mhLabelClear(b: block):
	set {_c} to {_b}.getLocation() ~ vector(0.5, 1.5, 0.5)
	loop all text displays:
		set {_t} to loop-entity
		if {_t} has scoreboard tag "mhlabel":
			if distance between {_t} and {_c} < 1.5:
				delete entity within {_t}

function mhLabelSpawn(b: block):
	mhLabelClear({_b})
	set {_c} to {_b}.getLocation() ~ vector(0.5, 1.5, 0.5)
	spawn a text display at {_c}:
		set {_d} to event-entity
		add "mhlabel" to scoreboard tags of event-entity
		set billboard of event-entity to center
	set {_js} to "{""text"":""매치 기록 열람"",""color"":""yellow"",""bold"":true}"
	{_d}.text(GsonComponentSerializer.gson().deserialize({_js}))

function mhShelfAdd(p: player):
	close {_p}'s inventory
	set {_b} to targeted block of {_p}
	if {_b} is not set:
		send "&c독서대를 바라보고 눌러 주십시오." to {_p}
		stop
	if {_b} is not lectern:
		send "&c바라보는 블록이 독서대가 아닙니다." to {_p}
		stop
	set {matchshelf::%mhShelfKey({_b})%} to true
	mhLabelSpawn({_b})
	send "&a이 독서대를 지난 매치 독서대로 등록했습니다. 우클릭하면 지난 매치 목록이 열립니다." to {_p}

function mhShelfDel(p: player):
	close {_p}'s inventory
	set {_b} to targeted block of {_p}
	if {_b} is not set:
		send "&c등록을 해제할 독서대를 바라보고 눌러 주십시오." to {_p}
		stop
	set {_k} to mhShelfKey({_b})
	if {matchshelf::%{_k}%} is not set:
		send "&c이 블록은 등록된 독서대가 아닙니다." to {_p}
		stop
	delete {matchshelf::%{_k}%}
	mhLabelClear({_b})
	send "&7이 독서대의 등록을 해제했습니다." to {_p}

# ===== 목록 GUI =====
function mhOpen(p: player, page: number):
	set {_uid} to "%{_p}'s uuid%"
	set {_total} to floor(mhCount())
	set {_pages} to ceil({_total} / 27)
	if {_pages} < 1:
		set {_pages} to 1
	set {_pg} to floor({_page})
	if {_pg} < 0:
		set {_pg} to 0
	if {_pg} > {_pages} - 1:
		set {_pg} to {_pages} - 1
	set {_inv} to chest inventory with 4 rows named "지난 매치"
	open {_inv} to {_p}
	delete {-mhmap::%{_uid}%::*}
	set {-mhgui::%{_uid}%} to true
	set {-mhpage::%{_uid}%} to {_pg}
	loop 36 times:
		set {_s} to loop-value - 1
		set slot {_s} of {_inv} to gray stained glass pane named " "
	loop 27 times:
		set {_s} to loop-value - 1
		set {_n} to {_total} - ({_pg} * 27 + {_s})
		if {_n} >= 1:
			set {_bk} to written book named "&f%matchLabel({_n})%"
			set {_m1} to "&7모드: &f%{matchlog::%{_n}%::mode}%"
			set {_m2} to "&7승리: %{matchlog::%{_n}%::winner}%"
			set {_m3} to "&7맵: &f%{matchlog::%{_n}%::map}%"
			set {_m4} to "&7%{matchlog::%{_n}%::time}%"
			set lore of {_bk} to {_m1}, {_m2}, {_m3}, {_m4}, "", "&e▶ 클릭해서 결과 보기"
			set slot {_s} of {_inv} to {_bk}
			set {-mhmap::%{_uid}%::%{_s}%} to {_n}
	if {_total} >= 28:
		set {_pv} to paper named "&f이전 쪽"
		set lore of {_pv} to "&7%{_pg} + 1% / %{_pages}% 쪽"
		set slot 27 of {_inv} to {_pv}
		set {_nx} to paper named "&f다음 쪽"
		set lore of {_nx} to "&7%{_pg} + 1% / %{_pages}% 쪽"
		set slot 35 of {_inv} to {_nx}
	set slot 31 of {_inv} to barrier named "&c나가기"

on right click on lectern:
	set {_b} to event-block
	if {matchshelf::%mhShelfKey({_b})%} is not set:
		stop
	if player is sneaking:
		stop
	cancel the event
	if {-mhgui::%player's uuid%} is set:
		stop
	play sound "block.chest.open" to player
	mhOpen(player, 0)

on inventory click:
	set {_uid} to "%player's uuid%"
	if {-mhgui::%{_uid}%} is not set:
		stop
	cancel the event
	set {_ev} to event
	set {_raw} to {_ev}.getRawSlot()
	set {_raw} to "%{_raw}%" parsed as number
	if {_raw} is not set:
		stop
	if {_raw} < 0:
		stop
	if {_raw} > 35:
		stop
	set {_p} to player
	play sound "ui.button.click" to {_p}
	if {_raw} is 31:
		close {_p}'s inventory
		stop
	set {_pg} to {-mhpage::%{_uid}%}
	if mhCount() >= 28:
		set {_pages} to ceil(mhCount() / 27)
		if {_raw} is 27:
			if {_pg} > 0:
				mhOpen({_p}, {_pg} - 1)
			stop
		if {_raw} is 35:
			if {_pg} < {_pages} - 1:
				mhOpen({_p}, {_pg} + 1)
			stop
	set {_n} to {-mhmap::%{_uid}%::%{_raw}%}
	if {_n} is not set:
		stop
	close {_p}'s inventory
	wait 2 ticks
	gmDialog({_p}, {_n})

on inventory drag:
	if {-mhgui::%player's uuid%} is set:
		cancel the event

on inventory close:
	delete {-mhgui::%player's uuid%}
	delete {-mhmap::%player's uuid%::*}
	delete {-mhpage::%player's uuid%}

on quit:
	delete {-mhgui::%player's uuid%}
	delete {-mhmap::%player's uuid%::*}
	delete {-mhpage::%player's uuid%}

# dialog 안에서 공백이 줄어드는지 확인하는 진단. 같은 자리에 | 두 개를 두고 사이를 종류별 공백으로 채운다(보이는 간격이 같은 폭이어야 정상).
function mhSpaceLine(label: text, fill: text) :: text:
	set {_a} to "{""text"":""%{_label}%  |"",""color"":""gray""}"
	set {_b} to "{""text"":""%{_fill}%"",""color"":""white""}"
	set {_c} to "{""text"":""|\n"",""color"":""gray""}"
	return "%{_a}%,%{_b}%,%{_c}%"

function mhSpaceTest(p: player):
	set {_s4} to " " repeated 4 times
	set {_s12} to " " repeated 12 times
	set {_z} to Character.toString(8203)
	set {_zw} to Character.toString(8204)
	set {_nb} to Character.toString(160)
	set {_id} to Character.toString(12288)
	set {_em} to Character.toString(8195)
	set {_br} to Character.toString(10240)
	set {_f1} to "%{_s4}%"
	set {_f2} to "%{_s12}%"
	set {_f3} to ""
	set {_f4} to ""
	set {_f5} to ""
	set {_f6} to ""
	set {_f7} to ""
	set {_f8} to ""
	loop 6 times:
		set {_f3} to "%{_f3}% %{_z}%"
		set {_f4} to "%{_f4}% %{_zw}%"
	loop 12 times:
		set {_f5} to "%{_f5}%%{_nb}%"
	loop 3 times:
		set {_f6} to "%{_f6}%%{_id}%"
		set {_f7} to "%{_f7}%%{_em}%"
	loop 6 times:
		set {_f8} to "%{_f8}%%{_br}%"
	set {_l1} to mhSpaceLine("공백 4개", {_f1})
	set {_l2} to mhSpaceLine("공백 12개", {_f2})
	set {_l3} to mhSpaceLine("공백+ZWSP x6", {_f3})
	set {_l4} to mhSpaceLine("공백+ZWNJ x6", {_f4})
	set {_l5} to mhSpaceLine("NBSP x12", {_f5})
	set {_l6} to mhSpaceLine("전각공백 x3", {_f6})
	set {_l7} to mhSpaceLine("EM공백 x3", {_f7})
	set {_l8} to mhSpaceLine("점자공백 x6", {_f8})
	set {_d} to "{""type"":""minecraft:notice"",""title"":{""text"":""공백 폭 진단""},""can_close_with_escape"":true,"
	set {_d} to "%{_d}%""body"":[{""type"":""minecraft:plain_message"",""contents"":{""text"":"""",""extra"":[%{_l1}%,%{_l2}%,%{_l3}%,%{_l4}%,%{_l5}%,%{_l6}%,%{_l7}%,%{_l8}%]},""width"":420}]}"
	set {_pn} to {_p}.getName()
	execute console command "dialog show %{_pn}% %{_d}%"

# ===== 테스트: 가짜 매치 기록을 만들어 매치 결과 dialog 를 띄운다(관리자 전용) =====
# /matchtest        가짜 게임 데이터(3인씩 3팀, 1팀 승리, POTM 더미1)로 결과를 만들어 0번 기록에 저장하고 dialog 를 바로 연다. 진짜 기록 번호/개수는 건드리지 않는다.
# /matchtest reopen 저장해 둔 0번 기록 dialog 를 다시 연다(리뷰 등록 후 반영 확인용)
# /matchtest clear  0번 기록(리뷰 포함)을 지운다
# /matchtest space  dialog 에서 공백 폭이 어떻게 그려지는지 보는 진단(여러 종류의 공백으로 같은 칸 수를 채워 본다)
# 0번은 책장 목록 GUI 에 나오지 않는다(목록은 1번부터). 책장/목록/쪽 넘김은 실제 매치로 확인할 것.
command /matchtest [<text>]:
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	description: 매치 기록 dialog 테스트 (관리자 전용)
	executable by: players
	trigger:
		if arg-1 is "clear":
			delete {matchlog::0::*}
			send "&7테스트 기록(0번)을 지웠습니다."
			stop
		if arg-1 is "space":
			mhSpaceTest(player)
			stop
		if arg-1 is "reopen":
			gmDialog(player, 0)
			stop
		if {-ingame} is true:
			send "&c게임이 진행 중이라 테스트할 수 없습니다."
			stop
		if {-gfinale} is true:
			send "&c종료 연출이 진행 중이라 테스트할 수 없습니다."
			stop
		if {-gftest} is true:
			send "&c다른 테스트가 진행 중입니다."
			stop
		gfTestSetup(player)
		delete {-gover}
		set {-gmatchlbl} to "MATCH TEST"
		set {-gpotmres} to "더미1 (3표)"
		delete {matchlog::0::*}
		set {-gfinline} to true
		set {matchlog::0::json} to gfResultJson()
		delete {-gfinline}
		set {matchlog::0::mode} to gcModeName({-gmode})
		set {matchlog::0::winner} to gTeamLabel({-gwinner})
		set {matchlog::0::map} to "%{-gworld}%"
		set {matchlog::0::rand} to "false"
		set {matchlog::0::potm} to "%{-gpotmres}%"
		set {matchlog::0::time} to now formatted as "yyyy-MM-dd HH:mm"
		# 가짜 데이터 되돌리기
		delete {-gmatchlbl}
		delete {-gpotmres}
		delete {-gwinner}
		delete {-gfnw}
		gfTestCleanup()
		send "&6[테스트] &7가짜 매치 기록(0번)을 만들었습니다. 결과 dialog 를 엽니다."
		gmDialog(player, 0)

# 리뷰 입력 대기 중인 사람의 다음 채팅 한 줄을 리뷰로 받는다(채팅으로는 한글이 들어간다).
on chat:
	set {_uid} to "%player's uuid%"
	if {-mhawait::%{_uid}%} is not set:
		stop
	cancel event
	set {_n} to {-mhawait::%{_uid}%}
	delete {-mhawait::%{_uid}%}
	set {_p} to player
	set {_msg} to message
	if {_msg} is "취소":
		send "&7리뷰 작성을 취소했습니다." to {_p}
		stop
	if {_msg} is "-":
		set {_msg} to ""
	set {_t} to gmCleanReview({_msg})
	if {_t} is "":
		delete {matchlog::%{_n}%::rv::%{_uid}%}
		delete {matchlog::%{_n}%::rvn::%{_uid}%}
		send "&7리뷰를 지웠습니다." to {_p}
	else:
		set {matchlog::%{_n}%::rv::%{_uid}%} to {_t}
		set {matchlog::%{_n}%::rvn::%{_uid}%} to name of {_p}
		send "&a리뷰를 남겼습니다." to {_p}
	wait 1 tick
	if {_p} is online:
		gmDialog({_p}, {_n})

on quit:
	delete {-mhawait::%player's uuid%}
