# [main.sk] 스태미너 회복/표시(경험치 바), 상태이상 액션바 표시, 전투 중 처리, 경험치 차단
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 전체 데미지 배율은 skill_core.sk 의 dmgMul() 한 곳에서 조절(현재 0.8).
# 철퇴 데미지 x0.3 은 의도된 기능(삭제 금지). 철퇴로 준 근접 데미지에만 적용(스킬/투사체 데미지는 제외).
# 창 데미지는 최대 6(체력 기준, 스크립트 값 3). 손(메인/오프핸드)과 상관없이 창으로 준 근접 데미지에 적용. 판정은 skill_core.sk 의 weaponKind.
# 도끼/곡괭이/괭이: 기획서 수치(실 체력)를 hp() 로 바꿔 근접 데미지를 덮어쓰고 추가 효과를 준다. 기획서는 skill_core.sk 9번.
# 위 세 무기는 바닐라 공격 쿨다운 규칙(덜 충전하고 때리면 약해짐)과 크리티컬(x1.5, 바닐라 판정)을 따른다: 매 틱 기록한 {-atkcd} 로 cooldownScale() 을 곱한다.
# 이 파일이 쓰는 변수: {-st}, {-stcap}, {-oc} (접속 시 초기화), {-jump}, {-jumplock}, {-bowcool}, {-status}, {-statusname}, {-statusbar}, {-skilldmg}, {-pickstack}, {-pickexp}, {-atkcd} (접속 시 삭제)

on join:
	set {-st::%player's uuid%} to 100
	set level progress of player to 0.999
	set {-oc::%player's uuid%} to 0
	set {-stcap::%player's uuid%} to 0
	delete {-jump::%player's uuid%}
	delete {-jumplock::%player's uuid%::*}
	delete {-bowcool::%player's uuid%}
	delete {-status::%player's uuid%::*}
	delete {-statusname::%player's uuid%::*}
	delete {-statusbar::%player's uuid%}
	delete {-skilldmg::%player's uuid%}
	delete {-pickstack::%player's uuid%}
	delete {-pickexp::%player's uuid%}
	delete {-atkcd::%player's uuid%}

on every 1 ticks:
	loop all players:
		# 공격 쿨다운 충전도(0~1)를 매 틱 기록. 때리는 순간엔 이미 0으로 초기화돼 있을 수 있어서 직전 틱 값을 쓴다.
		set {_pl} to loop-player
		set {_c} to {_pl}.getAttackCooldown()
		set {-atkcd::%loop-player's uuid%} to {_c}
		if {-stcap::%loop-player's uuid%} <= 0:
			if {-st::%loop-player's uuid%} < 100:
				add 1 to {-st::%loop-player's uuid%}
				set level progress of loop-player to ({-st::%loop-player's uuid%}*0.01-0.001)
			if {-st::%loop-player's uuid%} <= 0:
				set level progress of loop-player to 0
			if {-st::%loop-player's uuid%} > 100:
				set {-st::%loop-player's uuid%} to 100
				set level progress of loop-player to 0.999
# 상태이상 액션바 표시. 상태이상은 skill_core.sk 의 setStatus/clearStatus 로 등록한다.
# 같은 이름이 여러 출처에서 걸려 있으면 남은 시간이 가장 긴 것 하나만 보여준다.
on every 5 ticks:
	loop all players:
		set {_uid} to "%loop-player's uuid%"
		delete {_seen::*}
		loop {-status::%{_uid}%::*}:
			set {_src} to loop-index
			set {_end} to {-status::%{_uid}%::%{_src}%}
			if {_end} <= now:
				delete {-status::%{_uid}%::%{_src}%}
				delete {-statusname::%{_uid}%::%{_src}%}
			else:
				set {_n} to {-statusname::%{_uid}%::%{_src}%}
				set {_diff} to difference between now and {_end}
				set {_left} to (seconds of {_diff}) + 1
				if {_seen::%{_n}%} is not set:
					set {_seen::%{_n}%} to {_left}
				else if {_left} > {_seen::%{_n}%}:
					set {_seen::%{_n}%} to {_left}
		if {_seen::*} is set:
			set {_msg} to ""
			loop {_seen::*}:
				if {_msg} is not "":
					set {_msg} to "%{_msg}% &8| "
				set {_msg} to "%{_msg}%&c%loop-index% &f%{_seen::%loop-index%}%초"
			send action bar {_msg} to loop-player
			set {-statusbar::%{_uid}%} to true
		else if {-statusbar::%{_uid}%} is set:
			send action bar "" to loop-player
			delete {-statusbar::%{_uid}%}

on damage:
	# 스킬 데미지({-skilldmg} 표시)와 투사체 데미지는 제외하고, 무기로 직접 때린 근접 데미지만 보정
	if attacker is set:
		if {-skilldmg::%attacker's uuid%} is not set:
			if projectile is not set:
				set {_w} to weaponKind(attacker)
				# 공격 쿨다운 배율 + 크리티컬(바닐라 판정, 1.5배). 덮어쓰는 무기(도끼/곡괭이/괭이)에만 쓴다.
				set {_cm} to cooldownScale(attacker)
				set {_ev} to event
				set {_crit} to {_ev}.isCritical()
				if {_crit} is true:
					set {_cm} to {_cm} * 1.5
				if {_w} is "mace":
					set damage to damage * 0.3 * dmgMul()
				else if {_w} is "spear":
					# 전체 데미지 배율 적용 후, 상한은 기획 6 x 배율 (스크립트 값 3 x dmgMul)
					set damage to damage * dmgMul()
					set {_cap} to 3 * dmgMul()
					if damage > {_cap}:
						set damage to {_cap}
				else if {_w} is "axe":
					# 도끼: 기본 체력 6, 체력 80% 이상인 적에게 1.5배
					set {_d} to hp(6)
					if healthRatio(victim) >= 0.8:
						set {_d} to {_d} * 1.5
						# 도끼 능력 발동: 타격 지점(피격자 위치)에 모루 소리
						set {_loc} to location of victim
						play sound "block.anvil.place" with volume 1 and pitch 1 at {_loc}
						# 강타 이펙트: 피격자 몸통 높이에 크리티컬 파티클 + 폭발 파티클
						set {_fx} to location of victim
						add 1 to y-coordinate of {_fx}
						play 20 crit with offset of 0.3, 0.3, 0.3 and speed 0.3 at {_fx} in radius of 100
						play 1 large explosion with offset of 0, 0, 0 and speed 0 at {_fx} in radius of 100
					set damage to {_d} * {_cm}
				else if {_w} is "hoe":
					# 괭이: 기본 체력 2, 체력 50% 이하인 적에게 100% 증가(2배)
					set {_d} to hp(2)
					if healthRatio(victim) <= 0.5:
						set {_d} to {_d} * 2
					set damage to {_d} * {_cm}
				else if {_w} is "pickaxe":
					# 곡괭이: 기본 체력 2 + 중첩 수. 타격마다 중첩 +1, 마지막 타격 후 3초 안에 못 때리면 전부 소멸.
					# 이번 타격은 기존 중첩만 적용하고, 타격 후 중첩을 늘린다.
					set {_stack} to 0
					if {-pickexp::%attacker's uuid%} is set:
						if {-pickexp::%attacker's uuid%} > now:
							set {_stack} to {-pickstack::%attacker's uuid%}
					set damage to hp(2 + {_stack}) * {_cm}
					set {-pickstack::%attacker's uuid%} to {_stack} + 1
					set {-pickexp::%attacker's uuid%} to now + 3 seconds
				else:
					# 그 외 근접(검, 맨손, 삼지창, 몹 등): 전체 데미지 배율만 적용
					set damage to damage * dmgMul()
	if attacker is player:
		add 8 to {-oc::%attacker's uuid%}
		loop 8 times:
			wait 1 seconds
			remove 1 from {-oc::%attacker's uuid%}


on damage:
	if victim is player:
		add 8 to {-oc::%victim's uuid%}
		loop 8 times:
			wait 1 seconds
			remove 1 from {-oc::%victim's uuid%}
		loop 10 times:
			if {-oc::%victim's uuid%} = 0:
				heal victim by 0.5
				wait 1 seconds

on heal:
	if {-oc::%player's uuid%} > 0:
		cancel event
			
on hunger meter change:
	set player's hunger meter to 10

on experience spawn:
	cancel event
