# [ready.sk] 준비 시스템: 게임이 진행 중이 아닐 때 모두가 "준비됨"이면 5초 뒤 자동으로 게임이 시작된다(관리자 메뉴/명령으로 직접 시작하는 것도 그대로 된다).
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수(RAM): {-ready::uuid}(준비됨이면 true, 없으면 준비 안 됨), {-readycd}(자동 시작 카운트다운 남은 초, 없으면 카운트다운 중 아님)
# 액션바: 게임이 진행 중이 아닐 때 1초마다 "게임 참여/관전 | 준비됨/준비되지 않음"(readyBar)을 보여 준다. 카운트다운 중에는 "게임 시작까지 n초 | ..."로 이어 붙인다.
# 동작:
#   - 게임이 진행 중이 아닐 때(readyActive: 게임 중/시작 연출 중/종료 연출 중이 아닐 때) 모든 플레이어의 8번 칸(핫바 8번째, 인덱스 7)에 콘크리트 블록이 고정된다.
#     녹색 = "준비됨", 붉은색 = "준비되지 않음". 우클릭하면 토글(블록은 설치되지 않는다). 버리기/옮기기/왼손으로 옮기기는 막는다(items.sk 의 클릭 처리와 아래 on drop).
#   - 관리자 메뉴 아이템(op)은 6번 칸(인덱스 5), 7번 칸은 게임 관전 블록(spectate.sk), 9번 칸은 무기고.
#   - 준비 상태는 탭리스트(로비) 닉네임 색으로도 보인다: 준비됨 = 녹색, 준비 안 됨 = 붉은색(items.sk tabUpdate 가 readyColorJ 를 씀). 게임 중에는 gametab.sk 가 탭을 만들어서 색이 안 붙는다.
#   - 접속 중인 모든 플레이어(op 포함, 게임 관전을 고른 사람은 제외, 참가자가 2명 미만이면 시작 안 함)가 준비됨이면 액션바 "게임 시작까지 n초"(5 -> 1)와 시계 소리(block.comparator.click, 매번 같은 음)가 나오고, 0 이 되면 gameBegin(vote.sk)이 맵/모드 투표(꺼져 있으면 바로 gameStart 의 시작 연출)를 실행한다. 투표 중에는 준비 블록이 사라진다(readyActive 가 false).
#     중간에 누가 준비를 풀거나 새로 들어오거나 나가서 조건이 깨지면 카운트다운이 취소된다. 혼자서는 자동 시작되지 않는다(관리자 메뉴/명령으로 직접 시작하는 것만 가능).
#   - 게임이 시작되면(준비 아이템 제거 + 상태 전부 초기화) 다음 게임에서는 다시 준비해야 한다.
# 미검증: 콘크리트 블록 우클릭 설치 막기(우클릭 이벤트 취소), 8번 칸 고정이 1초마다 복구되는지, 탭 닉네임 색이 바뀌는지, 자동 시작이 gameStart 를 부르는 흐름.

function readyOn(p: player) :: boolean:
	if {-ready::%uuid of {_p}%} is true:
		return true
	return false

# 준비 아이템이 나올 때(게임 중/시작 연출 중/종료 연출 중이 아님)
function readyActive() :: boolean:
	if {-ingame} is true:
		return false
	if {-gstarting} is true:
		return false
	if {-gfinale} is true:
		return false
	if {-gvoting} is true:
		return false
	return true

# 게임 중이 아닐 때 액션바: 게임 참여/관전 + 준비 상태(관전을 고른 사람은 준비 상태가 필요 없다)
function readyBar(p: player) :: text:
	# 튜토리얼 진행 중이면 현재 단계 안내(tutorial.sk)
	if {-tut::%uuid of {_p}%} is "run":
		return tutBar({_p})
	if specOn({_p}) is true:
		return "&7게임 관전"
	if readyOn({_p}) is true:
		return "&f게임 참여 &8| &a준비됨"
	return "&f게임 참여 &8| &c준비되지 않음"

function readyName(on: boolean) :: text:
	if {_on} is true:
		return "&a준비됨"
	return "&c준비되지 않음"

function readyItem(on: boolean) :: itemtype:
	if {_on} is true:
		set {_i} to lime concrete named readyName(true)
		set lore of {_i} to "&7준비를 해제합니다.", "&7모두 준비되면 5초 뒤 게임이 시작됩니다."
		return {_i}
	set {_i} to red concrete named readyName(false)
	set lore of {_i} to "&7준비합니다.", "&7모두 준비되면 5초 뒤 게임이 시작됩니다."
	return {_i}

# 8번 칸(인덱스 7)에 지금 상태에 맞는 블록을 고정하고, 왼손에 들어가 있는 준비 블록은 치운다.
function readyEnsure(p: player):
	set {_want} to readyName(readyOn({_p}))
	set {_n} to name of slot 7 of {_p}'s inventory
	set {_ok} to false
	if {_n} is set:
		if {_n} is {_want}:
			set {_ok} to true
	if {_ok} is false:
		set slot 7 of {_p}'s inventory to readyItem(readyOn({_p}))
	set {_o} to name of slot 40 of {_p}'s inventory
	if {_o} is set:
		if {_o} is readyName(true):
			clear slot 40 of {_p}'s inventory
		else if {_o} is readyName(false):
			clear slot 40 of {_p}'s inventory

# 준비 아이템을 치운다(게임이 시작될 때)
function readyClear(p: player):
	loop 2 times:
		set {_s} to 7
		if loop-value is 2:
			set {_s} to 40
		set {_n} to name of slot {_s} of {_p}'s inventory
		if {_n} is set:
			if {_n} is readyName(true):
				clear slot {_s} of {_p}'s inventory
			else if {_n} is readyName(false):
				clear slot {_s} of {_p}'s inventory

# 준비 상태를 바꾼다
function readySet(p: player, on: boolean):
	if {_on} is true:
		set {-ready::%uuid of {_p}%} to true
		play sound "block.note_block.chime" with volume 0.6 and pitch 1.4 to {_p}
	else:
		delete {-ready::%uuid of {_p}%}
		play sound "block.note_block.bass" with volume 0.6 and pitch 1 to {_p}
	readyEnsure({_p})
	tabUpdate({_p})

on right click:
	if readyActive() is not true:
		stop
	set {_h} to event.getHand()
	if {_h} is not set:
		stop
	if {_h}.name() is not "HAND":
		stop
	set {_tn} to name of player's tool
	if {_tn} is not set:
		stop
	if {_tn} is readyName(true):
		cancel the event
		readySet(player, false)
		stop
	if {_tn} is readyName(false):
		cancel the event
		readySet(player, true)

# 준비 블록은 버릴 수 없다
on drop:
	set {_dn} to name of event-item
	if {_dn} is not set:
		stop
	if {_dn} is readyName(true):
		cancel the event
		stop
	if {_dn} is readyName(false):
		cancel the event

on quit:
	delete {-ready::%uuid of player%}

# 1초마다: 준비 블록 고정 + 전원 준비 시 자동 시작 카운트다운
every second:
	if readyActive() is not true:
		delete {-readycd}
		loop all players:
			readyClear(loop-player)
		stop
	set {_n} to 0
	set {_all} to true
	loop all players:
		readyEnsure(loop-player)
		# 튜토리얼 중인 사람은 준비 상태를 액션바에 띄우지 않는다(진행 중에는 튜토리얼 안내만, 로딩/카메라 연출 중에는 아무것도 안 보냄)
		if {-tut::%uuid of loop-player%} is not set:
			send action bar colored readyBar(loop-player) to loop-player
		else if {-tut::%uuid of loop-player%} is "run":
			send action bar colored readyBar(loop-player) to loop-player
		# 게임 관전을 고른 사람은 시작 조건에 포함하지 않는다(spectate.sk)
		if specOn(loop-player) is not true:
			add 1 to {_n}
			if readyOn(loop-player) is not true:
				set {_all} to false
	# 참가자(관전 제외)가 2명 미만이면 자동 시작하지 않는다(혼자서 시작 불가, 관리자 메뉴/명령 시작은 예외)
	if {_n} < 2:
		delete {-readycd}
		stop
	if {_all} is not true:
		if {-readycd} is set:
			delete {-readycd}
			send action bar "" to all players
		stop
	if {-readycd} is not set:
		set {-readycd} to 5
	else:
		subtract 1 from {-readycd}
	if {-readycd} <= 0:
		delete {-readycd}
		delete {-ready::*}
		loop all players:
			readyClear(loop-player)
			tabUpdate(loop-player)
		gameBegin("준비 완료")
		stop
	set {_c} to {-readycd}
	loop all players:
		if {-tut::%uuid of loop-player%} is not set:
			send action bar colored "&b게임 시작까지 %{_c}%초 &8| %readyBar(loop-player)%" to loop-player
			play sound "block.comparator.click" with volume 1 and pitch 1.5 to loop-player
