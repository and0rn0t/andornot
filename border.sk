# [border.sk] 월드마다 설정하는 보이지 않는 월드보더(원형). 바닐라 월드보더 벽/붉은 화면 없이, 경계 밖으로 나가려는 이동을 경계 안쪽 가장자리로 밀어낸다.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 저장 변수: {gamecfg::border::<월드>::cx|cz|r} 중심 x/z, 반경(칸). 없으면 그 월드는 제한 없음.
# 설정: 관리자 메뉴 "월드보더 설정" 버튼(admin.sk) -> 서 있는 자리가 중심 -> 채팅으로 반경 입력(0 = 해제, "취소"). 설정 잠금이 켜져 있으면 이미 설정된 월드는 못 바꾼다.
# RAM 변수: {-bordpend::uuid::w|x|z} 반경 입력 대기 중인 관리자와 그 자리.
# 크리에이티브 모드는 제한하지 않는다(관리자가 보더 밖을 손볼 수 있게). 높이(Y)는 제한하지 않는다.
# 미검증: PlayerMoveEvent#setTo 로 가장자리에 붙이기(엘리트라 활강 중 포함), 채팅 입력 대기.

import:
	org.bukkit.event.player.PlayerMoveEvent

function borderBegin(p: player):
	set {_id} to "%uuid of {_p}%"
	set {_wn} to {_p}.getWorld().getName()
	if adminLockOn() is true:
		if {gamecfg::border::%{_wn}%::r} is set:
			adminLockDeny({_p}, "'%{_wn}%' 월드의 월드보더")
			stop
	set {-bordpend::%{_id}%::w} to {_wn}
	set {-bordpend::%{_id}%::x} to x-coordinate of {_p}
	set {-bordpend::%{_id}%::z} to z-coordinate of {_p}
	if {gamecfg::border::%{_wn}%::r} is set:
		send "&7지금 '%{_wn}%' 월드의 보더: 중심 (%{gamecfg::border::%{_wn}%::cx}%, %{gamecfg::border::%{_wn}%::cz}%) 반경 %{gamecfg::border::%{_wn}%::r}%칸" to {_p}
	send "&e채팅창에 보더 반경(칸)을 입력하십시오. &7지금 서 있는 자리가 중심이 됩니다. (10 이상, 해제는 &f0&7, 취소는 &f취소&7)" to {_p}

on chat:
	set {_id} to "%player's uuid%"
	if {-bordpend::%{_id}%::w} is not set:
		stop
	cancel event
	set {_p} to player
	set {_wn} to {-bordpend::%{_id}%::w}
	set {_cx} to {-bordpend::%{_id}%::x}
	set {_cz} to {-bordpend::%{_id}%::z}
	delete {-bordpend::%{_id}%::*}
	set {_m} to message
	if {_m} is "취소":
		send "&7월드보더 설정을 취소했습니다." to {_p}
		stop
	set {_r} to {_m} parsed as number
	if {_r} is not set:
		send "&c숫자를 입력해야 합니다. 설정을 취소했습니다." to {_p}
		stop
	if {_r} is 0:
		delete {gamecfg::border::%{_wn}%::*}
		send "&7'%{_wn}%' 월드의 월드보더를 해제했습니다." to {_p}
		stop
	if {_r} < 10:
		send "&c반경은 10칸 이상이어야 합니다. 설정을 취소했습니다." to {_p}
		stop
	set {gamecfg::border::%{_wn}%::cx} to {_cx}
	set {gamecfg::border::%{_wn}%::cz} to {_cz}
	set {gamecfg::border::%{_wn}%::r} to {_r}
	send "&a'%{_wn}%' 월드의 월드보더를 저장했습니다. 중심 (%{_cx}%, %{_cz}%) 반경 %{_r}%칸 (눈에 보이지 않습니다)" to {_p}

on quit:
	delete {-bordpend::%player's uuid%::*}

on PlayerMoveEvent:
	set {_p} to event.getPlayer()
	set {_to} to event.getTo()
	set {_wn} to {_to}.getWorld().getName()
	set {_r} to {gamecfg::border::%{_wn}%::r}
	if {_r} is not set:
		stop
	if gamemode of {_p} is creative:
		stop
	set {_cx} to {gamecfg::border::%{_wn}%::cx}
	set {_cz} to {gamecfg::border::%{_wn}%::cz}
	set {_dx} to {_to}.getX() - {_cx}
	set {_dz} to {_to}.getZ() - {_cz}
	set {_d} to sqrt({_dx} * {_dx} + {_dz} * {_dz})
	if {_d} <= {_r}:
		stop
	# 경계 밖: 같은 방향의 안쪽 가장자리(반경 - 0.3)로 붙인다. 높이/시선은 그대로.
	set {_k} to ({_r} - 0.3) / {_d}
	set {_nl} to {_to}.clone()
	{_nl}.setX({_cx} + {_dx} * {_k})
	{_nl}.setZ({_cz} + {_dz} * {_k})
	event.setTo({_nl})
