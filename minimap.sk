# [minimap.sk] 팀원 전용 미니맵(리소스 팩 + 보스바 글자). 환경, 작업 규칙, 변수 목록은 skill_core.sk 맨 위 주석 참고.
# 원리: 흰색 보스바 한 줄의 제목을 커스텀 폰트(andornot:mm)로 그린다. 폰트에는 지도 이미지 글자(E100~), 행마다 높이가 다른 점 글자(E200~)·내 표시 글자(E300~),
#   가로 이동용 공백 글자(E000~E008 = +1,+2,+4..+256 / E010~E018 = 음수)가 들어 있다. 팩은 resourcepack/ 폴더(gen_pack.py 로 생성, andornot-pack.zip).
# 화면 위치: 보스바 글자줄은 화면 가운데 정렬이다. 지도를 줄 맨 앞에 두고 총 너비를 2L 로 고정하면(뒤에 공백을 붙임) 지도 왼쪽이 화면 가운데에서 L 만큼 왼쪽에 온다.
#   L(GUI 픽셀)은 플레이어마다 /minimap left <값> 으로 맞춘다(저장 {mmleft::uuid}, 기본 234). 화면 폭/GUI 배율을 서버가 알 수 없어서 창 크기를 바꾸면 다시 맞춰야 한다. 정확한 구석 고정은 셰이더가 필요(미구현).
# 지도는 16x16 조각 글자로 잘라 두고 플레이어 주변 5x5 조각만 이어 붙인다(조각 창, 글자 텍스처 한 장은 256x256 이하만 가능). 조각 글자 코드 = U+F0000 + ((슬롯-1)*5 + 창 안 행)*256 + 조각행*16 + 조각열. 지도 표시 크기 mmMapPx()=175 GUI 픽셀(5로 나눠떨어져야 함)(resourcepack/gen_pack.py 의 MAP_PX 와 같아야 한다). 지도 이미지 해상도는 bake 때 정함(기본 1000).
# 내 표시: 바라보는 방향으로 회전하는 네비게이션 화살표 하나(16방향, 세로 2픽셀 단위).
# 지도: 월드마다 /minimap bake 로 위에서 본 이미지를 만들어 서버 plugins/Skript/minimap/mapN.png 에 저장 -> 팩의 textures/font/ 에 넣고 gen_pack.py 로 다시 압축.
# 표시 조건: 게임 중, 팀전, 살아 있는 참가자, 팩 적용 완료({-mmpack}), 그 월드에 지도가 저장돼 있을 때. 팀원 점(팀 색) + 나(흰 마름모)만 보인다(적은 안 보임). 북쪽이 위.
# 이 파일의 변수: {mmcfg::월드::slot|minx|minz|size}(저장, 지도 슬롯/범위), {mmcfg::owner::슬롯}(저장, 슬롯 주인 월드), {-mmbar::uuid}(보스바 객체), {-mmpack::uuid}(팩 적용 완료), {-mmtest::uuid}(/minimap test), {mmleft::uuid}(저장, 지도 왼쪽 거리 L), {-mmbaking}(bake 진행 중)
# 미검증: Adventure BossBar 정적 호출과 중첩 클래스 import, MiniMessage <font>, 음수 ascent 글자, BlockData#getMapColor, ImageIO 저장, PlayerResourcePackStatusEvent, pack.mcmeta 형식.

import:
	net.kyori.adventure.bossbar.BossBar as AdvBar
	net.kyori.adventure.bossbar.BossBar$Color as AdvBarColor
	net.kyori.adventure.bossbar.BossBar$Overlay as AdvBarOverlay
	net.kyori.adventure.text.minimessage.MiniMessage
	org.bukkit.event.player.PlayerResourcePackStatusEvent
	java.lang.Character
	java.io.File
	java.awt.image.BufferedImage
	javax.imageio.ImageIO

function mmMapPx() :: number:
	return 175

function mmLeft(p: player) :: number:
	set {_l} to {mmleft::%uuid of {_p}%}
	if {_l} is not set:
		return 234
	return {_l}

function mmChar(code: number) :: text:
	return Character.toString({_code})

# 가로 이동 글자열(이진 분해). 양수는 E000~, 음수는 E010~
function mmShift(n: number) :: text:
	set {_n} to round({_n})
	if {_n} is 0:
		return ""
	set {_base} to 57344
	if {_n} < 0:
		set {_base} to 57360
		set {_n} to 0 - {_n}
	set {_s} to ""
	set {_k} to 0
	while {_n} > 0:
		if mod({_n}, 2) is 1:
			set {_c} to mmChar({_base} + {_k})
			set {_s} to "%{_s}%%{_c}%"
		set {_n} to floor({_n} / 2)
		add 1 to {_k}
	return {_s}

function mmTeamHex(i: number) :: text:
	set {_c::*} to "#ff5555", "#6677ff", "#55ff55", "#ffff55", "#ff55ff", "#55ffff", "#ffaa00", "#cc66ff"
	return {_c::%mod({_i} - 1, 8) + 1%}

# 월드 좌표 -> 지도 픽셀(0~mmMapPx-1, 범위 밖이면 가장자리)
function mmPx(v: number, mn: number, size: number) :: number:
	set {_sz} to mmMapPx()
	set {_q} to floor(({_v} - {_mn}) / {_size} * {_sz})
	return mmClamp({_q})

function mmClamp(q: number) :: number:
	set {_sz} to mmMapPx()
	set {_r} to floor({_q})
	if {_r} < 0:
		set {_r} to 0
	if {_r} > {_sz} - 1:
		set {_r} to {_sz} - 1
	return {_r}

# 점 하나: 현재 커서 c 에서 px 로 이동하는 공백 + 점 글자(행 pz). 호출한 쪽이 c 를 px + 3 으로 갱신한다.
function mmDot(px: number, pz: number, c: number, hex: text) :: text:
	set {_sh} to mmShift({_px} - 1 - {_c})
	set {_g} to mmChar(57856 + {_pz})
	return "<%{_hex}%>%{_sh}%%{_g}%"

function mmWants(p: player) :: boolean:
	if {-mmpack::%uuid of {_p}%} is not true:
		return false
	set {_wn} to {_p}.getWorld().getName()
	if {mmcfg::%{_wn}%::slot} is not set:
		return false
	if {-mmtest::%uuid of {_p}%} is true:
		return true
	if {-ingame} is not true:
		return false
	if {-gstarting} is true:
		return false
	if {-gteams} is not set:
		return false
	if {-gteams} <= 0:
		return false
	if gInGame({_p}) is not true:
		return false
	if gAlive({_p}) is not true:
		return false
	return true

function mmClampI(v: number, lo: number, hi: number) :: number:
	set {_r} to floor({_v})
	if {_r} < {_lo}:
		set {_r} to {_lo}
	if {_r} > {_hi}:
		set {_r} to {_hi}
	return {_r}

# 보스바 제목(MiniMessage 문자열)을 만든다
function mmBuild(p: player) :: text:
	set {_w} to {_p}.getWorld()
	set {_wn} to {_w}.getName()
	set {_slot} to {mmcfg::%{_wn}%::slot}
	set {_minx} to {mmcfg::%{_wn}%::minx}
	set {_minz} to {mmcfg::%{_wn}%::minz}
	set {_size} to {mmcfg::%{_wn}%::size}
	set {_sz} to mmMapPx()
	set {_mx} to x-coordinate of {_p}
	set {_mz} to z-coordinate of {_p}
	# 조각 창: 플레이어가 있는 조각을 가운데로 5x5 조각(지도 가장자리에서는 지도 안쪽으로 밀어 넣는다)
	set {_tb} to {_size} / 16
	set {_tx} to mmClampI(({_mx} - {_minx}) / {_tb}, 0, 15)
	set {_tz} to mmClampI(({_mz} - {_minz}) / {_tb}, 0, 15)
	set {_tx0} to mmClampI({_tx} - 2, 0, 11)
	set {_tz0} to mmClampI({_tz} - 2, 0, 11)
	set {_wx} to {_minx} + {_tx0} * {_tb}
	set {_wz} to {_minz} + {_tz0} * {_tb}
	set {_span} to {_tb} * 5
	set {_s} to "<font:andornot:mm><color:white>"
	set {_m1} to mmShift(-1)
	set {_back1} to mmShift(0 - {_sz})
	set {_tr} to 0
	while {_tr} < 5:
		set {_tc} to 0
		while {_tc} < 5:
			set {_mapc} to mmChar(983040 + (({_slot} - 1) * 5 + {_tr}) * 256 + ({_tz0} + {_tr}) * 16 + {_tx0} + {_tc})
			set {_s} to "%{_s}%%{_mapc}%%{_m1}%"
			add 1 to {_tc}
		if {_tr} < 4:
			set {_s} to "%{_s}%%{_back1}%"
		add 1 to {_tr}
	set {_c} to {_sz}
	set {_qx} to mmPx({_mx}, {_wx}, {_span})
	set {_qz} to mmPx({_mz}, {_wz}, {_span})
	set {_yaw} to yaw of {_p}
	# 팀원(같은 월드, 같은 팀, 생존). 창 밖이면 가장자리에 붙는다
	if gInGame({_p}) is true:
		if {-gteams} > 0:
			set {_my} to gTeamOf({_p})
			set {_hex} to mmTeamHex(gTeamIndex({_my}))
			loop {-gplist::*}:
				set {_o} to loop-value
				if {_o} is not {_p}:
					if gAlive({_o}) is true:
						if {_o}.getWorld().getName() is {_wn}:
							if gTeamOf({_o}) is {_my}:
								set {_ox} to x-coordinate of {_o}
								set {_oz} to z-coordinate of {_o}
								set {_px} to mmPx({_ox}, {_wx}, {_span})
								set {_pz} to mmPx({_oz}, {_wz}, {_span})
								set {_d} to mmDot({_px}, {_pz}, {_c}, {_hex})
								set {_s} to "%{_s}%%{_d}%"
								set {_c} to {_px} + 3
	# 나: 바라보는 방향으로 회전한 화살표 하나(방향 16개 x 세로 2픽셀 행, 글자 E500 + 방향*128 + 행).
	# 방향 번호 = 시계방향 각도/22.5, 각도 0 = 북쪽(지도 위). yaw 180 = 북쪽, 0 = 남쪽, 90 = 서쪽이라 각도 = yaw + 180
	set {_dir} to mod(round(({_yaw} + 180) / 22.5), 16)
	set {_yr} to floor({_qz} / 2)
	set {_sh} to mmShift({_qx} - 6 - {_c})
	set {_mc} to mmChar(58624 + {_dir} * 128 + {_yr})
	set {_s} to "%{_s}%<color:white>%{_sh}%%{_mc}%"
	set {_c} to {_qx} + 8
	# 커서를 지도 폭 뒤로 되돌리고, 총 너비가 2L 이 되도록 뒤쪽 공백을 붙인다
	set {_back} to mmShift({_sz} - {_c})
	set {_trail} to mmShift(2 * mmLeft({_p}) - {_sz})
	return "%{_s}%%{_back}%%{_trail}%"

function mmHide(p: player):
	set {_b} to {-mmbar::%uuid of {_p}%}
	if {_b} is set:
		{_p}.hideBossBar({_b})
	delete {-mmbar::%uuid of {_p}%}

function mmUpdate(p: player):
	if mmWants({_p}) is not true:
		mmHide({_p})
		stop
	set {_str} to mmBuild({_p})
	set {_comp} to MiniMessage.miniMessage().deserialize({_str})
	set {_b} to {-mmbar::%uuid of {_p}%}
	if {_b} is not set:
		set {_b} to AdvBar.bossBar({_comp}, 1, AdvBarColor.WHITE, AdvBarOverlay.PROGRESS)
		set {-mmbar::%uuid of {_p}%} to {_b}
		{_p}.showBossBar({_b})
	else:
		{_b}.name({_comp})

every 3 ticks:
	loop all players:
		set {_pl} to loop-player
		mmUpdate({_pl})

on PlayerResourcePackStatusEvent:
	set {_st} to event.getStatus().name()
	set {_p} to event.getPlayer()
	if {_st} is "SUCCESSFULLY_LOADED":
		set {-mmpack::%uuid of {_p}%} to true
	else if {_st} is "DECLINED" or "FAILED_DOWNLOAD" or "INVALID_URL" or "FAILED_RELOAD" or "DISCARDED":
		delete {-mmpack::%uuid of {_p}%}

on quit:
	delete {-mmpack::%uuid of player%}
	delete {-mmbar::%uuid of player%}
	delete {-mmtest::%uuid of player%}

# 스크립트를 다시 불러오면 떠 있던 보스바를 걷어낸다(RAM 변수는 리로드해도 남는다)
on load:
	delete {-mmbaking}
	loop all players:
		set {_pl} to loop-player
		set {_b} to {-mmbar::%uuid of {_pl}%}
		if {_b} is set:
			{_pl}.hideBossBar({_b})
		delete {-mmbar::%uuid of {_pl}%}

command /minimap <text> [<number>] [<number>] [<number>]:
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	description: 미니맵 관리 (op 전용)
	usage: /minimap bake [범위] [슬롯] [해상도] | left [값] | info | clear | test
	executable by: players
	trigger:
		set {_wn} to player's world.getName()
		if arg-1 is "bake":
			if {-mmbaking} is true:
				send "&c이미 지도를 만드는 중입니다."
				stop
			set {_size} to 128
			if arg-2 is set:
				set {_size} to arg-2
			if {_size} < 16:
				send "&c범위는 16~2048 칸입니다."
				stop
			if {_size} > 2048:
				send "&c범위는 16~2048 칸입니다."
				stop
			set {_tex} to 1000
			if arg-4 is set:
				set {_tex} to arg-4
			if {_tex} < 64:
				send "&c해상도는 64~2048 입니다."
				stop
			if {_tex} > 2048:
				send "&c해상도는 64~2048 입니다."
				stop
			set {_slot} to {mmcfg::%{_wn}%::slot}
			if arg-3 is set:
				set {_slot} to arg-3
			if {_slot} is not set:
				set {_k} to 1
				while {_k} <= 4:
					if {mmcfg::owner::%{_k}%} is not set:
						set {_slot} to {_k}
						exit loop
					add 1 to {_k}
			if {_slot} is not set:
				send "&c빈 슬롯이 없습니다. 슬롯 번호(1~4)를 직접 지정해 덮어쓰세요."
				stop
			if {_slot} < 1:
				send "&c슬롯은 1~4 입니다."
				stop
			if {_slot} > 4:
				send "&c슬롯은 1~4 입니다."
				stop
			if {mmcfg::owner::%{_slot}%} is set:
				if {mmcfg::owner::%{_slot}%} is not {_wn}:
					send "&c슬롯 %{_slot}% 은(는) 월드 %{mmcfg::owner::%{_slot}%}% 이(가) 쓰고 있습니다. 먼저 그 월드에서 /minimap clear 를 하세요."
					stop
			set {-mmbaking} to true
			set {_p} to player
			set {_w} to {_p}.getWorld()
			set {_minx} to floor(x-coordinate of {_p} - {_size} / 2)
			set {_minz} to floor(z-coordinate of {_p} - {_size} / 2)
			set {_top} to floor(y-coordinate of {_p}) + 24
			set {_maxh} to {_w}.getMaxHeight() - 1
			if {_top} > {_maxh}:
				set {_top} to {_maxh}
			set {_minh} to {_w}.getMinHeight()
			set {_img} to new BufferedImage({_tex}, {_tex}, 2)
			set {_step} to {_size} / {_tex}
			set {_rows} to floor(2000 / {_tex})
			if {_rows} < 1:
				set {_rows} to 1
			send "&7지도를 만드는 중입니다(해상도 %{_tex}%). 몇 십 초 걸리며 그동안 서버가 조금 느려질 수 있습니다."
			set {_j} to 0
			set {_n} to 0
			set {_next} to floor({_tex} / 4)
			while {_j} < {_tex}:
				set {_i} to 0
				while {_i} < {_tex}:
					set {_bx} to floor({_minx} + ({_i} + 0.5) * {_step})
					set {_bz} to floor({_minz} + ({_j} + 0.5) * {_step})
					set {_y} to {_w}.getHighestBlockYAt({_bx}, {_bz})
					if {_y} > {_top}:
						set {_y} to {_top}
					set {_found} to false
					while {_found} is false:
						if {_y} < {_minh}:
							exit loop
						if {_y} < {_top} - 90:
							exit loop
						set {_b} to {_w}.getBlockAt({_bx}, {_y}, {_bz})
						set {_col} to {_b}.getBlockData().getMapColor()
						set {_r} to {_col}.getRed()
						set {_g} to {_col}.getGreen()
						set {_bl} to {_col}.getBlue()
						if {_r} + {_g} + {_bl} > 0:
							set {_found} to true
						else:
							subtract 1 from {_y}
					if {_found} is true:
						set {_f} to 1
						if {_prev::%{_i}%} is set:
							if {_y} > {_prev::%{_i}%}:
								set {_f} to 1.12
							else if {_y} < {_prev::%{_i}%}:
								set {_f} to 0.8
						set {_prev::%{_i}%} to {_y}
						set {_r} to min(255, floor({_r} * {_f}))
						set {_g} to min(255, floor({_g} * {_f}))
						set {_bl} to min(255, floor({_bl} * {_f}))
						set {_argb} to {_r} * 65536 + {_g} * 256 + {_bl} - 16777216
						{_img}.setRGB({_i}, {_j}, {_argb})
					add 1 to {_i}
				add 1 to {_j}
				add 1 to {_n}
				if {_n} >= {_rows}:
					set {_n} to 0
					wait 1 tick
				if {_j} >= {_next}:
					send "&7지도 만드는 중... %floor({_j} / {_tex} * 100)%%%" to {_p}
					set {_next} to {_next} + floor({_tex} / 4)
			set {_file} to new File("plugins/Skript/minimap/map%{_slot}%.png")
			{_file}.getParentFile().mkdirs()
			ImageIO.write({_img}, "png", {_file})
			delete {mmcfg::owner::%{_slot}%}
			set {mmcfg::owner::%{_slot}%} to {_wn}
			set {mmcfg::%{_wn}%::slot} to {_slot}
			set {mmcfg::%{_wn}%::minx} to {_minx}
			set {mmcfg::%{_wn}%::minz} to {_minz}
			set {mmcfg::%{_wn}%::size} to {_size}
			delete {-mmbaking}
			send "&a저장했습니다. 슬롯 %{_slot}%, 범위 %{_size}% 칸, 해상도 %{_tex}%. 서버의 plugins/Skript/minimap/map%{_slot}%.png 를 팩에 넣어 주세요." to {_p}
		else if arg-1 is "left":
			if arg-2 is set:
				set {mmleft::%uuid of player%} to arg-2
				send "&a지도 왼쪽 거리를 %arg-2% 로 맞췄습니다. 지도가 화면 왼쪽 끝에 닿지 않으면 값을 키우고, 화면 밖으로 나가면 줄이세요."
			else:
				send "&7지금 값: %mmLeft(player)% (화면 가운데에서 지도 왼쪽까지 GUI 픽셀). /minimap left <값> 으로 조절하세요."
		else if arg-1 is "info":
			set {_k} to 1
			while {_k} <= 4:
				set {_o} to {mmcfg::owner::%{_k}%}
				if {_o} is not set:
					set {_o} to "없음"
				send "&7슬롯 %{_k}%: %{_o}%"
				add 1 to {_k}
			if {mmcfg::%{_wn}%::slot} is not set:
				send "&7이 월드: 지도 없음"
			else:
				send "&7이 월드: 슬롯 %{mmcfg::%{_wn}%::slot}%, 시작 %{mmcfg::%{_wn}%::minx}%, %{mmcfg::%{_wn}%::minz}%, 범위 %{mmcfg::%{_wn}%::size}%"
		else if arg-1 is "clear":
			set {_s} to {mmcfg::%{_wn}%::slot}
			if {_s} is set:
				delete {mmcfg::owner::%{_s}%}
			delete {mmcfg::%{_wn}%::*}
			send "&a이 월드의 미니맵 설정을 지웠습니다."
		else if arg-1 is "test":
			if {-mmtest::%uuid of player%} is true:
				delete {-mmtest::%uuid of player%}
				send "&7미니맵 테스트를 껐습니다."
			else:
				set {-mmtest::%uuid of player%} to true
				set {-mmpack::%uuid of player%} to true
				send "&7미니맵 테스트를 켰습니다. 팩 적용 여부와 상관없이 표시합니다(팩이 없으면 깨진 글자가 보임). 이 월드에 지도 설정이 있어야 합니다."
		else:
			send "&c/minimap bake [범위] [슬롯] [해상도] | left [값] | info | clear | test"
