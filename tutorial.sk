# [tutorial.sk] 튜토리얼: 처음 들어온 플레이어를 튜토리얼 월드로 보내 기초 조작(도약, 핑, 무기고, 아이템 사용)을 익히게 한다. 도움말 GUI(/도움말, 무기고 칸 8)도 이 파일이 만든다.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수: {tutpending::uuid}(저장, 튜토리얼을 아직 끝내지/건너뛰지 않은 사람. 첫 접속 때 켜고 끝내면 지움. 켜져 있으면 접속할 때마다 튜토리얼을 다시 시작),
#   {-tut::uuid}(진행 상태 intro = 리소스 팩 대기 / load = 월드 로딩 / cam = 시작 카메라 / run = 진행 중 / done = 완료 연출), {-tutstep::uuid}(현재 단계 1~4), {-tutgen::uuid}(중단용 세대 번호), {-tutpack::uuid}(리소스 팩 상태 loading/done), {-tutcam::uuid}(시작 카메라 엔티티)
#   {gamecfg::loc::tutorial}(튜토리얼 스폰 = 월드+좌표), {gamecfg::loc::tutorialcam}(튜토리얼 시작 카메라, 없으면 카메라 연출을 건너뜀): 관리자 메뉴의 "튜토리얼 월드 지정"/"튜토리얼 카메라 지정"(저장 변수)
# 흐름(tutBegin): 첫 접속자는 리소스 팩 로딩이 끝날 때까지 기다린다(PlayerResourcePackStatusEvent. 상태 이벤트가 하나도 안 오면 tutPackGrace() 틱 뒤 진행) -> 튜토리얼 월드로 옮겨 눈을 가리고 액션바 "loading..."으로 맵을 불러온다
#   -> 다 불러오면 튜토리얼 시작 카메라를 tutCamTicks() 틱 보여 준다(배경음악 없음, 카메라가 없으면 건너뜀) -> 스폰으로 이동 -> 단계 진행.
# 단계(tutKey 순서): 1 leap(더블 점프 도약, jump.sk), 2 ping(F 핑, waypoint.sk), 3 loadout(무기고에서 아이템 바꾸기, items.sk), 4 potion(포션 사용, potions.sk). 각 파일이 tutHook(플레이어, 키)를 부르면 그 단계가 끝난다.
#   4단계에서 구성에 포션이 없으면 체력 포션을 하나 지급한다. 끝나면 로비로 돌려보내고 구성 아이템을 다시 맞춘다. 단계 안내(tutTitle/tutLines)는 도움말 GUI 와 같은 글이다.
# 튜토리얼 중인 사람은 게임 참가/관전/준비/투표 대상이 아니다(spectate.sk 의 specOn 이 true, game.sk 의 참가자 목록에서 제외). 게임/투표가 시작되면 튜토리얼은 중단되고({tutpending} 은 그대로) 다음 접속이나 /튜토리얼 로 다시 한다.
# 명령: /튜토리얼(시작), /튜토리얼 skip(건너뛰기, 다시 안 함), /도움말(도움말 GUI). 문구는 이 파일의 tutTitle/tutLines 에서 직접 고친다("문구 편집 구역").
# 튜토리얼 월드는 맵 추첨/선택 대상에서 제외된다(admin.sk 의 mapExcluded).
# 미검증: PlayerResourcePackStatusEvent(서버 리소스 팩이 설정 단계에서 로드되면 상태 이벤트가 안 올 수 있음 -> 유예 시간 후 진행), hasPlayedBefore, 로딩 중 실명(PotionEffect), 카메라 관전, 단계 훅 전부.

import:
	org.bukkit.entity.EntityType
	org.bukkit.potion.PotionEffect
	org.bukkit.potion.PotionEffectType
	org.bukkit.event.player.PlayerMoveEvent
	org.bukkit.event.player.PlayerResourcePackStatusEvent
	com.destroystokyo.paper.event.player.PlayerStopSpectatingEntityEvent

# 상태 이벤트가 하나도 안 올 때 기다릴 틱(서버 리소스 팩을 접속 전에 이미 받았다면 이벤트가 없을 수 있다)
function tutPackGrace() :: number:
	return 100

# 시작 카메라 보여 주는 시간(틱)
function tutCamTicks() :: number:
	return 120

function tutStepCount() :: number:
	return 4

# 단계 번호 -> 훅 키(각 기능이 tutHook(플레이어, 키)를 부르면 그 단계가 끝난다)
function tutKey(n: number) :: text:
	if {_n} is 1:
		return "leap"
	if {_n} is 2:
		return "ping"
	if {_n} is 3:
		return "loadout"
	return "potion"

# ============================================================
# 튜토리얼/도움말 문구 편집 구역: 글만 바꾸려면 아래 tutTitle, tutLines 의 따옴표 안 글자만 고치면 된다.
#  - 색은 &색코드(예: &e 노랑, &7 회색). 줄을 늘리거나 줄이려면 'add "..." to {_r::*}' 줄을 복사/삭제한다.
#  - 각 단계의 마지막 줄은 액션바(화면 아래 안내)에도 쓰이니 "지금: ..." 같은 할 일 한 줄로 둔다.
#  - 도움말 GUI(/도움말)와 튜토리얼 채팅이 같은 글을 쓴다. 단계 종류/개수를 바꾸려면 tutStepCount, tutKey 도 고쳐야 한다.
# ============================================================
function tutTitle(n: number) :: text:
	if {_n} is 1:
		return "더블 점프로 도약"
	if {_n} is 2:
		return "F키로 핑 찍기"
	if {_n} is 3:
		return "무기고에서 아이템 바꾸기"
	return "아이템 사용하기"

function tutLines(n: number) :: texts:
	if {_n} is 1:
		add "스페이스를 빠르게 두 번 누르면 바라보는 쪽으로 도약합니다." to {_r::*}
		add "도약할 때마다 스태미너(배고픔)이 줄어듭니다." to {_r::*}
		add "지금: 스페이스를 두 번 눌러 보세요." to {_r::*}
		return {_r::*}
	if {_n} is 2:
		add "F키를 누르면 바라보는 곳에 핑이 찍힙니다." to {_r::*}
		add "적을 향해 핑을 찍으면 대상의 위치가 보입니다." to {_r::*}
		add "허공을 보고 있을 때는 핑이 찍히지 않습니다." to {_r::*}
		add "지금: 블록을 바라보고 F키를 눌러 보세요." to {_r::*}
		return {_r::*}
	if {_n} is 3:
		add "핫바 9번 칸의 무기고(상자)를 우클릭하면 아이템 구성을 바꿀 수 있습니다." to {_r::*}
		add "구성 칸을 클릭해 아이템을 고르고, 로드아웃은 4세트까지 저장됩니다." to {_r::*}
		add "지금: 무기고에서 아이템을 하나 바꿔 보세요." to {_r::*}
		return {_r::*}
	add "핫바에서 아이템을 사용하면 스킬이 사용됩니다." to {_r::*}
	add "쓰고 나면 아이템 위에 쿨타임 게이지가 돌아갑니다." to {_r::*}
	add "지금: 포션을 들고 우클릭해 보세요." to {_r::*}
	return {_r::*}

# 도움말 GUI 아이템 설명(회색 글씨). 반복문 안의 반복문은 loop-value 가 헷갈려서 별도 함수로 뺐다.
function tutLore(n: number) :: texts:
	set {_l::*} to tutLines({_n})
	set {_i} to 0
	while {_i} < size of {_l::*}:
		add 1 to {_i}
		add "&7%{_l::%{_i}%}%" to {_r::*}
	return {_r::*}

# 설정이 돼 있는지(튜토리얼 스폰이 저장돼 있어야 한다)
function tutConfigured() :: boolean:
	if {gamecfg::loc::tutorial::world} is set:
		return true
	return false

# 튜토리얼을 시작하면 안 되는 때(게임/투표/연출 중에는 무기고를 못 써서 진행이 안 된다)
function tutBusy() :: boolean:
	if {-ingame} is true:
		return true
	if {-gstarting} is true:
		return true
	if {-gfinale} is true:
		return true
	if {-gvoting} is true:
		return true
	return false

function tutActive(p: player) :: boolean:
	if {-tut::%uuid of {_p}%} is set:
		return true
	return false

# 중단/종료 확인: 그 세대의 튜토리얼이 아직 이어지고 있는지
function tutAlive(p: player, g: number) :: boolean:
	if {_p} is not online:
		return false
	if {-tutgen::%uuid of {_p}%} is not {_g}:
		return false
	if {-tut::%uuid of {_p}%} is not set:
		return false
	return true

# 로비 액션바용 한 줄
function tutBar(p: player) :: text:
	set {_n} to {-tutstep::%uuid of {_p}%}
	set {_l::*} to tutLines({_n})
	set {_c} to size of {_l::*}
	return "&e[튜토리얼 %{_n}%/%tutStepCount()%] &f%tutTitle({_n})% &8- &7%{_l::%{_c}%}%"

# 현재 단계 안내(채팅 + 타이틀)
function tutShow(p: player):
	set {_id} to "%uuid of {_p}%"
	set {_n} to {-tutstep::%{_id}%}
	send "" to {_p}
	send colored "&6===== 튜토리얼 %{_n}%/%tutStepCount()%: %tutTitle({_n})% &6=====" to {_p}
	set {_l::*} to tutLines({_n})
	loop {_l::*}:
		send colored "&7- &f%loop-value%" to {_p}
	send title "&e%{_n}%단계" with subtitle "&f%tutTitle({_n})%" to {_p} for 3 seconds with fadein 5 ticks and fade out 10 ticks
	# 4단계: 구성에 포션이 없으면 체력 포션을 지급한다
	if {_n} is 4:
		set {_has} to false
		loop "potion_heal", "potion_stamina" and "potion_invis":
			if loadoutFind({_p}, loop-value) >= 0:
				set {_has} to true
		if {_has} is false:
			set {_s} to loadoutEmpty({_p}, 3)
			if {_s} >= 0:
				set slot {_s} of {_p}'s inventory to itemBuild("potion_heal")
				send colored "&7체력 포션을 하나 드렸어요. 핫바에서 골라 우클릭해 보세요." to {_p}

# 다른 시스템이 부르는 훅: 지금 단계의 키와 같으면 다음 단계로
function tutHook(p: player, key: text):
	set {_id} to "%uuid of {_p}%"
	if {-tut::%{_id}%} is not "run":
		stop
	if tutKey({-tutstep::%{_id}%}) is not {_key}:
		stop
	add 1 to {-tutstep::%{_id}%}
	play sound "entity.player.levelup" with volume 0.6 to {_p}
	if {-tutstep::%{_id}%} > tutStepCount():
		set {-tut::%{_id}%} to "done"
		set {_g} to {-tutgen::%{_id}%}
		send title "&a튜토리얼 완료!" with subtitle "&7로비로 돌아갑니다" to {_p} for 3 seconds with fadein 5 ticks and fade out 10 ticks
		wait 60 ticks
		if {-tutgen::%{_id}%} is {_g}:
			tutEnd({_p}, true)
		stop
	tutShow({_p})

# 튜토리얼 끝(completed = 완료/건너뛰기면 true -> 다시 안 함, 중단이면 false)
function tutEnd(p: player, done: boolean):
	set {_id} to "%uuid of {_p}%"
	if {-tut::%{_id}%} is not set:
		stop
	add 1 to {-tutgen::%{_id}%}
	delete {-tut::%{_id}%}
	delete {-tutstep::%{_id}%}
	set {_he} to {-tutcam::%{_id}%}
	delete {-tutcam::%{_id}%}
	if {_done} is true:
		delete {tutpending::%{_id}%}
	if {_p} is online:
		if gamemode of {_p} is spectator:
			{_p}.setSpectatorTarget(null)
	if {_he} is set:
		{_he}.remove()
	if {_p} is not online:
		stop
	{_p}.clearActivePotionEffects()
	set gamemode of {_p} to adventure
	tpSafe({_p}, gameLobbyLoc())
	loadoutClearAll({_p})
	loadoutGive({_p})
	tabUpdate({_p})
	if {_done} is true:
		send colored "&a튜토리얼을 마쳤어요. 내용은 언제든 &f/도움말 &a에서 다시 볼 수 있고, &f/튜토리얼 &a로 다시 할 수 있어요." to {_p}
	else:
		send colored "&7튜토리얼을 중단했어요. 다음 접속이나 &f/튜토리얼 &7로 다시 할 수 있어요." to {_p}

# 튜토리얼 시작. first = 첫 접속(리소스 팩 로딩을 기다림). 접속 직후 game.sk 의 로비 이동(1틱 뒤)이 끝난 다음에 시작한다.
function tutBegin(p: player, first: boolean):
	wait 2 ticks
	if {_p} is not online:
		stop
	set {_id} to "%uuid of {_p}%"
	if {-tut::%{_id}%} is set:
		stop
	if tutConfigured() is not true:
		if {_first} is not true:
			send colored "&c튜토리얼 월드가 아직 지정되지 않았어요. 관리자에게 문의해 주세요." to {_p}
		stop
	if tutBusy() is true:
		if {_first} is not true:
			send colored "&c게임 중에는 튜토리얼을 할 수 없어요." to {_p}
		stop
	add 1 to {-tutgen::%{_id}%}
	set {_g} to {-tutgen::%{_id}%}
	set {-tut::%{_id}%} to "intro"
	set {-tutstep::%{_id}%} to 1
	# 1) 리소스 팩 로딩이 끝날 때까지 기다린다(첫 접속만)
	if {_first} is true:
		set {_t} to 0
		set {_go} to false
		while {_go} is false:
			if tutAlive({_p}, {_g}) is not true:
				stop
			set {_st} to {-tutpack::%{_id}%}
			if {_st} is "done":
				set {_go} to true
			else if {_st} is "loading":
				if {_t} >= 2400:
					set {_go} to true
			else:
				if {_t} >= tutPackGrace():
					set {_go} to true
			if {_go} is false:
				send action bar colored "&e리소스 팩을 불러오는 중..." to {_p}
				wait 5 ticks
				add 5 to {_t}
	set {_sp} to gcLoadLoc("tutorial")
	set {_cam} to gcLoadLoc("tutorialcam")
	if {_sp} is not set:
		tutEnd({_p}, false)
		stop
	# 2) 튜토리얼 월드로 옮겨 눈을 가리고 맵을 불러온다
	set {-tut::%{_id}%} to "load"
	tpSafe({_p}, {_sp})
	{_p}.addPotionEffect(new PotionEffect(PotionEffectType.BLINDNESS, 1200, 0, false, false, false))
	gsPreload({_sp}, 3)
	if {_cam} is set:
		gsPreload({_cam}, 3)
	set {_t} to 0
	set {_ok} to false
	while {_ok} is false:
		if tutAlive({_p}, {_g}) is not true:
			stop
		send action bar colored "&eloading..." to {_p}
		wait 5 ticks
		add 5 to {_t}
		if {_t} >= 40:
			set {_a} to gsPreloaded({_sp}, 3)
			set {_b} to true
			if {_cam} is set:
				set {_b} to gsPreloaded({_cam}, 3)
			if {_a} is true:
				if {_b} is true:
					set {_ok} to true
		if {_t} >= 200:
			set {_ok} to true
	wait 10 ticks
	# 3) 시작 카메라(배경음악 없음). 카메라 엔티티가 전송되면 관전 대상으로 건다.
	if {_cam} is set:
		if tutAlive({_p}, {_g}) is not true:
			stop
		set {-tut::%{_id}%} to "cam"
		set {_cw} to {_cam}.getWorld()
		set {_he} to {_cw}.spawnEntity({_cam}, EntityType.TEXT_DISPLAY)
		{_he}.setGravity(false)
		{_he}.setInvulnerable(true)
		{_he}.setSilent(true)
		set {-tutcam::%{_id}%} to {_he}
		set gamemode of {_p} to spectator
		tpSafe({_p}, {_cam})
		wait 1 tick
		set {_t} to 0
		set {_tr} to false
		while {_tr} is false:
			if tutAlive({_p}, {_g}) is not true:
				stop
			set {_tb} to {_he}.getTrackedBy()
			set {_has} to {_tb}.contains({_p})
			if {_has} is true:
				set {_tr} to true
			add 2 to {_t}
			if {_t} >= 100:
				set {_tr} to true
			wait 2 ticks
		gSpecForce({_p}, {_he})
		{_p}.clearActivePotionEffects()
		send title "&e튜토리얼" with subtitle "&7기초 조작을 익혀요" to {_p} for 3 seconds with fadein 10 ticks and fade out 10 ticks
		set {_t} to 0
		while {_t} < tutCamTicks():
			if tutAlive({_p}, {_g}) is not true:
				stop
			if mod({_t}, 10) is 0:
				set {_cur} to {_p}.getSpectatorTarget()
				if {_cur} is not {_he}:
					{_p}.setSpectatorTarget({_he})
			wait 2 ticks
			add 2 to {_t}
		delete {-tutcam::%{_id}%}
		{_p}.setSpectatorTarget(null)
		{_he}.remove()
	# 4) 스폰으로 이동하고 단계를 시작한다
	if tutAlive({_p}, {_g}) is not true:
		stop
	{_p}.clearActivePotionEffects()
	set gamemode of {_p} to adventure
	tpSafe({_p}, {_sp})
	loadoutGive({_p})
	wait 10 ticks
	if tutAlive({_p}, {_g}) is not true:
		stop
	set {-tut::%{_id}%} to "run"
	set {-tutstep::%{_id}%} to 1
	tutShow({_p})

# ===== 이벤트 =====
on join:
	set {_p} to player
	set {_id} to "%uuid of {_p}%"
	delete {-tutpack::%{_id}%}
	set {_pb} to {_p}.hasPlayedBefore()
	if {_pb} is not true:
		set {tutpending::%{_id}%} to true
	if {tutpending::%{_id}%} is true:
		set {_first} to true
		tutBegin({_p}, {_first})

on quit:
	delete {-tutpack::%uuid of player%}
	tutEnd(player, false)

# 서버 리소스 팩 상태: 로딩 중 / 끝남(성공, 거절, 실패 모두 기다림을 끝낸다)
on PlayerResourcePackStatusEvent:
	set {_p} to event.getPlayer()
	set {_stt} to event.getStatus()
	set {_s} to {_stt}.name()
	if {_s} is "SUCCESSFULLY_LOADED":
		set {-tutpack::%uuid of {_p}%} to "done"
	else if {_s} is "ACCEPTED":
		set {-tutpack::%uuid of {_p}%} to "loading"
	else if {_s} is "DOWNLOADED":
		set {-tutpack::%uuid of {_p}%} to "loading"
	else:
		set {-tutpack::%uuid of {_p}%} to "done"

# 팩 대기/로딩 중에는 제자리에 있게 한다(시점 회전은 허용)
on PlayerMoveEvent:
	set {_mp} to event.getPlayer()
	set {_s} to {-tut::%uuid of {_mp}%}
	if {_s} is not "intro":
		if {_s} is not "load":
			stop
	set {_f} to event.getFrom()
	set {_t} to event.getTo()
	set {_mv} to false
	if {_f}.getBlockX() is not {_t}.getBlockX():
		set {_mv} to true
	if {_f}.getBlockY() is not {_t}.getBlockY():
		set {_mv} to true
	if {_f}.getBlockZ() is not {_t}.getBlockZ():
		set {_mv} to true
	if {_mv} is true:
		event.setCancelled(true)

# 시작 카메라에서 내려오는 것(웅크리기 등)을 막는다
on PlayerStopSpectatingEntityEvent:
	if {-gspecforce} is true:
		stop
	set {_sp} to event.getPlayer()
	if {-tutcam::%uuid of {_sp}%} is set:
		event.setCancelled(true)

# 게임/투표가 시작되면 튜토리얼을 중단한다
every second:
	if tutBusy() is true:
		loop all players:
			if {-tut::%uuid of loop-player%} is set:
				tutEnd(loop-player, false)

# 스크립트를 다시 불러올 때 진행 중이던 튜토리얼 정리
on load:
	loop all players:
		if {-tut::%uuid of loop-player%} is set:
			tutEnd(loop-player, false)

command /튜토리얼 [<text>]:
	description: 튜토리얼을 시작해요 (/튜토리얼 skip = 건너뛰기)
	executable by: players
	trigger:
		if arg-1 is "skip":
			if tutActive(player) is not true:
				send "&7진행 중인 튜토리얼이 없습니다."
				stop
			tutEnd(player, true)
			stop
		if tutActive(player) is true:
			send "&7이미 튜토리얼 중입니다. 건너뛰려면 /튜토리얼 skip"
			stop
		set {_first} to false
		tutBegin(player, {_first})

# ===== 도움말 GUI =====
function helpItem() :: itemtype:
	set {_i} to book named "&e도움말"
	set lore of {_i} to "&7기초 조작과 튜토리얼 내용을 봅니다.", "", "&e▶ 클릭해서 열기"
	return {_i}

function helpOpen(p: player):
	set {_uid} to "%uuid of {_p}%"
	set {_inv} to chest inventory with 3 rows named "도움말"
	open {_inv} to {_p}
	set {-helpgui::%{_uid}%} to true
	delete {-helpmap::%{_uid}%::*}
	loop 27 times:
		set {_s} to loop-value - 1
		set slot {_s} of {_inv} to gray stained glass pane named " "
	loop integers from 1 to tutStepCount():
		set {_n} to loop-value
		set {_b} to writable book named "&e%{_n}%. %tutTitle({_n})%"
		set lore of {_b} to tutLore({_n})
		set slot ({_n} + 9) of {_inv} to {_b}
	set {_r} to emerald named "&a튜토리얼 다시 하기"
	set lore of {_r} to "&7튜토리얼 월드에서 기초 조작을", "&7처음부터 다시 연습합니다.", "", "&e▶ 클릭해서 시작"
	set slot 16 of {_inv} to {_r}
	set {-helpmap::%{_uid}%::16} to "replay"

on inventory click:
	set {_uid} to "%player's uuid%"
	if {-helpgui::%{_uid}%} is not set:
		stop
	cancel the event
	set {_ev} to event
	set {_raw} to {_ev}.getRawSlot()
	set {_raw} to "%{_raw}%" parsed as number
	if {_raw} is not set:
		stop
	if {_raw} < 0:
		stop
	if {_raw} > 26:
		stop
	set {_p} to player
	play sound "ui.button.click" to {_p}
	if {-helpmap::%{_uid}%::%{_raw}%} is "replay":
		close {_p}'s inventory
		set {_first} to false
		tutBegin({_p}, {_first})

on inventory drag:
	if {-helpgui::%player's uuid%} is set:
		cancel the event

on inventory close:
	delete {-helpgui::%player's uuid%}
	delete {-helpmap::%player's uuid%::*}

command /도움말:
	description: 기초 조작 도움말을 엽니다.
	executable by: players
	trigger:
		helpOpen(player)
