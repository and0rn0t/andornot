# [bow.sk] 활 스킬(당겨서 발사, 발사 후 쿨 2초): 충전 시간(최대 3초)에 비례해 데미지 4~10(실 체력), 화살 속도 증가. 최대 충전(3초)으로 쏘면 소닉붐 이펙트와 사운드.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수: {-bowstart}(당기기 시작 시각), {-bowcd}(쿨타임 종료 시각), {-bowdmg::화살uuid}(그 화살의 데미지, crossbow.sk 의 화살 on damage 가 읽고 지움), {-skillitems::bow}
# 데미지 4~10 은 기획 수치(이미 밸런스 80% 반영)라 다시 곱하지 않는다. hp() 로 스크립트 단위로 바꿔서 쓴다. 석궁(crossbow.sk)과 데미지는 분리돼 있다.
# 동작: 우클릭(당기기 시작) 때 시각을 기록 -> 놓아서 발사(on shoot)될 때 당긴 시간으로 충전도(0~1, 3초에 1)를 계산해 화살 속도와 데미지를 정한다.
#   바닐라 활은 화살이 인벤토리에 있어야 당겨지므로, 당길 때 화살이 없으면 1개 지급하고 발사해도 화살을 소모하지 않게 한다(setConsumeItem(false)).
#   쿨타임 중에는 우클릭을 취소해서 당기지 못하게 한다. 이 우클릭은 취소하지 않아야 당겨지므로 일반 skillHand 와 달리 cancel 을 쓰지 않는다.
# 충전 속도(speed): 충전도 0 -> 1.5, 1 -> 4(석궁 속도와 같음). 아래 bowSpeed() 에서 고친다.
# 미검증: 활 이벤트(on shoot, event.getBow()/getProjectile()/setConsumeItem()), 화살 속도 재설정, SONIC_BOOM 파티클.

import:
	org.bukkit.Particle
	org.bukkit.Material
	org.bukkit.inventory.ItemStack

on load:
	set {-skillitems::bow} to bow

# 충전도(0~1)에 따른 화살 속도
function bowSpeed(f: number) :: number:
	return 1.5 + 2.5 * {_f}

# 충전도(0~1)에 따른 데미지(기획 실 체력 4~10)
function bowDamage(f: number) :: number:
	return hp(4 + 6 * {_f})

on rightclick:
	if skillHand(player, bow) is false:
		stop
	set {_id} to "%player's uuid%"
	if {-bowcd::%{_id}%} is set:
		if {-bowcd::%{_id}%} > now:
			cancel event
			stop
	set {_p} to player
	if {_p}.getInventory().contains(Material.ARROW) is false:
		{_p}.getInventory().addItem(new ItemStack(Material.ARROW))
	set {-bowstart::%{_id}%} to now

on shoot:
	set {_ev} to event
	if {_ev}.getBow().getType().name() is not "BOW":
		stop
	set {_p} to shooter
	if {_p} is not a player:
		stop
	set {_id} to "%uuid of {_p}%"
	{_ev}.setConsumeItem(false)
	set {_f} to 0
	if {-bowstart::%{_id}%} is set:
		set {_held} to now - {-bowstart::%{_id}%}
		set {_ms} to {_held}.getMilliSeconds()
		set {_f} to {_ms} / 3000
	if {_f} > 1:
		set {_f} to 1
	if {_f} < 0:
		set {_f} to 0
	delete {-bowstart::%{_id}%}
	set {_pr} to {_ev}.getProjectile()
	set {_v} to velocity of {_pr}
	set {_sp} to bowSpeed({_f})
	set velocity of {_pr} to (normalized {_v}) * {_sp}
	set {-bowdmg::%uuid of {_pr}%} to bowDamage({_f})
	set {-bowcd::%{_id}%} to now + 2 seconds
	set item cooldown of bow for {_p} to 2 seconds
	# 최대 충전: 소닉붐 이펙트 + 사운드
	if {_f} >= 1:
		set {_eye} to {_p}.getEyeLocation()
		set {_dir} to {_eye}.getDirection()
		set {_fx} to {_eye} ~ ({_dir} * 1.5)
		{_fx}.getWorld().spawnParticle(Particle.SONIC_BOOM, {_fx}, 1)
		play sound "entity.warden.sonic_boom" with volume 0.7 and pitch 1.4 at {_p}
