# [soundtest.sk] 사운드보드(op 전용 테스트 명령): 혼자서도 soundAround(soundfx.sk)의 거리/방향별 소리를 들어 볼 수 있다.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 원리: 내 눈 위치에서 (앞/뒤/좌/우/위/아래) 방향으로 지정한 거리만큼 떨어진 가짜 소리 위치를 만들고 soundAround 로 재생한다. 내 위치와 시선 기준이라 혼자서 테스트할 수 있다.
# 명령(op 전용):
#   /sndtest                          도움말
#   /sndtest play <거리> <방향> [소리]  한 번 재생. 방향: 앞 뒤 좌 우 위 아래, 소리: 폭발(기본) 벌 번개
#   /sndtest dist [소리]              앞쪽으로 거리 2,4,8,16,24,32,48,64칸을 1.5초 간격으로 차례로 재생(액션바에 거리 표시)
#   /sndtest dir [거리] [소리]        앞 우 뒤 좌 위 아래 순서로 같은 거리(기본 20칸)에서 차례로 재생(액션바에 방향 표시)
# 소리 이름과 반경은 sndTestPlay 한 곳에서 관리한다(폭발: generic.explode 반경 64, 벌: bee.loop 반경 48, 번개: lightning_bolt.impact 반경 48). soundAround 의 반경 밖 거리는 안 들린다.
# 미검증: 전부(콘솔 컴파일 오류 확인 필요).

# 내 눈 위치 기준으로 방향/거리만큼 떨어진 위치를 만든다(앞/뒤/좌/우는 시선의 수평 성분 기준).
function sndSrc(p: player, d: number, dn: text) :: location:
	set {_l} to {_p}.getEyeLocation()
	set {_f} to {_l}.getDirection()
	set {_fx} to {_f}.getX()
	set {_fz} to {_f}.getZ()
	set {_len} to sqrt({_fx} * {_fx} + {_fz} * {_fz})
	if {_len} < 0.001:
		set {_fx} to 0
		set {_fz} to 1
		set {_len} to 1
	set {_fx} to {_fx} / {_len}
	set {_fz} to {_fz} / {_len}
	set {_v} to vector({_fx}, 0, {_fz})
	if {_dn} is "뒤":
		set {_v} to vector(0 - {_fx}, 0, 0 - {_fz})
	else if {_dn} is "좌":
		set {_v} to vector({_fz}, 0, 0 - {_fx})
	else if {_dn} is "우":
		set {_v} to vector(0 - {_fz}, 0, {_fx})
	else if {_dn} is "위":
		set {_v} to vector(0, 1, 0)
	else if {_dn} is "아래":
		set {_v} to vector(0, 0 - 1, 0)
	return {_l} ~ ({_v} * {_d})

function sndTestPlay(p: player, d: number, dn: text, sn: text):
	set {_loc} to sndSrc({_p}, {_d}, {_dn})
	if {_sn} is "벌":
		soundAround("entity.bee.loop", {_loc}, 48, 2, 1)
	else if {_sn} is "번개":
		soundAround("entity.lightning_bolt.impact", {_loc}, 48, 0.8, 1.6)
	else:
		soundAround("entity.generic.explode", {_loc}, 64, 1.5, 1.2)

command /sndtest [<text>] [<text>] [<text>] [<text>]:
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	description: 거리/방향별 사운드 테스트 (op 전용)
	executable by: players
	trigger:
		if player is not op:
			send "&c권한이 없습니다."
			stop
		set {_m} to arg-1
		if {_m} is "play":
			set {_d} to arg-2 parsed as number
			if {_d} is not set:
				send "&c사용법: /sndtest play <거리> <앞|뒤|좌|우|위|아래> [폭발|벌|번개]"
				stop
			set {_dn} to arg-3
			if {_dn} is not set:
				set {_dn} to "앞"
			set {_sn} to arg-4
			if {_sn} is not set:
				set {_sn} to "폭발"
			sndTestPlay(player, {_d}, {_dn}, {_sn})
			send action bar colored "&e%{_dn}% %{_d}%칸 · %{_sn}%" to player
			stop
		if {_m} is "dist":
			set {_sn} to arg-2
			if {_sn} is not set:
				set {_sn} to "폭발"
			loop 2, 4, 8, 16, 24, 32, 48, 64:
				set {_d} to loop-value
				send action bar colored "&e앞 %{_d}%칸 · %{_sn}%" to player
				sndTestPlay(player, {_d}, "앞", {_sn})
				wait 30 ticks
			stop
		if {_m} is "dir":
			set {_d} to 20
			if arg-2 is set:
				set {_d} to arg-2 parsed as number
				if {_d} is not set:
					set {_d} to 20
			set {_sn} to arg-3
			if {_sn} is not set:
				set {_sn} to "폭발"
			loop "앞", "우", "뒤", "좌", "위", "아래":
				set {_dn} to loop-value
				send action bar colored "&e%{_dn}% %{_d}%칸 · %{_sn}%" to player
				sndTestPlay(player, {_d}, {_dn}, {_sn})
				wait 30 ticks
			stop
		send "&e/sndtest play <거리> <앞|뒤|좌|우|위|아래> [폭발|벌|번개] : 한 번 재생"
		send "&e/sndtest dist [소리] : 앞쪽으로 2~64칸을 차례로 재생"
		send "&e/sndtest dir [거리] [소리] : 앞 우 뒤 좌 위 아래를 차례로 재생"
