# [admin.sk] 관리자 메뉴: /admin (op 전용) 으로 6줄 GUI 를 열고, 관리자용 기능을 버튼으로 실행한다.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수: {-admingui::uuid}(관리자 GUI 가 열려 있는 표시), {-adminmap::uuid::칸}(GUI 칸 -> 버튼 id),
#   {-mapgui::uuid}(맵 설정 GUI 가 열려 있는 표시), {-mapmap::uuid::칸}(GUI 칸 -> 월드 이름), {gamecfg::map}(선택한 게임 맵 월드 이름, 저장 변수), {gamecfg::maprandom}(매 게임 랜덤 모드, 저장 변수)
#
# ===== 새 관리자 기능을 메뉴에 추가하는 법 =====
#   1) adminButtonIds() 에 버튼 id 를 추가한다(적은 순서대로 GUI 안쪽 칸(2~5번째 줄, 양끝 칸 제외)에 왼쪽 위부터 채워진다).
#   2) adminButtonItem(id) 에 버튼 모양(아이템, 이름, 설명)을 추가한다.
#   3) adminAction(p, id) 에 눌렀을 때 할 일을 추가한다.
# 빈 칸은 전부 회색 색유리판(이름 공백)이고 클릭해도 아무 일도 안 일어난다. GUI 칸 클릭에는 UI 버튼 소리가 난다.
# 미검증 문법: 6줄 GUI 와 클릭 처리는 items.sk 와 같은 방식(event.getRawSlot() 등).

# ===== 설정 잠금(덮어쓰기 방지) =====
# 켜져 있으면(기본값) 이미 저장된 로비 위치, 결과 무대 위치(월드별), 리스폰 기준 위치(월드별), 훈련장 위치와, 이미 설치된 훈련장/로비 NPC 를 버튼으로 덮어쓰거나 다시 설치/치우지 못한다.
# 처음 저장하는 것은 잠겨 있어도 된다. 바꾸려면 "설정 잠금" 버튼으로 끈 뒤 바꾸고 다시 켠다. 저장 변수 {gamecfg::unlock}(true 면 잠금 꺼짐, 없으면 켜짐).
# 잠그지 않는 것: 맵 선택, 게임 설정(팀 수/모드/랜덤 아이템), 아이템 순서, 결과 무대 치우기(위치 설정이 아니라 남은 더미 청소).
function adminLockOn() :: boolean:
	if {gamecfg::unlock} is true:
		return false
	return true

# 저장된 위치가 있는지(gcSaveLoc 키)
function gcLocSet(key: text) :: boolean:
	if {gamecfg::loc::%{_key}%::world} is set:
		return true
	return false

function adminLockDeny(p: player, what: text):
	send "&c이미 설정된 %{_what}%을(를) 바꿀 수 없습니다. 관리자 메뉴의 '설정 잠금'을 끈 뒤 다시 시도해 주십시오." to {_p}
	play sound "block.note_block.bass" with volume 1 and pitch 0.6 to {_p}

# 8번 슬롯에 고정되는 관리자 메뉴 아이템(op 전용, 고정/제거는 items.sk)
function adminItemName() :: text:
	return "&c관리자 메뉴"

function adminItem() :: itemtype:
	set {_i} to command block named adminItemName()
	set lore of {_i} to "&7[우클릭] 관리자 메뉴를 열어요"
	return {_i}

function adminButtonIds() :: texts:
	return "gamesetup", "map", "gamestart", "gamestop", "itemorder", "setlobby", "setstage", "setrespawn", "clearstage", "settraining", "trainingnpc", "cleartrainingnpc", "lobbynpc", "clearlobbynpc", "shelfadd", "shelfdel" and "lock"

function adminButtonItem(id: text) :: itemtype:
	if {_id} is "gamesetup":
		set {_i} to command block named "&f게임 설정"
		set lore of {_i} to "&7팀 수, 게임모드, 랜덤 아이템을", "&7게임 시작 전에 설정해요", "", "&e▶ 클릭해서 열기"
		return {_i}
	if {_id} is "map":
		set {_i} to grass block named "&f맵 설정"
		if {gamecfg::maprandom} is true:
			set lore of {_i} to "&7게임이 진행될 월드를 골라요", "&7현재: &d매 게임 랜덤", "", "&e▶ 클릭해서 열기"
		else if {gamecfg::map} is set:
			set lore of {_i} to "&7게임이 진행될 월드를 골라요", "&7현재 맵: &f%{gamecfg::map}%", "", "&e▶ 클릭해서 열기"
		else:
			set lore of {_i} to "&7게임이 진행될 월드를 골라요", "&7현재 맵: &c선택 안 함", "", "&e▶ 클릭해서 열기"
		return {_i}
	if {_id} is "gamestart":
		set {_i} to lime concrete named "&a게임 시작"
		set lore of {_i} to "&7게임 설정대로 팀을 나누고", "&7지금 접속한 모두와 게임을 시작해요", "", "&e▶ 클릭해서 시작"
		return {_i}
	if {_id} is "gamestop":
		set {_i} to red concrete named "&c게임 강제 종료"
		set lore of {_i} to "&7진행 중인 게임을 결과 발표 없이", "&7바로 끝내요", "", "&e▶ 클릭해서 종료"
		return {_i}
	if {_id} is "itemorder":
		set {_i} to writable book named "&f아이템 순서 편집"
		set lore of {_i} to "&7아이템 변경 GUI 에 나오는", "&7같은 분류 안의 순서를 바꿔요", "", "&e▶ 클릭해서 열기"
		return {_i}
	if {_id} is "setlobby":
		set {_i} to compass named "&f로비 위치 설정"
		set lore of {_i} to "&7지금 서 있는 자리를 게임이 끝난 뒤", "&7모두가 돌아올 로비로 저장해요", "&7(월드가 달라도 돼요)", "", "&e▶ 클릭해서 저장"
		return {_i}
	if {_id} is "setstage":
		set {_i} to lectern named "&f결과 무대 위치 설정"
		set lore of {_i} to "&7지금 서 있는 자리와 바라보는 방향을", "&7승리 팀 더미와 결과 디스플레이의", "&7무대로 저장해요", "&7(서 있는 월드마다 따로 저장돼요)", "&7(더미가 바라볼 쪽, 구경하는 사람이 설 쪽을 보고 서세요)", "", "&e▶ 클릭해서 저장"
		return {_i}
	if {_id} is "setrespawn":
		set {_i} to red bed named "&f리스폰 위치 지정"
		set lore of {_i} to "&7지금 서 있는 자리를 이 월드의 리스폰 기준 위치로 저장해요", "&7게임을 시작할 때마다 팀 수만큼 이 위치 반경 200칸 안에서", "&7무작위 초기 리스폰 위치를 뽑아요", "&7(바운티 리스폰은 팀원 근처 50칸, 섬멸전은 초기 위치만)", "&7(서 있는 월드마다 따로 저장돼요)", "", "&e▶ 클릭해서 저장"
		return {_i}
	if {_id} is "clearstage":
		set {_i} to barrier named "&c결과 무대 치우기"
		set lore of {_i} to "&7남아 있는 승리 팀 더미와", "&7결과 디스플레이를 지워요", "&7(다음 게임을 시작해도 지워져요)", "", "&e▶ 클릭해서 치우기"
		return {_i}
	if {_id} is "settraining":
		set {_i} to iron sword named "&f훈련장 위치 설정"
		set lore of {_i} to "&7지금 서 있는 자리를 훈련장으로 저장해요", "&7(월드가 달라도 돼요)", "&7훈련장 NPC 를 누르면 이곳으로 이동해요", "", "&e▶ 클릭해서 저장"
		return {_i}
	if {_id} is "trainingnpc":
		set {_i} to armor stand named "&f훈련장 NPC 설치"
		set lore of {_i} to "&7서 있는 자리 앞에 NPC 를 세워요", "&7(누르면 저장된 훈련장으로 이동)", "&7(NPC 가 서 있는 쪽을 보고 서세요)", "", "&e▶ 클릭해서 설치"
		return {_i}
	if {_id} is "cleartrainingnpc":
		set {_i} to red wool named "&c훈련장 NPC 치우기"
		set lore of {_i} to "&7설치된 훈련장 NPC 를", "&7모든 월드에서 지워요", "", "&e▶ 클릭해서 치우기"
		return {_i}
	if {_id} is "lobbynpc":
		set {_i} to compass named "&f로비 NPC 설치"
		set lore of {_i} to "&7서 있는 자리 앞에 NPC 를 세워요", "&7(누르면 로비로 이동)", "&7(NPC 가 서 있는 쪽을 보고 서세요)", "", "&e▶ 클릭해서 설치"
		return {_i}
	if {_id} is "clearlobbynpc":
		set {_i} to red wool named "&c로비 NPC 치우기"
		set lore of {_i} to "&7설치된 로비 NPC 를", "&7모든 월드에서 지워요", "", "&e▶ 클릭해서 치우기"
		return {_i}
	if {_id} is "shelfadd":
		set {_i} to lectern named "&f매치 독서대 등록"
		set lore of {_i} to "&7바라보는 독서대를 지난 매치 독서대로 등록해요", "&7(우클릭하면 지난 매치 목록이 열려요)", "", "&e▶ 독서대를 보고 클릭"
		return {_i}
	if {_id} is "shelfdel":
		set {_i} to red wool named "&c매치 독서대 해제"
		set lore of {_i} to "&7바라보는 독서대의 등록을 해제해요", "", "&e▶ 독서대를 보고 클릭"
		return {_i}
	if {_id} is "lock":
		if adminLockOn() is true:
			set {_i} to iron door named "&f설정 잠금: &a켜짐"
			set lore of {_i} to "&7이미 저장된 로비/결과 무대/훈련장 위치와", "&7설치된 NPC 를 덮어쓰지 못하게 막아요", "", "&e▶ 클릭해서 끄기"
		else:
			set {_i} to iron door named "&f설정 잠금: &c꺼짐"
			set lore of {_i} to "&7지금은 저장된 위치와 NPC 를", "&7덮어쓰거나 치울 수 있어요", "&c바꾼 뒤 다시 켜는 걸 권해요", "", "&e▶ 클릭해서 켜기"
		return {_i}
	set {_i} to barrier named "&c알 수 없는 버튼"
	return {_i}

function adminAction(p: player, id: text):
	if {_id} is "gamesetup":
		gameSetupOpen({_p})
	else if {_id} is "map":
		mapGuiOpen({_p})
	else if {_id} is "gamestart":
		close {_p}'s inventory
		if {-ingame} is true:
			send "&c이미 게임이 진행 중입니다." to {_p}
		else:
			gameStart(name of {_p})
	else if {_id} is "gamestop":
		close {_p}'s inventory
		if {-ingame} is not true:
			send "&c진행 중인 게임이 없습니다." to {_p}
		else:
			gameForceStop(name of {_p})
	else if {_id} is "lock":
		if adminLockOn() is true:
			set {gamecfg::unlock} to true
			send "&c설정 잠금을 껐습니다. 저장된 위치와 NPC 를 바꿀 수 있습니다." to {_p}
		else:
			delete {gamecfg::unlock}
			send "&a설정 잠금을 켰습니다." to {_p}
		adminOpen({_p})
	else if {_id} is "setlobby":
		close {_p}'s inventory
		if adminLockOn() is true:
			if gcLocSet("lobby") is true:
				adminLockDeny({_p}, "로비 위치")
				stop
			if {gamecfg::lobby} is set:
				adminLockDeny({_p}, "로비 위치")
				stop
		gcSaveLoc("lobby", location of {_p})
		send "&a로비 위치를 저장했습니다. (%{_p}.getWorld().getName()%)" to {_p}
	else if {_id} is "setstage":
		close {_p}'s inventory
		set {_sw} to {_p}.getWorld().getName()
		if adminLockOn() is true:
			if gcLocSet(gcStageKey({_sw})) is true:
				adminLockDeny({_p}, "'%{_sw}%' 월드의 결과 무대 위치")
				stop
		gcSaveLoc(gcStageKey({_sw}), location of {_p})
		send "&a'%{_sw}%' 월드의 결과 무대 위치를 저장했습니다. 지금 바라보는 방향이 더미가 바라볼 방향입니다." to {_p}
	else if {_id} is "setrespawn":
		close {_p}'s inventory
		set {_rw} to {_p}.getWorld().getName()
		if adminLockOn() is true:
			if gcLocSet(gcRespawnKey({_rw})) is true:
				adminLockDeny({_p}, "'%{_rw}%' 월드의 리스폰 기준 위치")
				stop
		gcSaveLoc(gcRespawnKey({_rw}), location of {_p})
		send "&a'%{_rw}%' 월드의 리스폰 기준 위치를 저장했습니다. 게임을 시작하면 이 위치 반경 200칸 안에서 팀별 초기 위치를 뽑습니다." to {_p}
	else if {_id} is "clearstage":
		close {_p}'s inventory
		gfClearStage()
		send "&7남아 있는 결과 무대를 치웠습니다." to {_p}
	else if {_id} is "settraining":
		close {_p}'s inventory
		if adminLockOn() is true:
			if gcLocSet("training") is true:
				adminLockDeny({_p}, "훈련장 위치")
				stop
		gcSaveLoc("training", location of {_p})
		send "&a훈련장 위치를 저장했습니다. (%{_p}.getWorld().getName()%)" to {_p}
	else if {_id} is "trainingnpc":
		close {_p}'s inventory
		if adminLockOn() is true:
			if npcCount("trainingnpc") > 0:
				adminLockDeny({_p}, "훈련장 NPC")
				stop
		set {_yaw} to {_p}.getLocation().getYaw()
		set {_nl} to location of {_p} ~ vector(0 - sin({_yaw}) * 1.5, 0, cos({_yaw}) * 1.5)
		trainingNpcSpawn({_nl}, {_yaw} + 180)
		send "&a서 있는 자리 앞에 훈련장 NPC 를 설치했습니다." to {_p}
		if gcLoadLoc("training") is not set:
			send "&e아직 훈련장 위치가 저장되지 않았습니다. 관리자 메뉴의 '훈련장 위치 설정'으로 저장해 주십시오." to {_p}
	else if {_id} is "cleartrainingnpc":
		close {_p}'s inventory
		if adminLockOn() is true:
			if npcCount("trainingnpc") > 0:
				adminLockDeny({_p}, "훈련장 NPC")
				stop
		set {_n} to trainingNpcClear()
		send "&7훈련장 NPC %{_n}%개를 치웠습니다." to {_p}
	else if {_id} is "lobbynpc":
		close {_p}'s inventory
		if adminLockOn() is true:
			if npcCount("lobbynpc") > 0:
				adminLockDeny({_p}, "로비 NPC")
				stop
		set {_yaw} to {_p}.getLocation().getYaw()
		set {_nl} to location of {_p} ~ vector(0 - sin({_yaw}) * 1.5, 0, cos({_yaw}) * 1.5)
		lobbyNpcSpawn({_nl}, {_yaw} + 180)
		send "&a서 있는 자리 앞에 로비 NPC 를 설치했습니다." to {_p}
	else if {_id} is "clearlobbynpc":
		close {_p}'s inventory
		if adminLockOn() is true:
			if npcCount("lobbynpc") > 0:
				adminLockDeny({_p}, "로비 NPC")
				stop
		set {_n} to lobbyNpcClear()
		send "&7로비 NPC %{_n}%개를 치웠습니다." to {_p}
	else if {_id} is "shelfadd":
		mhShelfAdd({_p})
	else if {_id} is "shelfdel":
		mhShelfDel({_p})
	else if {_id} is "itemorder":
		itemGuiOpen({_p}, "order")

function adminOpen(p: player):
	set {_uid} to "%{_p}'s uuid%"
	set {_inv} to chest inventory with 6 rows named "관리자 메뉴"
	open {_inv} to {_p}
	set {-admingui::%{_uid}%} to true
	delete {-adminmap::%{_uid}%::*}
	loop 54 times:
		set {_s} to loop-value - 1
		set slot {_s} of {_inv} to gray stained glass pane named " "
	# 안쪽 칸: 줄 2~5, 칸 2~8 (0부터 센 칸 번호 = 줄*9 + 열, 열 1~7)
	set {_ids::*} to adminButtonIds()
	loop {_ids::*}:
		set {_n} to loop-index parsed as number
		set {_row} to floor(({_n} - 1) / 7) + 1
		set {_col} to mod({_n} - 1, 7) + 1
		set {_s} to {_row} * 9 + {_col}
		if {_s} < 54:
			set slot {_s} of {_inv} to adminButtonItem(loop-value)
			set {-adminmap::%{_uid}%::%{_s}%} to loop-value

# ===== 맵 설정: 월드 선택 GUI =====
# 불러온 월드와 자동으로 불러올 월드 목록({gamecfg::worldlist})의 월드(네더/엔드 제외)를 칸마다 하나씩 보여 주고, 클릭하면 게임 맵으로 정한다(한글 이름 가능, 아직 안 불러온 월드는 그때 불러온다).
# 맨 아래 줄: 47번 칸 = 매 게임 랜덤 모드 켜기/끄기(켜면 게임 시작마다 후보에서 새로 뽑음), 48번 칸 = 랜덤 선택(후보 중 하나를 지금 골라 일반 선택과 똑같이 저장), 49번 칸 = 선택 해제(시작한 사람이 있는 월드에서 진행), 53번 칸 = 관리자 메뉴로 돌아가기. 월드는 최대 45개까지 보인다.
# 선택한 맵은 {gamecfg::map}(저장 변수)에 있어서 바꾸거나 해제하기 전까지 게임이 끝나도 그대로 쓴다.
# 랜덤 후보: 불러온 월드 + 자동 불러오기 목록에서 로비 월드와 네더/엔드(_nether, _the_end)를 뺀 것.
function mapCandidates() :: texts:
	set {_ll} to gameLobbyLoc()
	set {_lw} to {_ll}.getWorld()
	set {_lobby} to {_lw}.getName()
	delete {_seen::*}
	loop all worlds:
		set {_seen::%loop-world.getName()%} to true
	loop {gamecfg::worldlist::*}:
		set {_seen::%loop-value%} to true
	loop {_seen::*}:
		set {_n} to loop-index
		if {_n} is not {_lobby}:
			if {_n} does not end with "_nether":
				if {_n} does not end with "_the_end":
					add {_n} to {_r::*}
	return {_r::*}

# 맵 선택(클릭/랜덤 공통): 월드를 불러오고 {gamecfg::map} 에 저장한다. 바꾸기 전까지 유지된다.
function mapSelect(p: player, wn: text):
	set {_w} to gcWorld({_wn})
	if {_w} is not set:
		send "&c월드를 불러오지 못했습니다: %{_wn}%" to {_p}
		stop
	set {gamecfg::map} to {_wn}
	send "&a게임 맵을 '%{_wn}%' 월드로 설정했습니다. 바꾸거나 해제하기 전까지 유지되고, 게임을 시작하면 참가자가 이 월드로 이동합니다." to {_p}

function mapGuiOpen(p: player):
	set {_uid} to "%{_p}'s uuid%"
	set {_inv} to chest inventory with 6 rows named "맵 설정"
	open {_inv} to {_p}
	set {-mapgui::%{_uid}%} to true
	delete {-mapmap::%{_uid}%::*}
	loop 54 times:
		set {_s} to loop-value - 1
		set slot {_s} of {_inv} to gray stained glass pane named " "
	delete {_names::*}
	delete {_seen::*}
	# 네더/엔드 월드(이름이 _nether, _the_end 로 끝남: world_nether, world_the_end 등)는 맵 목록에서 뺀다
	loop all worlds:
		set {_n} to loop-world.getName()
		set {_seen::%{_n}%} to true
		if {_n} does not end with "_nether":
			if {_n} does not end with "_the_end":
				add {_n} to {_names::*}
	loop {gamecfg::worldlist::*}:
		set {_n} to "%loop-value%"
		if {_seen::%{_n}%} is not set:
			set {_seen::%{_n}%} to false
			if {_n} does not end with "_nether":
				if {_n} does not end with "_the_end":
					add {_n} to {_names::*}
	set {_cur} to ""
	if {gamecfg::map} is set:
		set {_cur} to "%{gamecfg::map}%"
	loop {_names::*}:
		set {_n} to loop-value
		set {_s} to (loop-index parsed as number) - 1
		if {_s} < 45:
			set {_loaded} to "&7불러온 월드"
			if {_seen::%{_n}%} is false:
				set {_loaded} to "&e아직 안 불러온 월드 (선택하면 불러옵니다)"
			if {_n} is {_cur}:
				set {_i} to emerald block named "&a%{_n}% &7(선택됨)"
				set lore of {_i} to {_loaded}, "", "&e▶ 클릭하면 이 월드가 게임 맵이 됩니다"
			else:
				set {_i} to grass block named "&f%{_n}%"
				set lore of {_i} to {_loaded}, "", "&e▶ 클릭해서 게임 맵으로 선택"
			set slot {_s} of {_inv} to {_i}
			set {-mapmap::%{_uid}%::%{_s}%} to {_n}
	set {_nc} to size of mapCandidates()
	set {_ri} to ender pearl named "&d랜덤 선택"
	set lore of {_ri} to "&7후보 월드 중 하나를 골라 게임 맵으로 정해요", "&7(로비 월드와 네더/엔드는 제외, 후보 %{_nc}%개)", "", "&e▶ 클릭해서 랜덤 선택"
	set slot 48 of {_inv} to {_ri}
	if {gamecfg::maprandom} is true:
		set {_mi} to lime dye named "&a매 게임 랜덤: 켜짐"
		set lore of {_mi} to "&7게임을 시작할 때마다 후보 월드 중", "&7하나를 새로 뽑아요", "&7(골라 둔 맵은 그대로 남아요)", "", "&e▶ 클릭해서 끄기"
	else:
		set {_mi} to gray dye named "&7매 게임 랜덤: 꺼짐"
		set lore of {_mi} to "&7켜면 게임을 시작할 때마다 후보 월드 중", "&7하나를 새로 뽑아요", "&7(꺼 두면 골라 둔 맵을 계속 써요)", "", "&e▶ 클릭해서 켜기"
	set slot 47 of {_inv} to {_mi}
	set slot 49 of {_inv} to barrier named "&c맵 선택 해제"
	set slot 53 of {_inv} to arrow named "&f관리자 메뉴로"

on inventory click:
	set {_uid} to "%player's uuid%"
	if {-mapgui::%{_uid}%} is not set:
		stop
	cancel the event
	set {_ev} to event
	set {_raw} to {_ev}.getRawSlot()
	set {_raw} to "%{_raw}%" parsed as number
	if {_raw} is not set:
		stop
	if {_raw} < 0:
		stop
	if {_raw} > 53:
		stop
	set {_p} to player
	if {_p} is not op:
		stop
	play sound "ui.button.click" to {_p}
	if {_raw} is 53:
		adminOpen({_p})
		stop
	if {_raw} is 47:
		if {gamecfg::maprandom} is true:
			delete {gamecfg::maprandom}
			send "&7매 게임 랜덤 모드를 껐습니다. 골라 둔 맵을 계속 씁니다." to {_p}
		else:
			set {gamecfg::maprandom} to true
			send "&a매 게임 랜덤 모드를 켰습니다. 게임을 시작할 때마다 후보 월드 중 하나를 새로 뽑습니다." to {_p}
		mapGuiOpen({_p})
		stop
	if {_raw} is 48:
		close {_p}'s inventory
		set {_c::*} to mapCandidates()
		if size of {_c::*} is 0:
			send "&c랜덤으로 고를 후보 월드가 없습니다. 로비 월드를 뺀 다른 월드를 먼저 불러와 주십시오." to {_p}
			stop
		set {_rn} to random integer between 1 and size of {_c::*}
		mapSelect({_p}, {_c::%{_rn}%})
		stop
	if {_raw} is 49:
		delete {gamecfg::map}
		close {_p}'s inventory
		send "&7게임 맵 선택을 해제했습니다. 시작한 사람이 있는 월드에서 진행합니다." to {_p}
		stop
	set {_wn} to {-mapmap::%{_uid}%::%{_raw}%}
	if {_wn} is not set:
		stop
	close {_p}'s inventory
	mapSelect({_p}, "%{_wn}%")

on inventory drag:
	if {-mapgui::%player's uuid%} is set:
		cancel the event

on inventory close:
	delete {-mapgui::%player's uuid%}
	delete {-mapmap::%player's uuid%::*}

command /admin:
	permission: minecraft.command.op
	permission message: &c권한이 없습니다.
	description: 관리자 메뉴를 열어요 (op 전용)
	executable by: players
	trigger:
		if player is not op:
			send "&c권한이 없습니다."
			stop
		play sound "block.chest.open" to player
		adminOpen(player)

on inventory click:
	set {_uid} to "%player's uuid%"
	if {-admingui::%{_uid}%} is not set:
		stop
	cancel the event
	set {_ev} to event
	set {_raw} to {_ev}.getRawSlot()
	set {_raw} to "%{_raw}%" parsed as number
	if {_raw} is not set:
		stop
	if {_raw} < 0:
		stop
	if {_raw} > 53:
		stop
	set {_p} to player
	play sound "ui.button.click" to {_p}
	set {_id} to {-adminmap::%{_uid}%::%{_raw}%}
	if {_id} is not set:
		stop
	if {_p} is not op:
		stop
	adminAction({_p}, {_id})

on inventory drag:
	if {-admingui::%player's uuid%} is set:
		cancel the event

on inventory close:
	delete {-admingui::%player's uuid%}
	delete {-adminmap::%player's uuid%::*}

on quit:
	delete {-admingui::%player's uuid%}
	delete {-adminmap::%player's uuid%::*}
