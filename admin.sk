# [admin.sk] 관리자 메뉴: /admin (op 전용) 으로 6줄 GUI 를 열고, 관리자용 기능을 버튼으로 실행한다.
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 이 파일이 쓰는 변수: {-admingui::uuid}(관리자 GUI 가 열려 있는 표시), {-adminmap::uuid::칸}(GUI 칸 -> 버튼 id)
#
# ===== 새 관리자 기능을 메뉴에 추가하는 법 =====
#   1) adminButtonIds() 에 버튼 id 를 추가한다(적은 순서대로 GUI 안쪽 칸(2~5번째 줄, 양끝 칸 제외)에 왼쪽 위부터 채워진다).
#   2) adminButtonItem(id) 에 버튼 모양(아이템, 이름, 설명)을 추가한다.
#   3) adminAction(p, id) 에 눌렀을 때 할 일을 추가한다.
# 빈 칸은 전부 회색 색유리판(이름 공백)이고 클릭해도 아무 일도 안 일어난다. GUI 칸 클릭에는 UI 버튼 소리가 난다.
# 미검증 문법: 6줄 GUI 와 클릭 처리는 items.sk 와 같은 방식(event.getRawSlot() 등).

# 8번 슬롯에 고정되는 관리자 메뉴 아이템(op 전용, 고정/제거는 items.sk)
function adminItemName() :: text:
	return "&c관리자 메뉴"

function adminItem() :: itemtype:
	set {_i} to command block named adminItemName()
	set lore of {_i} to "&7[우클릭] 관리자 메뉴를 열어요"
	return {_i}

function adminButtonIds() :: texts:
	return "gamesetup", "itemorder" and "team"

function adminButtonItem(id: text) :: itemtype:
	if {_id} is "gamesetup":
		set {_i} to command block named "&f게임 설정"
		set lore of {_i} to "&7팀 수, 게임모드, 랜덤 아이템을", "&7게임 시작 전에 설정해요", "", "&e▶ 클릭해서 열기"
		return {_i}
	if {_id} is "itemorder":
		set {_i} to writable book named "&f아이템 순서 편집"
		set lore of {_i} to "&7아이템 변경 GUI 에 나오는", "&7같은 분류 안의 순서를 바꿔요", "", "&e▶ 클릭해서 열기"
		return {_i}
	if {_id} is "team":
		set {_i} to white banner named "&f팀 설정"
		set lore of {_i} to "&7명령어로 플레이어의 팀을 정해요", "&7(채팅창에 사용법을 알려줘요)", "", "&e▶ 클릭"
		return {_i}
	set {_i} to barrier named "&c알 수 없는 버튼"
	return {_i}

function adminAction(p: player, id: text):
	if {_id} is "gamesetup":
		gameSetupOpen({_p})
	else if {_id} is "itemorder":
		itemGuiOpen({_p}, "order")
	else if {_id} is "team":
		close {_p}'s inventory
		send "&e/team <플레이어> <팀이름> &7: 팀 설정(같은 이름이면 아군)" to {_p}
		send "&e/team <플레이어> none &7: 팀 해제" to {_p}

function adminOpen(p: player):
	set {_uid} to "%{_p}'s uuid%"
	set {_inv} to chest inventory with 6 rows named "관리자 메뉴"
	open {_inv} to {_p}
	set {-admingui::%{_uid}%} to true
	delete {-adminmap::%{_uid}%::*}
	loop 54 times:
		set {_s} to loop-value - 1
		set slot {_s} of {_inv} to gray stained glass pane named " "
	# 안쪽 칸: 줄 2~5, 칸 2~8 (0부터 센 칸 번호 = 줄*9 + 열, 열 1~7)
	set {_ids::*} to adminButtonIds()
	loop {_ids::*}:
		set {_n} to loop-index parsed as number
		set {_row} to floor(({_n} - 1) / 7) + 1
		set {_col} to mod({_n} - 1, 7) + 1
		set {_s} to {_row} * 9 + {_col}
		if {_s} < 54:
			set slot {_s} of {_inv} to adminButtonItem(loop-value)
			set {-adminmap::%{_uid}%::%{_s}%} to loop-value

command /admin:
	description: 관리자 메뉴를 열어요 (op 전용)
	executable by: players
	trigger:
		if player is not op:
			send "&c권한이 없어요."
			stop
		play sound "block.chest.open" to player
		adminOpen(player)

on inventory click:
	set {_uid} to "%player's uuid%"
	if {-admingui::%{_uid}%} is not set:
		stop
	cancel the event
	set {_ev} to event
	set {_raw} to {_ev}.getRawSlot()
	set {_raw} to "%{_raw}%" parsed as number
	if {_raw} is not set:
		stop
	if {_raw} < 0:
		stop
	if {_raw} > 53:
		stop
	set {_p} to player
	play sound "ui.button.click" to {_p}
	set {_id} to {-adminmap::%{_uid}%::%{_raw}%}
	if {_id} is not set:
		stop
	if {_p} is not op:
		stop
	adminAction({_p}, {_id})

on inventory drag:
	if {-admingui::%player's uuid%} is set:
		cancel the event

on inventory close:
	delete {-admingui::%player's uuid%}
	delete {-adminmap::%player's uuid%::*}

on quit:
	delete {-admingui::%player's uuid%}
	delete {-adminmap::%player's uuid%::*}
