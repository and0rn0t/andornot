# [vote.sk] 게임 시작 전 맵 + 모드 투표: 맵과 모드 조합 3개를 무작위로 뽑아 로비에 더미 3마리로 세우고, 우클릭으로 투표 -> 득표에 비례한 확률로 룰렛 -> 로드아웃 변경 시간(20초) -> 게임 시작(game.sk gameStart).
# 환경, 작업 규칙, 변수 목록, 스킬 추가 절차는 skill_core.sk 맨 위 주석을 먼저 읽을 것.
# 켜고 끄기: 관리자 메뉴 "맵/모드 투표" 버튼(저장 변수 {gamecfg::vote}, false 면 꺼짐, 없으면 켜짐 = 기본 on). 끄면 예전처럼 게임 설정/맵 설정대로 바로 시작한다.
# 더미 위치: 관리자 메뉴 "투표 더미 위치 지정"(키 votedummy: 서 있는 자리 = 가운데 더미 자리, 바라보는 방향 = 더미가 바라볼 방향, 더미끼리 옆으로 2.5칸). 저장이 없으면 로비 위치 앞에 세운다.
# 진입점은 gameBegin(by)다. ready.sk(전원 준비 카운트다운)와 관리자 메뉴 "게임 시작"이 gameStart 대신 이걸 부른다. 투표가 꺼져 있거나 맵 후보가 없으면 바로 gameStart.
# 흐름(모두 이 파일의 voteStart 한 함수가 wait 로 진행):
#   1) 투표(voteSec() 초, 전원이 투표하면 바로 마감): 참가자(게임 관전 선택자 제외)가 더미를 우클릭하면 투표, 다시 우클릭하면 바꿈. 더미 이름 아래에 득표수.
#      시작할 때 참가자(게임 관전 선택자 제외)를 전부 로비 위치(gameLobbyLoc)로 소환한다.
#   2) 룰렛: 득표에 비례한 확률로 하나를 먼저 정하고(표가 하나도 없으면 셋 모두 같은 확률), 더미를 차례로 빛나게(점점 느리게) 돌리다가 그 더미에서 멈춘다.
#   3) 로드아웃 변경(voteLoadoutSec() 초): 액션바로 남은 시간 표시. 이 동안은 게임 중이 아니라서 무기고(9번 칸)로 구성을 바꿀 수 있다.
#   4) {-gvmap}/{-gvmode}(결과)를 두고 gameStart 호출. gameStart 가 읽고 바로 지운다. 이후 팀 매칭 + 시작 연출은 기존 그대로다.
# 변수(RAM): {-gvoting}(투표 진행 중 전체: 투표/룰렛/로드아웃, ready.sk readyActive 가 이 동안 준비를 막는다), {-gvphase}("vote"/"roulette"/"loadout"), {-gvgen}(세대, 취소하면 올려서 진행 중인 함수를 멈춘다),
#   {-gv::n}(후보 수), {-gv::map::i}/{-gv::mode::i}(후보 i 의 월드 이름/모드 id), {-gvd::i}(더미 엔티티), {-gvote::uuid}(그 사람이 고른 후보 번호), {-gvmap}/{-gvmode}(룰렛 결과)
# 취소: 관리자 /gamestop 또는 관리자 메뉴 "게임 강제 종료" -> voteCancel().
# 미검증: 마네킹 기본 스킨이 스티브인지(setProfile 을 안 부름), 더미의 setGlowing/setDescription, mod() 와 while 조건식, 더미 우클릭 이벤트, 투표 중 무기고 사용.

import:
	org.bukkit.entity.EntityType
	org.bukkit.event.player.PlayerInteractEntityEvent
	io.papermc.paper.event.player.PrePlayerAttackEntityEvent
	net.kyori.adventure.text.serializer.gson.GsonComponentSerializer

# 투표 시간(초)과 로드아웃 변경 시간(초)
function voteSec() :: number:
	return 15

function voteLoadoutSec() :: number:
	return 20

function gcVoteOn() :: boolean:
	if {gamecfg::vote} is false:
		return false
	return true

function voteLive(g: number) :: boolean:
	if {-gvoting} is not true:
		return false
	if {-gvgen} is not {_g}:
		return false
	return true

# 투표 더미를 세울 기준 위치(가운데 더미 자리). 저장이 없으면 로비 위치에서 방향만 반대로(로비에 들어온 사람 쪽을 보게).
function voteBase() :: location:
	set {_sv} to gcLoadLoc("votedummy")
	if {_sv} is set:
		return {_sv}
	set {_l} to gameLobbyLoc()
	set {_c} to {_l}.clone()
	set {_y} to {_l}.getYaw() + 180
	{_c}.setYaw({_y})
	return {_c}

function voteDummyLoc(i: number) :: location:
	set {_b} to voteBase()
	set {_y} to {_b}.getYaw()
	set {_j} to ({_i} - ({-gv::n} + 1) / 2) * 2.5
	return {_b} ~ vector(cos({_y}) * {_j}, 0, sin({_y}) * {_j})

function voteLabel(i: number) :: text:
	set {_m} to {-gv::mode::%{_i}%}
	return "%{-gv::map::%{_i}%}% · %gcModeName({_m})%"

# 후보 i 의 득표수(게임 관전 선택자는 투표 못 함)
function voteCount(i: number) :: number:
	set {_n} to 0
	loop all players:
		if specOn(loop-player) is not true:
			if {-gvote::%uuid of loop-player%} is {_i}:
				add 1 to {_n}
	return {_n}

function voteParticipants() :: number:
	set {_n} to 0
	loop all players:
		if specOn(loop-player) is not true:
			add 1 to {_n}
	return {_n}

function voteVoters() :: number:
	set {_n} to 0
	loop all players:
		if specOn(loop-player) is not true:
			if {-gvote::%uuid of loop-player%} is set:
				add 1 to {_n}
	return {_n}

# 맵 x 모드 조합 중 서로 다른 맵을 우선해서 최대 3개를 뽑는다(조합이 모자라면 있는 만큼). 결과는 {-gv::n}, {-gv::map::i}, {-gv::mode::i}.
function voteChoose():
	delete {-gv::*}
	set {-gv::n} to 0
	set {_maps::*} to mapCandidates()
	set {_modes::*} to gcModeIds()
	set {_cnt} to 0
	set {_nm} to size of {_maps::*}
	set {_nd} to size of {_modes::*}
	set {_a} to 1
	while {_a} <= {_nm}:
		set {_b} to 1
		while {_b} <= {_nd}:
			add 1 to {_cnt}
			set {_pm::%{_cnt}%} to "%{_maps::%{_a}%}%"
			set {_pd::%{_cnt}%} to "%{_modes::%{_b}%}%"
			add 1 to {_b}
		add 1 to {_a}
	if {_cnt} < 1:
		stop
	set {_idx::*} to integers from 1 to {_cnt}
	set {_sh::*} to shuffled {_idx::*}
	set {_got} to 0
	# 1차: 서로 다른 맵
	loop {_sh::*}:
		if {_got} < 3:
			set {_i} to loop-value
			set {_mn} to {_pm::%{_i}%}
			if {_used::%{_mn}%} is not set:
				set {_used::%{_mn}%} to true
				set {_chosen::%{_i}%} to true
				add 1 to {_got}
				set {-gv::map::%{_got}%} to {_mn}
				set {-gv::mode::%{_got}%} to {_pd::%{_i}%}
	# 2차: 모자라면 남은 조합으로 채운다
	loop {_sh::*}:
		if {_got} < 3:
			set {_i} to loop-value
			if {_chosen::%{_i}%} is not set:
				set {_chosen::%{_i}%} to true
				add 1 to {_got}
				set {-gv::map::%{_got}%} to {_pm::%{_i}%}
				set {-gv::mode::%{_got}%} to {_pd::%{_i}%}
	set {-gv::n} to {_got}

# 더미 한 마리(마네킹, 기본 스킨). 움직이지 않고 무적이며 태그 votedummy.
function voteDummySpawn(loc: location, yaw: number) :: object:
	set {_m} to {_loc}.getWorld().spawnEntity({_loc}, EntityType.MANNEQUIN)
	{_m}.setImmovable(true)
	{_m}.setInvulnerable(true)
	{_m}.setSilent(true)
	{_m}.setRotation({_yaw}, 0)
	{_m}.addScoreboardTag("votedummy")
	{_m}.setCustomNameVisible(true)
	return {_m}

function voteDummyUpdate(i: number):
	set {_d} to {-gvd::%{_i}%}
	if {_d} is not set:
		stop
	set {_c} to voteCount({_i})
	set {_lab} to voteLabel({_i})
	set {_nj} to "{""text"":""%{_lab}%"",""color"":""yellow"",""bold"":true}"
	set {_dj} to "{""text"":""우클릭해서 투표 · %{_c}%표"",""color"":""gray""}"
	{_d}.customName(GsonComponentSerializer.gson().deserialize({_nj}))
	{_d}.setDescription(GsonComponentSerializer.gson().deserialize({_dj}))

function voteDummiesUpdate():
	loop integers from 1 to {-gv::n}:
		voteDummyUpdate(loop-value)

# 태그 votedummy 인 더미를 전부 지운다(남은 것 포함)
function voteClearDummies():
	loop all entities:
		set {_e} to loop-entity
		set {_has} to {_e}.getScoreboardTags().contains("votedummy")
		if {_has} is true:
			{_e}.remove()
	delete {-gvd::*}

function voteHighlight(pos: number):
	loop integers from 1 to {-gv::n}:
		set {_d} to {-gvd::%loop-value%}
		if {_d} is set:
			if loop-value is {_pos}:
				{_d}.setGlowing(true)
			else:
				{_d}.setGlowing(false)

# 투표/룰렛/로드아웃 중단(관리자 강제 종료). 진행 중인 voteStart 는 다음 확인에서 멈춘다.
function voteCancel():
	add 1 to {-gvgen}
	delete {-gvoting}
	delete {-gvphase}
	delete {-gvmap}
	delete {-gvmode}
	delete {-gvote::*}
	voteClearDummies()
	loop all players:
		send action bar "" to loop-player

# 게임 시작 진입점. 투표가 켜져 있으면 투표부터, 아니면 바로 gameStart.
function gameBegin(by: text):
	if {-ingame} is true:
		stop
	if {-gstarting} is true:
		stop
	if {-gvoting} is true:
		stop
	if gcVoteOn() is not true:
		gameStart({_by})
		stop
	voteStart({_by})

function voteStart(by: text):
	voteChoose()
	if {-gv::n} < 2:
		gameStart({_by})
		stop
	set {-gvoting} to true
	set {-gvphase} to "vote"
	add 1 to {-gvgen}
	set {_g} to {-gvgen}
	delete {-gvote::*}
	delete {-gvmap}
	delete {-gvmode}
	delete {-ready::*}
	voteClearDummies()
	set {_b} to voteBase()
	set {_y} to {_b}.getYaw()
	loop integers from 1 to {-gv::n}:
		set {_i} to loop-value
		set {_dl} to voteDummyLoc({_i})
		set {-gvd::%{_i}%} to voteDummySpawn({_dl}, {_y})
	voteDummiesUpdate()
	# 게임에 참가하는 사람(관전 선택자 제외)은 전원 로비로 소환한다
	set {_lobby} to gameLobbyLoc()
	loop all players:
		set {_pl} to loop-player
		if specOn({_pl}) is not true:
			tpSafe({_pl}, {_lobby})
	loop all players:
		send title "&e맵 · 모드 투표" with subtitle "&7더미를 우클릭해서 투표하세요" to loop-player for 3 seconds with fadein 5 ticks and fade out 10 ticks
		play sound "block.note_block.pling" with volume 0.7 and pitch 1.5 to loop-player
	# 1) 투표
	set {_left} to voteSec()
	while {_left} > 0:
		if voteLive({_g}) is not true:
			stop
		set {_np} to voteParticipants()
		set {_nv} to voteVoters()
		if {_np} > 0:
			if {_nv} >= {_np}:
				set {_left} to 0
		if {_left} > 0:
			loop all players:
				send action bar colored "&e맵/모드 투표 &8| &f남은 시간 &e%{_left}%초 &8| &7투표 %{_nv}%/%{_np}%명" to loop-player
			wait 1 second
			remove 1 from {_left}
	if voteLive({_g}) is not true:
		stop
	# 2) 룰렛: 득표에 비례한 확률로 결과를 먼저 정한다(표가 없으면 모두 같은 확률)
	set {-gvphase} to "roulette"
	set {_n} to {-gv::n}
	loop integers from 1 to {_n}:
		set {_w::%loop-value%} to voteCount(loop-value)
	set {_tot} to 0
	loop {_w::*}:
		add loop-value to {_tot}
	if {_tot} is 0:
		loop integers from 1 to {_n}:
			set {_w::%loop-value%} to 1
		set {_tot} to {_n}
	set {_r} to random integer between 1 and {_tot}
	set {_acc} to 0
	set {_win} to 0
	loop integers from 1 to {_n}:
		if {_win} is 0:
			add {_w::%loop-value%} to {_acc}
			if {_r} <= {_acc}:
				set {_win} to loop-value
	set {_wvotes} to {_w::%{_win}%}
	loop all players:
		send action bar "" to loop-player
		send title "&6룰렛!" with subtitle "&7득표에 비례해서 뽑아요" to loop-player for 2 seconds with fadein 0 ticks and fade out 5 ticks
	wait 1 second
	set {_start} to random integer between 1 and {_n}
	set {_t} to 16
	while mod({_start} - 1 + {_t}, {_n}) + 1 is not {_win}:
		add 1 to {_t}
	set {_k} to 1
	while {_k} <= {_t}:
		if voteLive({_g}) is not true:
			stop
		set {_pos} to mod({_start} - 1 + {_k}, {_n}) + 1
		voteHighlight({_pos})
		set {_lab} to voteLabel({_pos})
		set {_pitch} to 0.8 + {_k} * 0.04
		loop all players:
			send title "&e%{_lab}%" with subtitle "&7..." to loop-player for 10 ticks with fadein 0 ticks and fade out 0 ticks
			play sound "block.note_block.hat" with volume 0.8 and pitch {_pitch} to loop-player
		set {_d} to 2 + floor({_k} * {_k} / 30)
		loop {_d} times:
			wait 1 tick
		add 1 to {_k}
	if voteLive({_g}) is not true:
		stop
	set {-gvmap} to {-gv::map::%{_win}%}
	set {-gvmode} to {-gv::mode::%{_win}%}
	set {_lab} to voteLabel({_win})
	loop all players:
		send title "&a%{_lab}%" with subtitle "&7선정! (%{_wvotes}%표)" to loop-player for 3 seconds with fadein 0 ticks and fade out 10 ticks
		send "&6[투표] &f%{_lab}% &7선정! (%{_wvotes}%표)" to loop-player
		play sound "entity.player.levelup" with volume 0.8 and pitch 1 to loop-player
	wait 3 seconds
	if voteLive({_g}) is not true:
		stop
	# 3) 로드아웃 변경 시간
	set {-gvphase} to "loadout"
	voteClearDummies()
	set {_left} to voteLoadoutSec()
	while {_left} > 0:
		if voteLive({_g}) is not true:
			stop
		loop all players:
			send action bar colored "&e로드아웃 변경 가능 &8| &f남은 시간 &e%{_left}%초 &8| &7무기고(9번 칸)에서 바꿔요" to loop-player
		if {_left} <= 3:
			loop all players:
				play sound "block.comparator.click" with volume 1 and pitch 1.5 to loop-player
		wait 1 second
		remove 1 from {_left}
	if voteLive({_g}) is not true:
		stop
	# 4) 게임 시작(팀 매칭 + 시작 연출은 gameStart)
	delete {-gvoting}
	delete {-gvphase}
	delete {-gvote::*}
	loop all players:
		send action bar "" to loop-player
	gameStart({_by})
	delete {-gvmap}
	delete {-gvmode}

# 더미 우클릭 = 투표(투표 단계에서만, 게임 관전 선택자는 못 함). 다시 누르면 다른 후보로 바꾼다.
function voteCast(p: player, e: entity):
	if {-gvphase} is not "vote":
		send "&c투표 시간이 아니에요." to {_p}
		stop
	if specOn({_p}) is true:
		send "&c게임 관전 중에는 투표할 수 없어요." to {_p}
		stop
	set {_pick} to 0
	loop integers from 1 to {-gv::n}:
		if {-gvd::%loop-value%} is {_e}:
			set {_pick} to loop-value
	if {_pick} is 0:
		stop
	set {-gvote::%uuid of {_p}%} to {_pick}
	set {_lab} to voteLabel({_pick})
	send "&6[투표] &f%{_lab}% &7에 투표했어요." to {_p}
	play sound "block.note_block.chime" with volume 0.7 and pitch 1.4 to {_p}
	voteDummiesUpdate()

on PlayerInteractEntityEvent:
	if event.getHand().name() is not "HAND":
		stop
	set {_e} to event.getRightClicked()
	set {_has} to {_e}.getScoreboardTags().contains("votedummy")
	if {_has} is true:
		event.setCancelled(true)
		voteCast(event.getPlayer(), {_e})

on PrePlayerAttackEntityEvent:
	set {_e} to event.getAttacked()
	set {_has} to {_e}.getScoreboardTags().contains("votedummy")
	if {_has} is true:
		event.setCancelled(true)

on quit:
	delete {-gvote::%uuid of player%}

# 스크립트를 다시 불러오면 진행 중이던 투표는 끝난 것으로 본다(타이머가 사라져서). 남은 더미도 지운다.
on load:
	delete {-gvoting}
	delete {-gvphase}
	delete {-gvmap}
	delete {-gvmode}
	delete {-gvote::*}
	voteClearDummies()
